//! Resolved SVG data and backend-neutral paint commands. Paths remain in user space;
//! every drawing command carries its device transform and conservative device bounds.
import svg_geometry.geometry { Path, Rect }
import mapping { Mapping, ProjectionClip }
import document_styles { StyledDocument }
import svg_xml.xml { Document }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.option { Option }

pub struct RenderOptions {
  /// Zero requests intrinsic sizing; nonzero values override output pixels before zoom.
  pub width: u32,
  pub height: u32,
  pub zoom: f64,
  pub maxPixels: usize,
}

impl RenderOptions {
  pub fn make() -> RenderOptions {
    return RenderOptions { width: 0, height: 0, zoom: 1.0, maxPixels: 16000000 }
  }
}

pub enum RenderError {
  InvalidXml,
  InvalidRoot,
  InvalidSize,
  TooLarge,
  InvalidStyleContext,
  InvalidGeometry,
}

/// Straight-alpha sRGB, normalized to [0, 1].
pub struct Color {
  pub r: f64,
  pub g: f64,
  pub b: f64,
  pub a: f64
}

impl Copy for Color {}

impl Color {
  pub fn black() -> Color {
    return Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  }
}

pub union Paint {
  None,
  CurrentColor,
  Solid { pub color: Color }
}

impl Copy for Paint {}

pub enum FillRule {
  Nonzero,
  EvenOdd
}

pub enum LineCap {
  Butt,
  Round,
  Square
}

pub enum LineJoin {
  Miter,
  Round,
  Bevel,
  MiterClip,
  Arcs
}

/// Used paint values projected from computed CSS; group opacity is not inherited.
pub struct Style {
  pub color: Color,
  pub fill: Paint,
  pub stroke: Paint,
  pub fillOpacity: f64,
  pub strokeOpacity: f64,
  pub opacity: f64,
  pub strokeWidth: f64,
  pub miterLimit: f64,
  pub lineCap: LineCap,
  pub lineJoin: LineJoin,
  pub fillRule: FillRule,
  pub dashIndex: usize,
  pub dashOffset: f64,
  pub fontSize: f64,
  pub visible: bool,
  pub displayed: bool,
  pub crispEdges: bool,
}

impl Copy for Style {}

/// Depth-first group boundaries retain hierarchy without recursive owned allocations.
pub union ResolvedNode {
  BeginGroup { pub opacity: f64, pub bounds: Rect },
  EndGroup,
  Shape {
    pub path: usize,
    pub transform: Mapping,
    pub clip: Option<usize>,
    pub bounds: Rect,
    pub style: Style
  },
}

pub struct RenderTree {
  pub width: u32,
  pub height: u32,
  pub document: Document,
  pub styles: StyledDocument,
  /// Includes CSS d:path() values at their original indices. Those path handles
  /// resolve here after geometry resolution, not in styles.catalog.engine.values.
  pub paths: List<Path>,
  pub dashes: List<List<f64>>,
  pub nodes: List<ResolvedNode>,
  pub projectionClips: List<ProjectionClip>,
}

pub struct Stroke {
  pub width: f64,
  pub cap: LineCap,
  pub join: LineJoin,
  pub miterLimit: f64,
  pub dashIndex: usize,
  pub dashOffset: f64,
}

impl Copy for Stroke {}

pub union Command {
  FillPath {
    pub path: usize,
    pub transform: Mapping,
    pub clip: Option<usize>,
    pub bounds: Rect,
    pub color: Color,
    pub rule: FillRule,
    pub crispEdges: bool
  },
  StrokePath {
    pub path: usize,
    pub transform: Mapping,
    pub clip: Option<usize>,
    pub bounds: Rect,
    pub color: Color,
    pub stroke: Stroke,
    pub crispEdges: bool
  },
  PushLayer { pub opacity: f64, pub bounds: Rect },
  PopLayer,
}

/// Retained, CPU/GPU-neutral commands. No backend handles, closures or rasterizer state.
pub struct DisplayList {
  pub width: u32,
  pub height: u32,
  pub paths: List<Path>,
  pub dashes: List<List<f64>>,
  pub commands: List<Command>,
  pub projectionClips: List<ProjectionClip>,
}
