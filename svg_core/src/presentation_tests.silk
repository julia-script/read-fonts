//! Presentation-only contracts against the sources pinned in specs.lock.json.
import presentation
import scene { Style, Paint, LineCap, LineJoin, FillRule }
import svg_xml.xml { Document, XmlError }
import svg_xml.xml
import silk.collections.list { List }
import silk.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn value(data: &[u8], base: f64, font: f64, expected: f64) -> bool {
  let parsed = presentation.length(data, base, font)
  return match &parsed {
    Option<f64>.Some { value } => value == expected
    _ => false
  }
}

effect fn resolve(data: &[u8], parent: Style, dashes: &mut List<List<f64>>) -> Style
  ! XmlError | OutOfMemoryError
  ? &mut Allocator {
  let doc = run xml.parse(data)
  return run presentation.compute(&doc, Document.root(&doc), parent, 100.0, 100.0, &mut dashes.*)
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#Units
// https://www.w3.org/TR/css-values-3/#absolute-lengths
// ex requires actual font metrics, unavailable in the presentation-only phase.
test effect fn lengthUnitsAndUnsupportedMetrics() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    value(b"1in", 0.0, 16.0, 96.0) && value(b"72pt", 0.0, 16.0, 96.0),
    "physical units use 96dpi",
  )
  run Testing.expect(
    value(b"25%", 200.0, 16.0, 50.0) && value(b"2em", 0.0, 12.0, 24.0),
    "percent and em use supplied bases",
  )
  let ex = presentation.length(b"1ex", 100.0, 16.0)
  let overflow = presentation.length(b"1e308in", 100.0, 16.0)
  let junk = presentation.length(b"10pxjunk", 100.0, 16.0)
  run Testing.expect(
    match &ex {
      Option<f64>.None => true
      _ => false
    },
    "do not invent x-height",
  )
  run Testing.expect(
    match &overflow {
      Option<f64>.None => true
      _ => false
    },
    "overflow cannot enter computed style",
  )
  run Testing.expect(
    match &junk {
      Option<f64>.None => true
      _ => false
    },
    "unknown suffix invalidates entire length",
  )
}

// https://www.w3.org/TR/css-color-4/#currentcolor-color
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#FillProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/render.html#VisibilityControl
test effect fn inheritedPaintVisibilityAndIsolatedOpacity() -> ()
  ! AssertionError<'static> | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut dashes = List<List<f64>>.make()
  let parent = run resolve(
    b"<g color='red' fill='currentColor' opacity='25%' visibility='hidden' display='none'/>",
    Style.initial(),
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let child = run resolve(
    b"<g color='blue' visibility='visible' style='fill: green; opacity: 0'/>",
    parent,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &child.fill {
      Paint.CurrentColor => true
      _ => false
    },
    "inherited currentColor remains deferred to child color",
  )
  run Testing.expect(
    child.color.b == 1.0 && child.color.r == 0.0,
    "child color overrides inherited color",
  )
  run Testing.expect(
    parent.opacity == 0.25 && child.opacity == 1.0,
    "opacity is not inherited and inline style is not parsed",
  )
  run Testing.expect(
    child.visible && child.displayed && !parent.visible && !parent.displayed,
    "visibility overrides, display itself is not inherited",
  )
  let inherited = run resolve(
    b"<g opacity='inherit' display='inherit' visibility='initial' fill='initial'/>",
    parent,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    inherited.opacity == 0.25 && !inherited.displayed && inherited.visible,
    "explicit inherit applies to noninherited properties",
  )
  run Testing.expect(
    match &inherited.fill {
      Paint.Solid { color } => color.r == 0.0 && color.a == 1.0
      _ => false
    },
    "initial fill is opaque black",
  )
}

// https://www.w3.org/TR/css-color-4/#named-colors
// https://www.w3.org/TR/css-color-4/#hex-notation
// https://www.w3.org/TR/css-color-4/#rgb-functions
// https://www.w3.org/TR/css-color-4/#the-hsl-notation
test effect fn solidColorGrammarsAndInvalidValues() -> ()
  ! AssertionError<'static> | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut dashes = List<List<f64>>.make()
  let named = run resolve(
    b"<g color='ReBeccAPurple' fill='#0f08' stroke='rgba(255,0,0,50%)' fill-opacity='200%' stroke-opacity='-5%'/>",
    Style.initial(),
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    named.color.r == 102.0 / 255.0 && named.color.b == 153.0 / 255.0,
    "canonical named color table is case insensitive",
  )
  run Testing.expect(
    match &named.fill {
      Paint.Solid { color } => color.g == 1.0 && color.a == 136.0 / 255.0
      _ => false
    },
    "short hexadecimal alpha",
  )
  run Testing.expect(
    match &named.stroke {
      Paint.Solid { color } => color.r == 1.0 && color.a == 0.5
      _ => false
    },
    "legacy rgba percent alpha",
  )
  run Testing.expect(
    named.fillOpacity == 1.0 && named.strokeOpacity == 0.0,
    "opacity percentages clamp",
  )
  let hsl = run resolve(
    b"<g fill='hsla(-240,100%,50%,.25)' stroke='rgb(100%,0%,0%)'/>",
    named,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &hsl.fill {
      Paint.Solid { color } => color.g == 1.0 && color.r == 0.0 && color.a == 0.25
      _ => false
    },
    "HSL hue wraps and alpha survives",
  )
  let invalid = run resolve(
    b"<g color='rgb(1,2%,3)' fill='url(#paint)' stroke-width='-1' stroke-opacity='nan' opacity='junk'/>",
    named,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    invalid.color.r == named.color.r && invalid.strokeWidth == named.strokeWidth
      && invalid.strokeOpacity == 0.0
      && invalid.opacity == 1.0,
    "invalid attributes preserve inherited or initial values",
  )
  run Testing.expect(
    match &invalid.fill {
      Paint.Solid { color } => color.g == 1.0
      _ => false
    },
    "unsupported paint does not erase inherited fill",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeDasharrayProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeDashoffsetProperty
test effect fn dashListsInheritanceAndAtomicRejection() -> ()
  ! AssertionError<'static> | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut dashes = List<List<f64>>.make()
  run List<List<f64>>.append(&mut dashes, List<f64>.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parent = run resolve(
    b"<g stroke-dasharray='1, 2 3' stroke-dashoffset='-10%' stroke-width='2em' font-size='10'/>",
    Style.initial(),
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    parent.dashIndex == 1 && parent.dashOffset == -10.0 && parent.strokeWidth == 20.0,
    "dash percentage and computed font basis",
  )
  run Testing.expect(
    List<f64>.length(&List<List<f64>>.asSlice(&dashes)[parent.dashIndex]) == 6,
    "odd dash arrays are doubled",
  )
  let child = run resolve(b"<g stroke-dasharray='inherit'/>", parent, &mut dashes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run resolve(
    b"<g stroke-dasharray='1, -2' stroke-dashoffset='1ex'/>",
    parent,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    child.dashIndex == parent.dashIndex && invalid.dashIndex == parent.dashIndex
      && invalid.dashOffset == parent.dashOffset,
    "invalid dash list is atomically ignored",
  )
  run Testing.expect(
    List<List<f64>>.length(&dashes) == 2,
    "inheritance and invalid attributes add no dash pool entries",
  )
  let zero = run resolve(
    b"<g stroke-dasharray='0 0' stroke-dashoffset='unset' opacity='unset'/>",
    parent,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    zero.dashIndex == 0 && zero.dashOffset == parent.dashOffset && zero.opacity == 1.0,
    "zero sum means solid; unset follows inheritance",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#FillRuleProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeLinecapProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeLinejoinProperty
test effect fn strokeKeywordsAndInheritedRenderingHints() -> ()
  ! AssertionError<'static> | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut dashes = List<List<f64>>.make()
  let parent = run resolve(
    b"<g fill-rule='evenodd' stroke-linecap='square' stroke-linejoin='bevel' stroke-miterlimit='8' shape-rendering='crispEdges' font-size='20'/>",
    Style.initial(),
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let child = run resolve(
    b"<g fill-rule='unset' stroke-linecap='initial' stroke-linejoin='inherit' stroke-miterlimit='.5' font-size='150%'/>",
    parent,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &child.fillRule {
      FillRule.EvenOdd => true
      _ => false
    },
    "unset inherits fill rule",
  )
  run Testing.expect(
    match &child.lineCap {
      LineCap.Butt => true
      _ => false
    },
    "initial resets line cap",
  )
  run Testing.expect(
    match &child.lineJoin {
      LineJoin.Bevel => true
      _ => false
    },
    "explicit inherit retains line join",
  )
  run Testing.expect(
    child.miterLimit == 8.0 && child.crispEdges && child.fontSize == 30.0,
    "invalid miter limit ignored, rendering hint inherited, font percentage uses parent",
  )
  let reset = run resolve(
    b"<g fill-rule='initial' shape-rendering='initial' stroke-miterlimit='initial' font-size='initial'/>",
    child,
    &mut dashes,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    !reset.crispEdges && reset.miterLimit == 4.0 && reset.fontSize == 16.0,
    "initial values ignore the parent",
  )
}
