//! Computed values across immutable source documents and instantiated selector scopes.
import document_styles { StyledGraph }
import document_styles
import structure { Graph, SourceId, OccurrenceId, Options, StructureError }
import structure
import stylesheets { Catalog }
import view_selection { Selection }
import resources { Resolver, Response, ResourceKind, ResourceError }
import url { Url, UrlError }
import svg_xml.xml { Document }
import svg_css.tokens { Limits, CssError, equal }
import svg_css.computed { HostContext, StyleId, ComputedValue, ComputedError }
import svg_css.properties { Property }
import svg_css.values { Value, ValueId, Paint, Mode }
import svg_css.values
import svg_css.input { Input }
import svg_css.lexer
import svg_css.media_features { Environment }
import svg_css.dimensions { Context }
import svg_css.colors { Color, Context as ColorContext }
import svg_css.text_values { TextValue }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.testing.testing { Testing, AssertionError }

struct FixtureResolver {}

impl FixtureResolver {
  effect fn fetch(self: &mut Self, address: &Url, kind: ResourceKind) -> Response
    ! ResourceError | OutOfMemoryError
    ? &mut Allocator {
    let mut mime: &[u8] = b"image/svg+xml"
    let resource = Url.withoutFragment(address)
    let source = if kind == ResourceKind.Document
      && equal(resource, b"https://example.test/lib/shared.svg") {
      b"<svg xmlns='http://www.w3.org/2000/svg'><style>.shared{stroke-opacity:.6} .source rect{stroke-width:99px} rect{width:2em;height:var(--height)}</style><g class='source'><rect id='same' class='shared'/></g></svg>"
    } else if kind == ResourceKind.Document
      && equal(resource, b"https://example.test/lib/nested.svg") {
      b"<svg xmlns='http://www.w3.org/2000/svg'><style>:host{stroke-width:7px;stroke-opacity:.7!important} :host(#nested){stroke-opacity:.9!important}</style><defs><rect id='leaf'/></defs><g id='bundle'><use id='nested' href='#leaf' style='stroke-width:11px;stroke-opacity:.4!important'/></g></svg>"
    } else if kind == ResourceKind.Document
      && equal(resource, b"https://example.test/lib/paint.svg") {
      b"<svg xmlns='http://www.w3.org/2000/svg'><style xml:base='../css/external/'>.paint{fill:url(#external-gradient);stroke:url(texture.svg#p)}</style><g id='paint' class='paint'><rect id='paint-child'/></g></svg>"
    } else if kind == ResourceKind.StyleSheet
      && equal(resource, b"https://example.test/css/main.css") {
      mime = b"text/css"
      b"#main-paint{fill:url(#main-gradient);stroke:url(../images/main.svg#p)}"
    } else {
      fail ResourceError.Io
    }
    let parsed = run Effect.result(Url.parseAbsolute(resource))
    let finalUrl = match move parsed {
      Result<Url, UrlError | OutOfMemoryError>.Success { value } => move value
      Result<Url, UrlError | OutOfMemoryError>.Failure { error } => match move error {
        UrlError invalid => {
          fail ResourceError.InvalidData
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    return Response {
      bytes: run Bytes.copy(source),
      finalUrl: Option<Url>.Some { value: move finalUrl },
      mediaType: Option<Bytes>.Some { value: run Bytes.copy(mime) },
      charset: Option<Bytes>.None,
    }
  }
}

impl Resolver for FixtureResolver {
  fetch: FixtureResolver.fetch
}

struct Fixture {
  graph: Graph,
  styled: StyledGraph,
}

effect fn fixture(data: &[u8]) -> Fixture
  ! StructureError | CssError | UrlError | ComputedError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let base = run Url.parseAbsolute(b"https://example.test/art/main.svg")
  let graph = run structure.build(data, &base, &Options.defaults())
  let mut catalog = run Catalog.make()
  let buffer = run lexer.tokenize(b"serif", &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let family = match &run values.parse(
    &mut catalog.engine.values,
    Property.FontFamily,
    &input,
    Mode.Css,
  ) {
    Option<ValueId>.Some { value } => value
    _ => {
      fail ComputedError { property: Property.FontFamily }
    }
  }
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(100.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let styled = run document_styles.buildGraph(
    &graph,
    move catalog,
    &host,
    &Environment.headless(100.0, 100.0),
    Selection.empty(),
    &Limits.make(),
  )
  return Fixture { graph: move graph, styled: move styled }
}

fn hasId(graph: &Graph, source: SourceId, id: &[u8]) -> bool {
  return match &Document.attribute(graph.sourceDocument(source), source.node, b"", b"id") {
    Option<&[u8]>.Some { value } => equal(value, id)
    _ => false
  }
}

// Identify instances by their source ID attribute and immediate scope's host ID,
// not arena position or private stylesheet/declaration allocation layout.
fn named(result: &Fixture, id: &[u8], host: &[u8]) -> Option<StyleId> {
  let mut i: usize = 0
  while i < result.graph.occurrences.length() {
    let occurrence = &result.graph.occurrences.asSlice()[i]
    if hasId(&result.graph, occurrence.source, id) {
      let correctScope = match &result.graph.scopes.asSlice()[occurrence.scope].host {
        Option<OccurrenceId>.Some { value } => hasId(
          &result.graph,
          result.graph.occurrences.asSlice()[value.index].source,
          host,
        )
        _ => host.length == 0
      }
      if correctScope {
        return result.styled.nodeStyle(OccurrenceId { index: i })
      }
    }
    i = i + 1
  }
  return Option<StyleId>.None
}

fn number(result: &Fixture, id: &[u8], host: &[u8], property: Property, expected: f64) -> bool {
  return match &named(result, id, host) {
    Option<StyleId>.Some { value } => match &result.styled.catalog.engine.number(
      value,
      property,
      100.0,
    ) {
      Option<f64>.Some { value: actual } => actual == expected
      _ => false
    }
    _ => false
  }
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/struct.html#UseStyleInheritance
// Pin abca334257fb3646e1ae5a5645a08621b4738a44e05c6d470bae03f5fd21ff62.
test effect fn externalRulesRematchWithoutSharingInstanceComputedDimensions() -> ()
  ! StructureError
    | CssError
    | UrlError
    | ComputedError
    | OutOfMemoryError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut resolver = FixtureResolver {}
  let result = run fixture(
    b"<svg xmlns='http://www.w3.org/2000/svg'><style>#same.shared{stroke-width:9px;stroke-opacity:.1}</style><rect id='same' class='shared'/><use id='small' href='../lib/shared.svg#same' style='font-size:10px;stroke-width:3px;--height:3em'/><use id='large' href='../lib/shared.svg#same' style='font-size:20px;stroke-width:5px;--height:4em'/></svg>",
  )
    |> Effect.provideMut<Resolver>(&mut resolver)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    number(&result, b"same", b"", Property.StrokeWidth, 9.0)
      && number(&result, b"same", b"", Property.StrokeOpacity, 0.1)
      && number(&result, b"same", b"small", Property.StrokeOpacity, 0.6)
      && number(&result, b"same", b"large", Property.StrokeOpacity, 0.6),
    "same IDs/classes in separate documents do not leak stylesheet rules in either direction",
  )
  run Testing.expect(
    number(&result, b"same", b"small", Property.StrokeWidth, 3.0)
      && number(&result, b"same", b"large", Property.StrokeWidth, 5.0),
    "source ancestor selector stops matching the referenced root, which inherits from each use",
  )
  run Testing.expect(
    number(&result, b"same", b"small", Property.Width, 20.0)
      && number(&result, b"same", b"large", Property.Width, 40.0)
      && number(&result, b"same", b"small", Property.Height, 30.0)
      && number(&result, b"same", b"large", Property.Height, 80.0),
    "shared source declarations compute against each host's font size and inherited variables",
  )
}

// https://www.w3.org/TR/css-cascade-4/#cascade-sort
// https://drafts.csswg.org/css-shadow-1/#host-selector
// Shadow pin c84bdd0453ff210fa95fb95b118d7a8d365f189ea8fab1ee7db791f199fe1db4.
test effect fn hostEncapsulationPrecedenceInvertsForImportantAtEachNestedScope() -> ()
  ! StructureError
    | CssError
    | UrlError
    | ComputedError
    | OutOfMemoryError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut resolver = FixtureResolver {}
  let result = run fixture(
    b"<svg xmlns='http://www.w3.org/2000/svg'><use id='outer' href='../lib/nested.svg#bundle' style='stroke-width:3px;stroke-opacity:.2!important'/></svg>",
  )
    |> Effect.provideMut<Resolver>(&mut resolver)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    number(&result, b"outer", b"", Property.StrokeWidth, 3.0)
      && number(&result, b"outer", b"", Property.StrokeOpacity, 0.7)
      && number(&result, b"bundle", b"outer", Property.StrokeWidth, 3.0)
      && number(&result, b"bundle", b"outer", Property.StrokeOpacity, 0.7),
    "including-document normal wins, external host-important beats including inline-important before inheritance",
  )
  run Testing.expect(
    number(&result, b"nested", b"outer", Property.StrokeWidth, 11.0)
      && number(&result, b"nested", b"outer", Property.StrokeOpacity, 0.9)
      && number(&result, b"leaf", b"nested", Property.StrokeWidth, 11.0)
      && number(&result, b"leaf", b"nested", Property.StrokeOpacity, 0.9),
    "nested scope's host-important wins while outer normal remains authoritative, and the leaf inherits both",
  )
}

fn paintProvenance(
  result: &Fixture,
  id: &[u8],
  host: &[u8],
  property: Property,
  expectedReference: &[u8],
  expectedDocument: &[u8],
  expectedBase: &[u8],
) -> bool {
  let style = match &named(result, id, host) {
    Option<StyleId>.Some { value } => value
    _ => {
      return false
    }
  }
  let entry = match &result.styled.catalog.engine.get(style, property) {
    Option<ComputedValue>.Some { value } => value
    _ => {
      return false
    }
  }
  let typedReference = match &result.styled.catalog.engine.values.get(entry.value).* {
    Value.Paint { paint } => match &paint {
      Paint.Server { url, fallback } => equal(
        result.styled.catalog.engine.values.text(url),
        expectedReference,
      )
      _ => false
    }
    _ => false
  }
  let buffer = match &entry.sourceBuffer {
    Option<usize>.Some { value } => value
    _ => {
      return false
    }
  }
  let documentRetained = match &result.styled.catalog.sourceDocument(buffer) {
    Option<&Url>.Some { value } => equal(value.bytes(), expectedDocument)
    _ => false
  }
  let baseRetained = match &result.styled.catalog.base(buffer) {
    Option<&Url>.Some { value } => equal(value.bytes(), expectedBase)
    _ => false
  }
  return typedReference && documentRetained && baseRetained
}

// https://www.w3.org/TR/css-values-3/#local-urls
// https://www.w3.org/TR/css-values-3/#relative-urls
// https://www.w3.org/TR/2018/CR-SVG2-20181004/struct.html#UseStyleInheritance
// Assert the typed reference and both consumer-visible bases, not token/arena indices.
test effect fn paintReferencesRetainDocumentAndStylesheetBasesThroughInheritance() -> ()
  ! StructureError
    | CssError
    | UrlError
    | ComputedError
    | OutOfMemoryError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut resolver = FixtureResolver {}
  let result = run fixture(
    b"<?xml-stylesheet href='../css/main.css'?><svg xmlns='http://www.w3.org/2000/svg'><rect id='main-paint'/><use id='external' href='../lib/paint.svg#paint'/></svg>",
  )
    |> Effect.provideMut<Resolver>(&mut resolver)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    paintProvenance(
      &result,
      b"main-paint",
      b"",
      Property.Fill,
      b"#main-gradient",
      b"https://example.test/art/main.svg",
      b"https://example.test/css/main.css",
    )
      && paintProvenance(
        &result,
        b"main-paint",
        b"",
        Property.Stroke,
        b"../images/main.svg#p",
        b"https://example.test/art/main.svg",
        b"https://example.test/css/main.css",
      ),
    "external CSS retains the including source document for local fragments and the stylesheet base for relative URLs",
  )
  run Testing.expect(
    paintProvenance(
      &result,
      b"paint",
      b"external",
      Property.Fill,
      b"#external-gradient",
      b"https://example.test/lib/paint.svg",
      b"https://example.test/css/external/",
    )
      && paintProvenance(
        &result,
        b"paint",
        b"external",
        Property.Stroke,
        b"texture.svg#p",
        b"https://example.test/lib/paint.svg",
        b"https://example.test/css/external/",
      )
      && paintProvenance(
        &result,
        b"paint-child",
        b"external",
        Property.Fill,
        b"#external-gradient",
        b"https://example.test/lib/paint.svg",
        b"https://example.test/css/external/",
      )
      && paintProvenance(
        &result,
        b"paint-child",
        b"external",
        Property.Stroke,
        b"texture.svg#p",
        b"https://example.test/lib/paint.svg",
        b"https://example.test/css/external/",
      ),
    "external template XML Base affects stylesheet-relative URLs without rebasing source-local fragments or inherited paint",
  )
}
