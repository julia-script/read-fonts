fn namedColor(data: &[u8]) -> Option<Color> {
  let mut i: usize = 0
  while i < COLOR_NAMES.length {
    if insensitive(data, String.utf8Bytes(COLOR_NAMES[i])) {
      let rgb = COLOR_RGB[i]
      return Option<Color>.some(
        Color {
          r: u32.toF64(rgb / 65536) / 255.0,
          g: u32.toF64(rgb / 256 % 256) / 255.0,
          b: u32.toF64(rgb % 256) / 255.0,
          a: 1.0,
        },
      )
    }
    i = i + 1
  }
  return Option<Color>.None
}
