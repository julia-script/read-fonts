//! Element-only selector links and inherited language over the immutable XML arena.
import svg_xml.xml { Document, NodeId, NodeKind }
import svg_css.element { ElementTree, NO_ELEMENT }
import svg_css.tokens { equal }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }

struct Links {
  first: usize,
  next: usize,
  previous: usize,
  languageOwner: usize,
  languageAttribute: usize,
  empty: bool,
  link: bool,
}

pub struct Tree<'a> {
  pub document: &'a Document,
  links: List<Links>,
}

fn index(id: Option<NodeId>) -> usize {
  return match &id {
    Option<NodeId>.Some { value } => value.index
    _ => NO_ELEMENT
  }
}

fn documentWhitespace(text: &[u8]) -> bool {
  let mut i: usize = 0
  while i < text.length {
    let c = text[i]
    if c != 9 && c != 10 && c != 13 && c != 32 {
      return false
    }
    i = i + 1
  }
  return true
}

// XML nodes are appended in document order, with parents before their children.
// One pass over children and attributes prevents uncharged scans during matching.
pub effect fn make<'a>(document: &'a Document) -> Tree<'a>
  ! OutOfMemoryError
  ? &mut Allocator {
  let nodes = Document.nodes(document)
  let mut links = run List<Links>.makeWithCapacity(nodes.length)
  let mut i: usize = 0
  while i < nodes.length {
    run links.append(
      Links {
        first: NO_ELEMENT,
        next: NO_ELEMENT,
        previous: NO_ELEMENT,
        languageOwner: NO_ELEMENT,
        languageAttribute: NO_ELEMENT,
        empty: true,
        link: false,
      },
    )
    i = i + 1
  }
  let mut entries = links.asMutSlice()
  i = 0
  while i < nodes.length {
    if nodes[i].kind == NodeKind.Element {
      let id = NodeId { index: i }
      let parent = index(nodes[i].parent)
      if parent != NO_ELEMENT {
        entries[i].languageOwner = entries[parent].languageOwner
        entries[i].languageAttribute = entries[parent].languageAttribute
      }
      let svg = equal(Document.namespaceUri(document, id), b"http://www.w3.org/2000/svg")
      let anchor = svg && equal(Document.localName(document, id), b"a")
      let attrs = Document.attributes(document, id)
      let mut plainLanguage = NO_ELEMENT
      let mut xmlLanguage = NO_ELEMENT
      let mut attribute: usize = 0
      while attribute < attrs.length {
        let name = Document.attributeLocalName(document, attrs[attribute])
        let namespace = Document.attributeNamespaceUri(document, attrs[attribute])
        if equal(name, b"lang") {
          if equal(namespace, b"http://www.w3.org/XML/1998/namespace") {
            xmlLanguage = attribute
          } else if svg && namespace.length == 0 {
            plainLanguage = attribute
          }
        }
        if anchor && equal(name, b"href")
          && (namespace.length == 0 || equal(namespace, b"http://www.w3.org/1999/xlink")) {
          entries[i].link = true
        }
        attribute = attribute + 1
      }

      // https://www.w3.org/TR/SVG2/struct.html#LangSpaceAttrs
      let language = if xmlLanguage != NO_ELEMENT {
        xmlLanguage
      } else {
        plainLanguage
      }
      if language != NO_ELEMENT {
        entries[i].languageOwner = i
        entries[i].languageAttribute = language
      }
      let mut previous = NO_ELEMENT
      let mut child = index(Document.firstChild(document, id))
      while child != NO_ELEMENT {
        let childId = NodeId { index: child }
        if nodes[child].kind == NodeKind.Element {
          entries[i].empty = false
          entries[child].previous = previous
          if previous == NO_ELEMENT {
            entries[i].first = child
          } else {
            entries[previous].next = child
          }
          previous = child
        } else if nodes[child].kind == NodeKind.Text
          && !documentWhitespace(Document.text(document, childId)) {
          entries[i].empty = false
        }
        child = index(Document.nextSibling(document, childId))
      }
    }
    i = i + 1
  }
  drop entries
  return Tree { document: document, links: move links }
}

impl<'a> ElementTree for Tree<'a> {
  fn parent(self: &Self, node: usize) -> usize {
    let nodes = Document.nodes(self.document)
    return if node < nodes.length {
      index(nodes[node].parent)
    } else {
      NO_ELEMENT
    }
  }

  fn firstChild(self: &Self, node: usize) -> usize {
    let entries = self.links.asSlice()
    return if node < entries.length {
      entries[node].first
    } else {
      NO_ELEMENT
    }
  }

  fn nextSibling(self: &Self, node: usize) -> usize {
    let entries = self.links.asSlice()
    return if node < entries.length {
      entries[node].next
    } else {
      NO_ELEMENT
    }
  }

  fn previousSibling(self: &Self, node: usize) -> usize {
    let entries = self.links.asSlice()
    return if node < entries.length {
      entries[node].previous
    } else {
      NO_ELEMENT
    }
  }

  fn localName(self: &Self, node: usize) -> &[u8] {
    return Document.localName(self.document, NodeId { index: node })
  }

  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    return Document.namespaceUri(self.document, NodeId { index: node })
  }

  fn attributeCount(self: &Self, node: usize) -> usize {
    return Document.attributes(self.document, NodeId { index: node }).length
  }

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    let attrs = Document.attributes(self.document, NodeId { index: node })
    return if attribute < attrs.length {
      Document.attributeLocalName(self.document, attrs[attribute])
    } else {
      &[]
    }
  }

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    let attrs = Document.attributes(self.document, NodeId { index: node })
    return if attribute < attrs.length {
      Document.attributeNamespaceUri(self.document, attrs[attribute])
    } else {
      &[]
    }
  }

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    let attrs = Document.attributes(self.document, NodeId { index: node })
    return if attribute < attrs.length {
      Document.attributeValue(self.document, attrs[attribute])
    } else {
      &[]
    }
  }

  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    let id = NodeId { index: node }
    let attrs = Document.attributes(self.document, id)
    if attribute >= attrs.length {
      return false
    }
    let attr = attrs[attribute]
    return Document.attributeIsId(self.document, attr)
      || (Document.attributeNamespaceUri(self.document, attr).length == 0
        && equal(Document.attributeLocalName(self.document, attr), b"id")
        && equal(Document.namespaceUri(self.document, id), b"http://www.w3.org/2000/svg"))
  }

  fn language(self: &Self, node: usize) -> &[u8] {
    let entries = self.links.asSlice()
    if node >= entries.length || entries[node].languageOwner == NO_ELEMENT {
      return &[]
    }
    let entry = &entries[node]
    let attrs = Document.attributes(self.document, NodeId { index: entry.languageOwner })
    return Document.attributeValue(self.document, attrs[entry.languageAttribute])
  }

  fn isRoot(self: &Self, node: usize) -> bool {
    return Document.root(self.document).index == node
  }

  fn isEmpty(self: &Self, node: usize) -> bool {
    let entries = self.links.asSlice()
    return node < entries.length && entries[node].empty
  }

  fn isLink(self: &Self, node: usize) -> bool {
    let entries = self.links.asSlice()
    return node < entries.length && entries[node].link
  }
}
