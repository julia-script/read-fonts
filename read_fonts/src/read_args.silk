//! Named argument products replace Rust tuples in FontRead and ComputeSize.
// Copyright 2026 the fontations-silk Authors. Licensed under Apache-2.0 or MIT.
import silk.ownership { Copy }

// compiler-bugs/005: constrain Copy on the conformance, not the product.
pub struct ReadArgs2<A, B> {
  pub first: A,
  pub second: B,
}

impl<A: Copy, B: Copy> Copy for ReadArgs2<A, B> {}

pub struct ReadArgs3<A, B, C> {
  pub first: A,
  pub second: B,
  pub third: C,
}

impl<A: Copy, B: Copy, C: Copy> Copy for ReadArgs3<A, B, C> {}
