import ps.cff.index_offset { readOffset }
impl<'a> Index<'a> {
  pub fn sizeInBytes(self: &Self) -> Option<usize> {
    let count = u32.toUsize(Index.count(self))
    if count == 0 { return Option<usize>.some(4) }
    let last = match move Index.getOffset(self, count) { Option<usize>.Some { value } => value _ => { return Option<usize>.None } }
    return usize.checkedAdd(5 + ScalarArray<u8>.len(&Index.offsets(self)), last)
  }
  pub fn getOffset(self: &Self, index: usize) -> Option<usize> { return readOffset(index, u32.toUsize(Index.count(self)), Index.offSize(self), ScalarArray<u8>.offsetData(&Index.offsets(self))) }
  pub fn get(self: &Self, index: usize) -> Option<&'a [u8]> {
    let start = match move Index.getOffset(self, index) { Option<usize>.Some { value } => value _ => { return Option<&'a [u8]>.None } }
    let next = match move usize.checkedAdd(index, 1) { Option<usize>.Some { value } => value _ => { return Option<&'a [u8]>.None } }
    let end = match move Index.getOffset(self, next) { Option<usize>.Some { value } => value _ => { return Option<&'a [u8]>.None } }
    let data = ScalarArray<u8>.offsetData(&Index.data(self))
    return match move FontData.slice(&data, start, end) { Option<FontData<'a>>.Some { value } => Option<&'a [u8]>.some(FontData.asBytes(&value)) _ => Option<&'a [u8]>.None }
  }
}
