//! Command-line entry for the library benchmark: `font_bench WORKLOAD FONT` prints the
//! workload's checksum.
import workloads
import read_fonts.lib { FontRef, ReadError }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.format { Format }
import silk.host_input { HostInput, HostInputError }
import silk.option { Option }
import silk.os_writer { StdoutWriter, StderrWriter }
import silk.result { Result }
import silk.string { InvalidUtf8 }
import silk.writer { Writer, WriterError }
import silk.filesystem { Path, FileSystem, FileError }
import silk.os_filesystem { OsFileSystem }

effect fn stderr(text: string) -> ()
  ! WriterError {
  let mut writer = StderrWriter.make()
  run Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer)
}

fn measure<'a>(workload: string, font: &FontRef<'a>) -> Option<u64> {
  if workload == "cmap" {
    return Option<u64>.some(workloads.cmap(font))
  }
  if workload == "glyf" {
    return Option<u64>.some(workloads.glyf(font))
  }
  if workload == "cffsub" {
    return Option<u64>.some(workloads.cff(font, true))
  }
  if workload == "cff" {
    return Option<u64>.some(workloads.cff(font, false))
  }
  if workload == "hmtx" {
    return Option<u64>.some(workloads.hmtx(font))
  }
  return Option<u64>.None
}

effect fn process() -> i32
  ! HostInputError | OutOfMemoryError | WriterError | FileError
  ? &mut HostInput | &mut Allocator {
  if (run HostInput.argumentCount()) != 3 {
    run stderr("usage: font_bench cmap|glyf|hmtx|cff|cffsub FONT\n")
    return 2
  }
  let name = run HostInput.argument(1)
  let file = run HostInput.argument(2)
  if let Option<Bytes>.Some { value: nameBytes } = move name {
    if let Option<Bytes>.Some { value: fileBytes } = move file {
      if let Result<string, InvalidUtf8>.Success { value: workload } = move HostInput.text(
        Bytes.asSlice(&nameBytes),
      ) {
        let cwd = run HostInput.workingDirectory()
        let base = run Path.fromBytes(Bytes.asSlice(&cwd))
        let path = run pathFromArgument(&base, Bytes.asSlice(&fileBytes))
        let mut files = run OsFileSystem.make("/")
        let data = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
        let mut checksum: u64 = 0
        if let Result<FontRef, ReadError>.Success { value: font } = FontRef.new(
          Bytes.asSlice(&data),
        ) {
          match move measure(workload, &font) {
            Option<u64>.Some { value } => {
              checksum = value
            }
            _ => {
              run stderr("font_bench: unknown workload\n")
              return 2
            }
          }
        }
        let mut writer = StdoutWriter.make()
        run Format.format("{value}\n", &.{ value: checksum })
          |> Effect.provideMut<Writer>(&mut writer)
        return 0
      }
    }
  }
  return 2
}

effect fn pathFromArgument(base: &Path, raw: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if raw.length > 0 && raw[0] == 47 {
    return run Path.fromBytes(raw)
  }
  if let Result<string, InvalidUtf8>.Success { value } = move HostInput.text(raw) {
    return run Path.resolve(base, value)
  }
  return run Path.joinBytes(base, raw)
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  run stderr("font_bench: unable to read input\n")
  return 2
}

pub effect fn main() -> i32
  ! WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(process(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
