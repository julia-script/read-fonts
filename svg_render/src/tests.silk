import lib { render, RenderOptions, RenderError, Pixmap as Image }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32

fn alpha(image: &Image, x: u32, y: u32) -> u8 {
  return Image.data(image)[(u32.toUsize(y) * u32.toUsize(Image.width(image)) + u32.toUsize(x)) * 4
    + 3]
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/shapes.html#RectElement
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#FillProperty
test effect fn rectangleUsesInitialBlackFillAndBounds() -> ()
  ! AssertionError<'static> | RenderError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let options = RenderOptions.make()
  let image = run render(
    b"<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10'><rect x='2' y='3' width='4' height='2'/></svg>",
    &options,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Image.width(&image) == 10 && Image.height(&image) == 10,
    "intrinsic output dimensions",
  )
  run Testing.expect(
    alpha(&image, 2, 3) == 255 && alpha(&image, 5, 4) == 255,
    "filled rectangle interior",
  )
  run Testing.expect(
    alpha(&image, 1, 3) == 0 && alpha(&image, 6, 4) == 0,
    "rectangle exterior remains transparent",
  )
  run Testing.expect(Image.data(&image)[128] == 0, "initial fill is black")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/render.html#Grouping
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#FillProperty
test effect fn groupOpacityIsAppliedAfterChildrenAndFillInherits() -> ()
  ! AssertionError<'static> | RenderError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let options = RenderOptions.make()
  let image = run render(
    b"<svg xmlns='http://www.w3.org/2000/svg' width='8' height='4'><g fill='red' opacity='.5'><rect width='6' height='4'/><rect x='2' width='6' height='4'/></g></svg>",
    &options,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    alpha(&image, 1, 1) == 128 && alpha(&image, 3, 1) == 128,
    "overlap stays at group alpha, not per-child accumulated opacity",
  )
  let bytes = Image.data(&image)
  run Testing.expect(
    bytes[36] == 128 && bytes[37] == 0 && bytes[38] == 0,
    "inherited red is premultiplied",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#PreserveAspectRatioAttribute
test effect fn viewBoxMeetAndNoneDiffer() -> ()
  ! AssertionError<'static> | RenderError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let options = RenderOptions.make()
  let meet = run render(
    b"<svg xmlns='http://www.w3.org/2000/svg' width='20' height='10' viewBox='0 0 10 10'><rect width='10' height='10'/></svg>",
    &options,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stretch = run render(
    b"<svg xmlns='http://www.w3.org/2000/svg' width='20' height='10' viewBox='0 0 10 10' preserveAspectRatio='none'><rect width='10' height='10'/></svg>",
    &options,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    alpha(&meet, 0, 5) == 0 && alpha(&meet, 5, 5) == 255 && alpha(&meet, 15, 5) == 0,
    "default centered meet",
  )
  run Testing.expect(
    alpha(&stretch, 0, 5) == 255 && alpha(&stretch, 19, 5) == 255,
    "none stretches both axes",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#TransformProperty
test effect fn strokeAndTransformUseTheVectorBackend() -> ()
  ! AssertionError<'static> | RenderError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let options = RenderOptions.make()
  let image = run render(
    b"<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8'><g transform='translate(2 2)'><path d='M1 1h6' fill='none' stroke='blue' stroke-width='2'/></g></svg>",
    &options,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    alpha(&image, 3, 2) == 255 && alpha(&image, 8, 3) == 255,
    "translated stroke extent",
  )
  run Testing.expect(
    alpha(&image, 2, 2) == 0 && alpha(&image, 9, 3) == 0,
    "butt caps do not extend endpoints",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/render.html#VisibilityControl
test effect fn hiddenVisibilityCanBeOverriddenButDisplayCannot() -> ()
  ! AssertionError<'static> | RenderError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let options = RenderOptions.make()
  let image = run render(
    b"<svg xmlns='http://www.w3.org/2000/svg' width='8' height='4'><g visibility='hidden'><rect width='4' height='4'/><rect x='4' width='4' height='4' visibility='visible'/></g><g display='none'><rect width='8' height='4' display='inline'/></g></svg>",
    &options,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    alpha(&image, 1, 1) == 0 && alpha(&image, 6, 1) == 255,
    "visibility is inherited; display suppresses subtree",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/conform.html#ErrorProcessing
test effect fn malformedDocumentsAndOversizedTargetsReturnErrors() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let options = RenderOptions.make()
  let malformed = run Effect.result(render(b"<svg><g></svg>", &options))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = match &malformed {
    Result<Image, RenderError | OutOfMemoryError>.Failure { error } => match &error {
      RenderError problem => match &problem {
        RenderError.InvalidXml => true
        _ => false
      }
      OutOfMemoryError problem => {
        fail OutOfMemoryError {}
      }
    }
    _ => false
  }
  run Testing.expect(rejected, "XML errors reject the document")
  let large = run Effect.result(
    render(
      b"<svg xmlns='http://www.w3.org/2000/svg' width='1000000000' height='1000000000'/>",
      &options,
    ),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = match &large {
    Result<Image, RenderError | OutOfMemoryError>.Failure { error } => match &error {
      RenderError problem => match &problem {
        RenderError.TooLarge => true
        _ => false
      }
      OutOfMemoryError problem => {
        fail OutOfMemoryError {}
      }
    }
    _ => false
  }
  run Testing.expect(bounded, "target size cannot overflow or allocate unbounded memory")
}
