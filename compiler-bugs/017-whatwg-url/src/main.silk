// Existing RFC 3986 API, evaluated against a different (WHATWG URL) contract.
// A mismatch is a capability gap, not a bug in Uri's documented behavior.
import silk.core.result { Result }
import silk.uri.uri { Uri }
import silk.uri.reference { ParseError }

pub fn main() -> i32 {
  let uri = match Uri.parse("https://bücher.example/") {
    Result<Uri, ParseError>.Success { value } => value
    Result<Uri, ParseError>.Failure { error: _ } => {
      return 1
    }
  }
  if Uri.format(&uri) != "https://xn--bcher-kva.example/" {
    return 2
  }
  return 0
}
