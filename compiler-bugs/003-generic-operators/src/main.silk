import silk.ops { Add }
struct Value<T> { value: T, }
impl<T: Add<T, T>> Add<Value<T>, Value<T>> for Value<T> {
  fn add(left: Self, right: Self) -> Self {
    return Value<T> { value: move left.value + move right.value }
  }
}
pub fn main() -> i32 {
  let sum = Value<i32> { value: 20 } + Value<i32> { value: 22 }
  return sum.value - 42
}
