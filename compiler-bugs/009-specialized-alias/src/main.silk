struct Wrapped<'a, T> {
  value: &'a T,
}

impl<'a, T> Wrapped<'a, T> {
  fn new(value: &'a T) -> Self {
    return Self { value: value }
  }
}

type IntRef<'a> = Wrapped<'a, i32>

fn wrap(value: &i32) -> () {
  let result = IntRef.new(value)
}

pub fn main() -> i32 {
  let value: i32 = 42
  wrap(&value)
  return 0
}
