#!/usr/bin/env sh
# Build hr_wasm for wasm32 and copy it to hr_wasm/js/dist/harfrust.wasm.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
silk build --release --manifest-path "$root/hr_wasm/silk.toml" --target wasm32-unknown-unknown
mkdir -p "$root/hr_wasm/js/dist"
cp "$root/build/llvm/wasm32-unknown-unknown/release/hr_wasm" "$root/hr_wasm/js/dist/harfrust.wasm"
echo "$root/hr_wasm/js/dist/harfrust.wasm"
