#!/usr/bin/env python3
"""Run the shaping PR gate locally, with one Silk compiler at a time."""
import argparse
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--no-build', action='store_true', help='reuse existing release binaries; omit library compilation')
args = parser.parse_args()
silk = os.environ.get('SILK', 'silk')
commands = []
if not args.no_build:
    commands += [[silk, 'test', '--release', '--manifest-path', 'harfrust/silk.toml', '--root', 'src/tests.silk'],
                 [silk, 'build', '--release', '--manifest-path', 'hr_shape/silk.toml']]
binary = str(ROOT / 'build/llvm/x86_64-unknown-linux-gnu/release/hr_shape')
commands += [[binary, '--suite', 'harfrust/tests/shaping.bin'], [binary, '--regressions'],
             ['scripts/check-shaping-trace'], ['scripts/check-shaping-malformed']]
for command in commands:
    subprocess.run(command, cwd=ROOT, check=True)
