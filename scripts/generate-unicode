#!/usr/bin/env python3
"""Extract Unicode constants from the pinned Harfrust source (no Rust build)."""
from pathlib import Path
import re
import struct

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "test-data/harfrust/harfrust/src"


def array(source, name):
    match = re.search(rf"(?:static|const) {name}:.*?=\s*&?\[(.*?)\];", source, re.S)
    if not match:
        raise ValueError(f"missing upstream array {name}")
    return re.sub(r"//[^\n]*|/\*.*?\*/", "", match[1], flags=re.S)


def numbers(text):
    return [int(v.strip(), 0) for v in text.split(",") if v.strip()]


def byte_function(name, data):
    # Byte literals keep generated data out of the compiler's expression tree.
    literal = "".join(f"\\x{byte:02x}" for byte in data)
    return f'pub fn {name}() -> &\'static [u8] {{ return b"{literal}" }}\n'


def script_tags():
    return dict(re.findall(r'pub const (\w+): Self = Self::from_bytes\(b"(....)"\);', (SOURCE / "script.rs").read_text()))


def generate():
    source = (SOURCE / "unicode/ucd_table.rs").read_text()
    scripts = script_tags()
    out = ["// THIS FILE IS AUTOGENERATED by scripts/generate-unicode. DO NOT EDIT.\n",
           "// Unicode 18 data from Harfrust 1503ff0. Copyright HarfBuzz developers. MIT.\n"]
    for name, fmt in [("ucd_u8", "B"), ("ucd_u16", "H"), ("ucd_palette", "i"),
                      ("ucd_dm1_p0_map", "H"), ("ucd_dm1_p2_map", "H")]:
        out.append(byte_function(name, b"".join(struct.pack(">" + fmt, n) for n in numbers(array(source, name)))))
    out.append(byte_function("scripts", b"".join(scripts[name].encode() for name in re.findall(r"Script::(\w+)", array(source, "ucd_sc_map")))))
    triples = []
    for name in ["ucd_dm2_u32_map", "ucd_dm2_u64_map"]:
        values = [tuple(int(v, 0) for v in match) for match in re.findall(r"\((0x[0-9A-Fa-f]+),\s*(0x[0-9A-Fa-f]+),\s*(0x[0-9A-Fa-f]+)\)", array(source, name))]
        triples.extend(values)
    out.append(byte_function("decompositions", b"".join(struct.pack(">III", *v) for v in triples)))
    out.append(byte_function("compositions", b"".join(struct.pack(">III", *v) for v in sorted(triples) if v[2])))
    seconds = "".join(f"    0x{v:x} => true\n" for v in sorted({v[1] for v in triples if v[2]}))
    out.append(f"pub fn composesAsSecond(cp: u32) -> bool {{\n  return match cp {{\n{seconds}    _ => false\n  }}\n}}\n")
    unicode = (SOURCE / "unicode/mod.rs").read_text()
    vertical = unicode.split("fn vertical(self) -> Option<Codepoint> {", 1)[1].split("#[cfg", 1)[0]
    out.append(byte_function("vertical", b"".join(struct.pack(">II", int(a,16), int(b,16)) for a,b in re.findall(r"(0x[0-9a-f]+) => (0x[0-9a-f]+)", vertical))))
    emoji = (SOURCE / "unicode/emoji_table.rs").read_text()
    out.append(byte_function("emoji", bytes(numbers(array(emoji, "emoji_u8")))))
    arabic = (SOURCE / "ot/shaper/arabic_table.rs").read_text()
    out.append(byte_function("joining", bytes(numbers(array(arabic, "arabic_joining_u8")))))
    (ROOT / "ucd/src/generated_unicode.silk").write_text("".join(out))


if __name__ == "__main__":
    generate()
