#!/usr/bin/env python3
"""Preserve upstream specification bytes as packed Silk test fixtures."""
import re
import sys
from pathlib import Path
root = Path(__file__).resolve().parents[1]
out = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
for module in ('layout', 'gdef', 'gsub', 'gpos'):
    source = (root / f'upstream/font-test-data/src/{module}.rs').read_text()
    source = re.sub(r'//[^\n]*', '', source)
    for name, body in re.findall(r'pub (?:static|const) (\w+): &\[u8\] = &\[([^]]*)\];', source):
        values = [int(n.strip(), 0) for n in body.split(',') if n.strip()]
        function = module + ''.join(part.title() for part in name.split('_'))
        packed = ''.join(f'\\x{v:02x}' for v in values)
        out += f'pub fn {function}() -> &\'static [u8] {{ return b"{packed}" }}\n'
target = root / 'packages/read_fonts/src/generated_layout_fixtures.silk'
if '--check' in sys.argv:
    if not target.exists() or target.read_text() != out:
        raise SystemExit('Layout fixtures differ')
else:
    target.write_text(out)
