#!/usr/bin/env python3
"""Run the SVG phase-one gate; never builds a GPU package or a reference renderer."""
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[2]


def run(*command):
    print("+ " + " ".join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=ROOT, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--offline", action="store_true", help="verify existing caches without network access")
    parser.add_argument("--skip-fetch", action="store_true", help="skip spec/suite cache checks for local source-only work")
    args = parser.parse_args()
    silk = os.environ.get("SILK", "silk")
    python = sys.executable
    manifest = tomllib.loads((ROOT / "silk.toml").read_text())
    packages = [name for name in manifest["workspace"]["members"] if name.startswith("svg_")]
    if not packages:
        parser.error("no SVG workspace members")
    vector = ROOT / "vendor/silk-gpu/vector/silk.toml"
    if not vector.is_file():
        parser.error("initialize the dependency: git submodule update --init vendor/silk-gpu")
    clang = os.environ.get("SILK_CLANG", "")
    if not Path(clang).is_absolute() or not Path(clang).is_file():
        parser.error("SILK_CLANG must be the absolute path to Clang 22 or newer (see README)")
    # Keep compiles serial: the font/shaping dependency closure can be memory-heavy.
    run(silk, "check", "--workspace")
    run(silk, "build", "--manifest-path", vector)
    for package in packages:
        run(silk, "format", "--check", "--manifest-path", f"{package}/silk.toml")
    for package in packages:
        if (ROOT / package / "src/tests.silk").is_file():
            run(silk, "test", "--manifest-path", f"{package}/silk.toml", "--root", "src/tests.silk")
    run(silk, "test", "--manifest-path", vector, "--root", "src/tests.silk")
    run(python, "-m", "unittest", "discover", "-s", "scripts/svg/tests", "-p", "test_*.py")
    if not args.skip_fetch:
        offline = ["--offline"] if args.offline else []
        run(python, "scripts/svg/fetch-specs.py", "--only", "svg2-coords", "svg2-paths", "svg2-conform", *offline)
        run(python, "scripts/svg/fetch-suites", *offline)
        run(python, "scripts/svg/reftests", "--validate")
    print("SVG phase-one gate passed. No SVG documents rendered; renderer phases are not implemented.")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
