#!/usr/bin/env python3
"""Pack immutable upstream model fixtures as static Silk byte strings."""
import argparse
import re
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
fixtures = {
    'hvarNames': 'upstream/font-test-data/test_data/ttf/hvar_with_truncated_adv_index_map.ttf',
    'notoSansJp': 'upstream/font-test-data/test_data/ttf/NotoSansJP-Regular.subset.otf',
    'ahem': 'upstream/font-test-data/test_data/ttf/ahem.ttf',
    'tinos': 'upstream/font-test-data/test_data/ttf/tinos_subset.ttf',
}
text = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2026 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
for name, filename in fixtures.items():
    data = (ROOT / filename).read_bytes()
    literal = ''.join(f'\\x{byte:02x}' for byte in data)
    text += f'pub fn {name}() -> &\'static [u8] {{ return b"{literal}" }}\n'
source = (ROOT / 'upstream/font-test-data/src/lib.rs').read_text()
body = source.split('pub mod post {', 1)[1].split('pub static SIMPLE:', 1)[1].split('&[', 2)[2].split('];', 1)[0]
body = re.sub(r'//[^\n]*', '', body)
data = bytes(int(x.strip(), 0) for x in body.split(',') if x.strip())
literal = ''.join(f'\\x{byte:02x}' for byte in data)
text += f'pub fn postSimple() -> &\'static [u8] {{ return b"{literal}" }}\n'
path = ROOT / 'packages/read_fonts/src/generated_model_fixtures.silk'
if args.check:
    if not path.exists() or path.read_text() != text:
        parser.exit(1, 'Generated model fixtures differ\n')
else:
    path.write_text(text)
print(f'{"Checked" if args.check else "Generated"} {len(fixtures)+1} model fixtures')
