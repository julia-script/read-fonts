#!/usr/bin/env python3
"""Compare Phase 2 fields, offset arrays and malformed nested table views."""
import argparse
import ast
from pathlib import Path
import re
import runpy
import struct
import tempfile
import harness

ROOT = Path(__file__).resolve().parents[1]
helpers = runpy.run_path(str(ROOT / 'scripts/check-model-fixtures'))
sfnt, tables = helpers['sfnt'], helpers['tables']


def fixtures():
    source = (ROOT / 'packages/read_fonts/src/generated_phase2_fixtures.silk').read_text()
    packed = {name: ast.literal_eval(literal) for name, literal in re.findall(
        r"pub fn (\w+)\(\) -> &'static \[u8\] \{ return (b\"[^\"]*\") \}", source)}
    seeds = {b'BASE': packed['baseTable'], b'meta': packed['simpleMeta'],
             b'gasp': bytes.fromhex('0001000201940003ffff000c'),
             b'hdmx': bytes.fromhex('0000000300000008080d0a0c0d00000010151214150000002034262834000000'),
             b'CPAL': bytes.fromhex('00010001000100010000001a00000000001e0000002200000024010203040000000301010102'),
             b'DSIG': bytes.fromhex('0000000100010001000000010000000c000000140000000000000004deadbeef')}
    words = [0,0,10,0,0,3,1,3,0,38,0,10,6,7,0,48,0,6,9,9,0,38,0,10,1,0,0,0,1,2,0,0]
    seeds[b'SVG '] = struct.pack('>32H', *words)
    for name in ('cvarFont', 'gradientFont'):
        yield name, packed[name]
        seeds.update({tag: value for tag, value in tables(packed[name]).items()
                      if tag in (b'cvar', b'CPAL', b'STAT')})
    # The v1 palette exercises typed flag/name-id array offsets separately.
    seeds[b'CPAL'] = bytes.fromhex('00010001000100010000001a00000000001e0000002200000024010203040000000301010102')
    for tag, data in seeds.items():
        required = {b'maxp': struct.pack('>IH', 0x5000, 3)}
        cuts = sorted(set(range(min(64, len(data) + 1))) | {len(data) // 2, len(data) - 1, len(data)})
        for cut in cuts:
            yield f'{tag.hex()}-prefix-{cut}', sfnt({**required, tag: data[:cut]})
        # Probe offsets/counts at both ends without changing the original fixtures.
        for index in sorted({0, 2, 4, 8, 12, 16, 20, len(data)-4}):
            if index < 0 or index + 4 > len(data):
                continue
            for value in (0, 0xffffffff):
                changed = bytearray(data)
                struct.pack_into('>I', changed, index, value)
                yield f'{tag.hex()}-word-{index}-{value}', sfnt({**required, tag: bytes(changed)})
    for tag, payload in [(b'dlng', b'en-latn, latn'), (b'slng', b'\xff, x'),
                         (b'xxxx', b'\x00\xff\x01'), (b'dlng', b',,,')]:
        meta = struct.pack('>IIII4sII', 1, 0, 0, 1, tag, 28, len(payload)) + payload
        yield 'meta-' + tag.hex() + '-' + payload.hex(), sfnt({b'meta': meta})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--reference', type=Path, default=harness.REFERENCE)
    parser.add_argument('--silk-dumper', type=Path)
    parser.add_argument('--report', type=Path)
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix='font-phase2-fixtures-') as temporary:
        paths = []
        for name, data in fixtures():
            path = Path(temporary) / f'{name}.ttf'
            path.write_bytes(data)
            paths.append(path)
        assert len(paths) == len(set(paths)), 'fixture names must be unique'
        return harness.compare(paths, args.reference, args.silk_dumper or harness.silk_binary(), 120, args.report)


if __name__ == '__main__':
    raise SystemExit(main())
