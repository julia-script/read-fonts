#!/usr/bin/env python3
"""Generate Silk views using the copied upstream grammar parser; --check rejects drift."""
import argparse
import os
import re
from pathlib import Path
import subprocess
import tomllib

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--check", action="store_true")
args = parser.parse_args()
subprocess.run([os.environ.get("CARGO", "cargo"), "build", "--locked", "--manifest-path",
                str(ROOT / "tools/font-codegen-silk/Cargo.toml"), "--target-dir",
                str(ROOT / "build/codegen"), "--bin", "codegen"], check=True)
plan = tomllib.loads((ROOT / "tools/codegen-plan.toml").read_text())
different = []
for operation in plan["generate"]:
    generated = subprocess.check_output([str(ROOT / "build/codegen/debug/codegen"), "file",
                                         operation["mode"], str(ROOT / operation["source"])])
    for extension in operation.get("extensions", []):
        generated += (f"\n// Handwritten extension from {extension}\n".encode()
                      + (ROOT / extension).read_bytes())
    if "facade" in operation:
        names = re.findall(rb"^pub (?:struct|union|enum(?:\([^)]*\))?|type) (\w+)", generated, re.M)
        module = Path(operation["target"]).stem
        facade = (b"// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n"
                  + f"pub import {module} {{ ".encode() + b", ".join(names) + b" }\n")
        dest = ROOT / operation["facade"]
        if args.check:
            if not dest.exists() or dest.read_bytes() != facade:
                different.append(operation["facade"])
        else:
            dest.write_bytes(facade)
    target = ROOT / operation["target"]
    if args.check:
        if not target.exists() or target.read_bytes() != generated:
            different.append(operation["target"])
    else:
        target.write_bytes(generated)
if different:
    parser.exit(1, "Generated output differs: " + ", ".join(different) + "\n")
print(f"{'Checked' if args.check else 'Generated'} {len(plan['generate'])} files")

subprocess.run([str(ROOT / "scripts/generate-static")] + (["--check"] if args.check else []), check=True)
subprocess.run([str(ROOT / "scripts/generate-layout-fixtures")] + (["--check"] if args.check else []), check=True)
