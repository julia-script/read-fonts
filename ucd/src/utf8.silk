//! Allocation-free scalar decoding for byte-oriented text algorithms.
//! Invalid UTF-8 consumes one byte and yields U+FFFD; offsets always refer to input bytes.
import silk.ownership { Copy }
import silk.slice { Slice }
import silk.result { Result }
import silk.string { String, InvalidUtf8 }
import silk.u8
import silk.u32

pub struct Decoded {
  pub cp: u32,
  pub next: usize,
}

impl Copy for Decoded {}

/// Decodes the scalar at `at`. ASCII stays inline; longer sequences take one call.
pub fn decode(bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
  if at < bytes.length && bytes[at] < 128 {
    return Decoded { cp: u8.toU32(bytes[at]), next: at + 1 }
  }
  return decodeMultibyte(bytes, at)
}

/// True when `bytes` is well-formed UTF-8, so `decodeValid` may read it. Validation runs
/// in blocks and costs far less than checking each sequence while decoding.
pub fn valid(bytes: &[u8]) -> bool {
  return match String.fromUtf8(bytes) {
    Result<string, InvalidUtf8>.Success { value } => true
    Result<string, InvalidUtf8>.Failure { error } => false
  }
}

/// How a scanner decodes scalars, chosen once per call so its loop has no extra branch.
pub interface ScalarDecoder {
  fn scalarAt(self: &Self, bytes: &[u8], at: usize) -> Decoded
}

/// Decodes any bytes, replacing ill-formed sequences.
pub struct Checked {}

impl Copy for Checked {}

impl ScalarDecoder for Checked {
  fn scalarAt(self: &Self, bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
    return decode(bytes, at)
  }
}

/// Decodes text that `valid` accepted.
pub struct Trusted {}

impl Copy for Trusted {}

impl ScalarDecoder for Trusted {
  fn scalarAt(self: &Self, bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
    return decodeValid(bytes, at)
  }
}

/// `decode` for text that `valid` accepted: the lead byte alone gives the length.
pub fn decodeValid(bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
  if at < bytes.length && bytes[at] < 128 {
    return Decoded { cp: u8.toU32(bytes[at]), next: at + 1 }
  }
  return decodeValidMultibyte(bytes, at)
}

fn decodeValidMultibyte(bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
  if at >= bytes.length {
    return Decoded { cp: 0xfffd, next: bytes.length }
  }

  // The length checks only keep indexing in bounds; valid text always passes them.
  let rest = Slice.view<u8>(bytes, at, bytes.length - at)
  let lead = rest[0]
  if lead < 0xe0 {
    if rest.length >= 2 {
      return Decoded { cp: payload(lead, 0x1f, 6) | payload(rest[1], 0x3f, 0), next: at + 2 }
    }
  } else if lead < 0xf0 {
    if rest.length >= 3 {
      let cp = payload(lead, 0x0f, 12) | payload(rest[1], 0x3f, 6) | payload(rest[2], 0x3f, 0)
      return Decoded { cp: cp, next: at + 3 }
    }
  } else if rest.length >= 4 {
    let cp = payload(lead, 0x07, 18) | payload(rest[1], 0x3f, 12) | payload(rest[2], 0x3f, 6)
      | payload(rest[3], 0x3f, 0)
    return Decoded { cp: cp, next: at + 4 }
  }
  return Decoded { cp: 0xfffd, next: at + 1 }
}

fn isContinuation(byte: u8) -> bool with Intrinsic.inlineAlways() {
  return (byte & 0xc0) == 0x80
}

fn payload(byte: u8, mask: u8, shift: u32) -> u32 with Intrinsic.inlineAlways() {
  return u32.shiftLeft(u8.toU32(byte & mask), shift)
}

// RFC 3629 well-formed sequences only: no overlongs, surrogates or values past U+10FFFF.
// Checking the decoded value is equivalent to RFC 3629's second-byte ranges.
fn decodeMultibyte(bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
  if at >= bytes.length {
    return Decoded { cp: 0xfffd, next: bytes.length }
  }

  // Indexing a view by constants lets the length checks below cover every access.
  let rest = Slice.view<u8>(bytes, at, bytes.length - at)
  let lead = rest[0]
  if lead >= 0xe0 {
    if lead < 0xf0 {
      if rest.length >= 3 && isContinuation(rest[1]) && isContinuation(rest[2]) {
        let cp = payload(lead, 0x0f, 12) | payload(rest[1], 0x3f, 6) | payload(rest[2], 0x3f, 0)
        if cp >= 0x800 && (cp < 0xd800 || cp > 0xdfff) {
          return Decoded { cp: cp, next: at + 3 }
        }
      }
    } else if lead <= 0xf4 {
      if rest.length >= 4 && isContinuation(rest[1]) && isContinuation(rest[2])
        && isContinuation(rest[3]) {
        let cp = payload(lead, 0x07, 18) | payload(rest[1], 0x3f, 12) | payload(rest[2], 0x3f, 6)
          | payload(rest[3], 0x3f, 0)
        if cp >= 0x10000 && cp <= 0x10ffff {
          return Decoded { cp: cp, next: at + 4 }
        }
      }
    }
  } else if lead >= 0xc2 {
    if rest.length >= 2 && isContinuation(rest[1]) {
      return Decoded { cp: payload(lead, 0x1f, 6) | payload(rest[1], 0x3f, 0), next: at + 2 }
    }
  }
  return Decoded { cp: 0xfffd, next: at + 1 }
}
