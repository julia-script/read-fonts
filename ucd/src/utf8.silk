//! Allocation-free scalar decoding for byte-oriented text algorithms.
//! Invalid UTF-8 consumes one byte and yields U+FFFD; offsets always refer to input bytes.
import silk.ownership { Copy }
import silk.u8
import silk.u32

pub struct Decoded {
  pub cp: u32,
  pub next: usize,
}

impl Copy for Decoded {}

/// Decodes the scalar at `at`. ASCII stays inline; longer sequences take one call.
pub fn decode(bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
  if at < bytes.length && bytes[at] < 128 {
    return Decoded { cp: u8.toU32(bytes[at]), next: at + 1 }
  }
  return decodeMultibyte(bytes, at)
}

fn continuation(bytes: &[u8], at: usize) -> u32 with Intrinsic.inlineAlways() {
  return u8.toU32(bytes[at]) & 0x3f
}

fn isContinuation(byte: u8) -> bool with Intrinsic.inlineAlways() {
  return (byte & 0xc0) == 0x80
}

// RFC 3629 well-formed sequences only: no overlongs, surrogates or values past U+10FFFF.
fn decodeMultibyte(bytes: &[u8], at: usize) -> Decoded with Intrinsic.inlineAlways() {
  if at >= bytes.length {
    return Decoded { cp: 0xfffd, next: bytes.length }
  }
  let lead = bytes[at]
  let remaining = bytes.length - at
  if lead >= 0xc2 && lead <= 0xdf {
    if remaining >= 2 && isContinuation(bytes[at + 1]) {
      return Decoded {
        cp: u32.shiftLeft(u8.toU32(lead) & 0x1f, 6) | continuation(bytes, at + 1),
        next: at + 2,
      }
    }
  } else if lead >= 0xe0 && lead <= 0xef {
    if remaining >= 3 {
      let second = bytes[at + 1]
      let mut low: u8 = 0x80
      let mut high: u8 = 0xbf
      if lead == 0xe0 {
        low = 0xa0
      } else if lead == 0xed {
        high = 0x9f
      }
      if second >= low && second <= high && isContinuation(bytes[at + 2]) {
        return Decoded {
          cp: u32.shiftLeft(u8.toU32(lead) & 0x0f, 12)
            | u32.shiftLeft(continuation(bytes, at + 1), 6)
            | continuation(bytes, at + 2),
          next: at + 3,
        }
      }
    }
  } else if lead >= 0xf0 && lead <= 0xf4 {
    if remaining >= 4 {
      let second = bytes[at + 1]
      let mut low: u8 = 0x80
      let mut high: u8 = 0xbf
      if lead == 0xf0 {
        low = 0x90
      } else if lead == 0xf4 {
        high = 0x8f
      }
      if second >= low && second <= high && isContinuation(bytes[at + 2])
        && isContinuation(bytes[at + 3]) {
        return Decoded {
          cp: u32.shiftLeft(u8.toU32(lead) & 0x07, 18)
            | u32.shiftLeft(continuation(bytes, at + 1), 12)
            | u32.shiftLeft(continuation(bytes, at + 2), 6)
            | continuation(bytes, at + 3),
          next: at + 4,
        }
      }
    }
  }
  return Decoded { cp: 0xfffd, next: at + 1 }
}
