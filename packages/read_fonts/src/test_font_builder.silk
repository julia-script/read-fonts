import silk.usize
import silk.u16
import silk.u32
pub fn put16(out: &mut [u8], at: usize, value: u16) -> () { out[at] = u16.toU8(value / 256) out[at + 1] = u16.toU8(value & 255) }
pub fn put32(out: &mut [u8], at: usize, value: u32) -> () { out[at] = u32.toU8(u32.shiftRight(value, 24)) out[at + 1] = u32.toU8(u32.shiftRight(value, 16) & 255) out[at + 2] = u32.toU8(u32.shiftRight(value, 8) & 255) out[at + 3] = u32.toU8(value & 255) }
pub struct TestTable<'a> { pub tag: u32, pub data: &'a [u8], }
pub fn font(out: &mut [u8], tables: &[TestTable]) -> usize {
  let mut i: usize = 0 while i < out.length { out[i] = 0 i = i + 1 }
  put32(&mut out, 0, 65536) put16(&mut out, 4, usize.toU16(tables.length))
  let mut position = 12 + tables.length * 16 i = 0
  while i < tables.length {
    let record = 12 + i * 16
    put32(&mut out, record, tables[i].tag) put32(&mut out, record + 8, usize.toU32(position)) put32(&mut out, record + 12, usize.toU32(tables[i].data.length))
    let mut j: usize = 0 while j < tables[i].data.length { out[position + j] = tables[i].data[j] j = j + 1 }
    position = (position + tables[i].data.length + 3) & (usize.MAX - 3) i = i + 1
  }
  return position
}
pub fn gvar(out: &mut [u8], count: u32, extended: bool, longOffsets: bool, wideDataOffset: bool) -> usize {
  let mut i: usize = 0 while i < out.length { out[i] = 0 i = i + 1 }
  let mut header: usize = 20 if extended { header = 21 }
  let mut width: usize = 2 if longOffsets { width = 4 }
  let shared = header + (u32.toUsize(count) + 1) * width let body = shared + 2
  put32(&mut out, 0, 65536) put16(&mut out, 4, 1) put16(&mut out, 6, 1) put32(&mut out, 8, usize.toU32(shared))
  let mut flags: usize = 14 if extended { out[12] = u32.toU8(u32.shiftRight(count, 16) & 255) out[13] = u32.toU8(u32.shiftRight(count, 8) & 255) out[14] = u32.toU8(count & 255) flags = 15 } else { put16(&mut out, 12, u32.toU16(count)) }
  if longOffsets { put16(&mut out, flags, 1) } put32(&mut out, flags + 2, usize.toU32(body)) put16(&mut out, shared, 16384)
  let mut end = body let mut firstEnd: usize = 0 let mut item: usize = 0
  while item < 2 {
    let start = end let mut dataOffset: usize = 8 if extended { dataOffset = 9 } if wideDataOffset && item == 1 { dataOffset = 65537 }
    put16(&mut out, start, 1)
    let mut tupleHeader = start + 4
    if extended { put32(&mut out, start + 1, usize.toU32(dataOffset)) out[start + 1] = 1 tupleHeader = start + 5 } else { put16(&mut out, start + 2, usize.toU16(dataOffset)) }
    let mut points: usize = 5 if item == 1 { points = 8 }
    put16(&mut out, tupleHeader, usize.toU16(points * 2 + 3)) put16(&mut out, tupleHeader + 2, 8192)
    let serialized = start + dataOffset out[serialized + 1] = usize.toU8(points - 1) out[serialized + 2 + points] = usize.toU8(points - 1)
    if item == 0 { out[serialized + 2] = 20 out[serialized + 4] = 60 }
    else { out[serialized + 2] = 40 out[serialized + 3] = 40 out[serialized + 4] = 40 out[serialized + 5] = 40 out[serialized + 7] = 100 out[serialized + 17] = 40 out[serialized + 18] = 236 }
    end = serialized + points * 2 + 3 if !longOffsets { end = body + ((end - body + 1) & (usize.MAX - 1)) }
    if item == 0 { firstEnd = end - body }
    item = item + 1
  }
  i = 0 while i <= u32.toUsize(count) {
    let mut offset: usize = 0 if i >= 2 { offset = firstEnd } if i == u32.toUsize(count) { offset = end - body }
    if longOffsets { put32(&mut out, header + i * width, usize.toU32(offset)) } else { put16(&mut out, header + i * width, usize.toU16(offset / 2)) }
    i = i + 1
  }
  return end
}
