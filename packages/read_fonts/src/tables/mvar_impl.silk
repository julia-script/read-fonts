import generated_variations { DeltaSetIndex }
import font_types.lib { F48Dot16 }
pub struct MvarInstance<'a> { records: ComputedArray<'a, (), ValueRecord<'a>>, ivs: ItemVariationStore<'a>, coords: &'a [F2Dot14], }
impl<'a> Copy for MvarInstance<'a> {}
impl<'a> Mvar<'a> {
  pub fn at(self: &Self, coords: &'a [F2Dot14]) -> Option<MvarInstance<'a>> {
    if coords.length == 0 { return Option<MvarInstance<'a>>.None }
    let store = match move Mvar.itemVariationStore(self) { Option<Result<ItemVariationStore<'a>, ReadError>>.Some { value: Result<ItemVariationStore<'a>, ReadError>.Success { value } } => value _ => { return Option<MvarInstance<'a>>.None } }
    return Option<MvarInstance<'a>>.some(MvarInstance<'a> { records: Mvar.valueRecords(self), ivs: store, coords: coords })
  }
  pub fn metricDelta(self: &Self, tag: Tag, coords: &[F2Dot14]) -> Option<Fixed> {
    let record = match move findMetric(&Mvar.valueRecords(self), tag, false) { Option<ValueRecord<'a>>.Some { value } => value _ => { return Option<Fixed>.None } }
    let store = match move Mvar.itemVariationStore(self) { Option<Result<ItemVariationStore<'a>, ReadError>>.Some { value: Result<ItemVariationStore<'a>, ReadError>.Success { value } } => value _ => { return Option<Fixed>.None } }
    return match move ItemVariationStore.computeDelta(&store, DeltaSetIndex { outer: ValueRecord.deltaSetOuterIndex(&record), inner: ValueRecord.deltaSetInnerIndex(&record) }, coords) { Option<F48Dot16>.Some { value } => Option<Fixed>.some(Fixed.fromI32(F48Dot16.toI32(value))) _ => Option<Fixed>.None }
  }
}
impl<'a> MvarInstance<'a> {
  pub fn get(self: &Self, tag: Tag) -> Option<F48Dot16> {
    let record = match move findMetric(&self.records, tag, true) { Option<ValueRecord<'a>>.Some { value } => value _ => { return Option<F48Dot16>.None } }
    return ItemVariationStore.computeDelta(&self.ivs, DeltaSetIndex { outer: ValueRecord.deltaSetOuterIndex(&record), inner: ValueRecord.deltaSetInnerIndex(&record) }, self.coords)
  }
}
fn findMetric<'a>(records: &ComputedArray<'a, (), ValueRecord<'a>>, tag: Tag, rightmost: bool) -> Option<ValueRecord<'a>> {
  let target = Tag.toU32(tag)
  let mut low: usize = 0
  let mut high = ComputedArray<'a, (), ValueRecord<'a>>.len(records)
  while low < high {
    let mid = low + (high - low) / 2
    let record = match move ComputedArray<'a, (), ValueRecord<'a>>.get(records, mid) { Result<ValueRecord<'a>, ReadError>.Success { value } => value _ => { return Option<ValueRecord<'a>>.None } }
    let found = Tag.toU32(ValueRecord.valueTag(&record))
    if found == target && !rightmost { return Option<ValueRecord<'a>>.some(record) }
    if found <= target { low = mid + 1 } else { high = mid }
  }
  if rightmost && low != 0 {
    let record = match move ComputedArray<'a, (), ValueRecord<'a>>.get(records, low - 1) { Result<ValueRecord<'a>, ReadError>.Success { value } => value _ => { return Option<ValueRecord<'a>>.None } }
    if Tag.toU32(ValueRecord.valueTag(&record)) == target { return Option<ValueRecord<'a>>.some(record) }
  }
  return Option<ValueRecord<'a>>.None
}
