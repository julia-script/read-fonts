import font_types.lib { Scalar, FixedSize, readScalar, writeScalar }
import silk.option { Option }
import silk.ownership { Copy }
import silk.equal { Equal }
import silk.u16
pub struct TupleIndex { raw: u16, }
impl Copy for TupleIndex {}
impl TupleIndex {
  pub fn new(bits: u16) -> Self { return Self { raw: bits } }
  pub fn fromBits(bits: u16) -> Self { return Self { raw: bits } }
  pub fn bits(self: Self) -> u16 { return self.raw }
  pub fn default() -> Self { return Self { raw: 0 } }
  pub fn embeddedPeakTuple(self: Self) -> bool { return (self.raw & 32768) != 0 }
  pub fn intermediateRegion(self: Self) -> bool { return (self.raw & 16384) != 0 }
  pub fn privatePointNumbers(self: Self) -> bool { return (self.raw & 8192) != 0 }
  pub fn tupleRecordsIndex(self: Self) -> Option<u16> { if TupleIndex.embeddedPeakTuple(self) { return Option<u16>.None } return Option<u16>.some(self.raw & 4095) }
  pub fn tupleLen(self: Self, axisCount: u16, flag: usize) -> usize { if flag == 0 { if TupleIndex.embeddedPeakTuple(self) { return u16.toUsize(axisCount) } } else { if TupleIndex.intermediateRegion(self) { return u16.toUsize(axisCount) } } return 0 }
}
impl Scalar for TupleIndex { fn rawByteLen() -> usize { return 2 } fn read(bytes: &[u8]) -> Option<Self> { return match move readScalar<u16>(bytes) { Option<u16>.Some { value } => Option<Self>.some(TupleIndex.new(value)) Option<u16>.None => Option<Self>.None } } fn write(value: Self, bytes: &mut [u8]) -> bool { return writeScalar<u16>(value.raw, move bytes) } }
impl FixedSize for TupleIndex { fn rawByteLen() -> usize { return 2 } }
impl Equal for TupleIndex { fn equals(left: &Self, right: &Self) -> bool { return left.raw == right.raw } }
