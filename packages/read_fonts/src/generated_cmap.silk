    return match move FontData<'a>.readAt<u32>(&self._fontData, (self.position + 0)) { Result<u32, ReadError>.Success { value } => value Result<u32, ReadError>.Failure { error } => 0 }
  }
/// Last character code in this group; same condition as listed
/// above for the startCharCode
  pub fn endCharCode(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, (self.position + 4)) { Result<u32, ReadError>.Success { value } => value Result<u32, ReadError>.Failure { error } => 0 }
  }
/// Glyph index corresponding to the starting character code
  pub fn startGlyphId(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, (self.position + 8)) { Result<u32, ReadError>.Success { value } => value Result<u32, ReadError>.Failure { error } => 0 }
  }
}
impl<'a> FixedSize for SequentialMapGroup<'a> { fn rawByteLen() -> usize { return 12 } }
impl<'a> ComputeSize<()> for SequentialMapGroup<'a> { fn computeSize(args: ()) -> Result<usize, ReadError> { return Result<usize, ReadError>.succeed(12) } }
impl<'a> FontReadAt<'a, ()> for SequentialMapGroup<'a> { fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> { return SequentialMapGroup<'a>.readAt(data, position, ()) } }

