/// [Default UVS table](https://docs.microsoft.com/en-us/typography/opentype/spec/cmap#default-uvs-table)
pub struct DefaultUvs<'a> { _fontData: FontData<'a>, _fieldRanges: [ByteRange; 2], }
impl<'a> Copy for DefaultUvs<'a> {}
impl<'a> DefaultUvs<'a> {
  pub fn minSize() -> usize { return 4 }
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let numUnicodeValueRangesValue = scalarOr<u32>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u32.toUsize(numUnicodeValueRangesValue), 4))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }
  pub fn offsetData(self: &Self) -> FontData<'a> { return self._fontData }
/// Number of Unicode character ranges.
  pub fn numUnicodeValueRanges(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[0].start) { Result<u32, ReadError>.Success { value } => value Result<u32, ReadError>.Failure { error } => 0 }
  }
  pub fn numUnicodeValueRangesByteRange(self: &Self) -> ByteRange { return self._fieldRanges[0] }
/// Array of UnicodeRange records.
  pub fn ranges(self: &Self) -> ComputedArray<'a, (), UnicodeRange<'a>> {
    return match move recordArray<UnicodeRange<'a>>(self._fontData, self._fieldRanges[1].start, self._fieldRanges[1].end) { Result<ComputedArray<'a, (), UnicodeRange<'a>>, ReadError>.Success { value } => value Result<ComputedArray<'a, (), UnicodeRange<'a>>, ReadError>.Failure { error } => ComputedArray<'a, (), UnicodeRange<'a>>.empty(()) }
  }
  pub fn rangesByteRange(self: &Self) -> ByteRange { return self._fieldRanges[1] }
}
impl<'a> FontRead<'a, ()> for DefaultUvs<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> { return DefaultUvs<'a>.read(data) }
}
impl<'a> MinByteRange<'a> for DefaultUvs<'a> {
  fn minByteRange(self: &Self) -> ByteRange { return ByteRange { start: 0, end: self._fieldRanges[1].end } }
  fn minTableBytes(self: &Self) -> &'a [u8] { return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) { Option<FontData<'a>>.Some { value } => FontData.asBytes(&value) Option<FontData<'a>>.None => b"" } }
}

