    if FontData.len(&data) < 10 { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
