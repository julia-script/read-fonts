  pub fn idDelta(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, (self.position + 4)) { Result<i16, ReadError>.Success { value } => value Result<i16, ReadError>.Failure { error } => 0 }
  }
/// See text below.
  pub fn idRangeOffset(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 6)) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
}
