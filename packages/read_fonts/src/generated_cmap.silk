  }
  pub fn entryCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[4] }
/// Array of glyph index values for character codes in the range.
  pub fn glyphIdArray(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(&self._fontData, self._fieldRanges[5].start, self._fieldRanges[5].end) { Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty() }
  }
