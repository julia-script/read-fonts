    ranges[5].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(entryCountValue), 2))
    ranges[5].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }
