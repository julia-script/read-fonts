import read { ReadError }
import silk.ownership { Copy }
import silk.equal { Equal }
import silk.format { Display, Debug, Formatter }
import silk.writer { Writer, WriterError }
pub enum Error { Malformed, MissingResource, InvalidOperation, LimitExceeded, InsufficientMemory, }
impl Equal for Error { fn equals(left: &Error, right: &Error) -> bool { return left.* == right.* } }
impl Error { pub fn fromReadError(error: ReadError) -> Self { return Error.Malformed } }
impl Display for Error {
  effect fn display(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let message = match self.* { Error.Malformed => "font data was malformed" Error.MissingResource => "a required part of the font was missing" Error.InvalidOperation => "a program in the font did something invalid" Error.LimitExceeded => "the font exceeded a processing limit" Error.InsufficientMemory => "the supplied memory was too small" }
    run Writer.writeString(message)
  }
}
impl Debug for Error {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let message = match self.* { Error.Malformed => "Malformed" Error.MissingResource => "MissingResource" Error.InvalidOperation => "InvalidOperation" Error.LimitExceeded => "LimitExceeded" Error.InsufficientMemory => "InsufficientMemory" }
    run Writer.writeString(message)
  }
}
