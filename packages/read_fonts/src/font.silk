//! sfnt and TTC containers, borrowing all table bytes from the input file.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_data { FontData }
import read { ReadError }
import array { ScalarArray }
import font_types.lib { Tag, MajorMinor }
import silk.option { Option }
import silk.result { Result }
import silk.ownership { Copy }
import silk.u16
import silk.u32
import silk.usize

pub struct TableDirectory<'a> { bytes: FontData<'a>, }
impl<'a> Copy for TableDirectory<'a> {}
impl<'a> TableDirectory<'a> {
  pub fn read(data: FontData<'a>) -> Result<TableDirectory<'a>, ReadError> {
    if FontData.len(&data) < 12 { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    return Result<Self, ReadError>.succeed(TableDirectory { bytes: data })
  }
  pub fn sfntVersion(self: &Self) -> u32 { return FontData<'a>.readAt<u32>(&self.bytes, 0) |> Result<u32, ReadError>.unwrapOr(0) }
  pub fn numTables(self: &Self) -> u16 { return FontData<'a>.readAt<u16>(&self.bytes, 4) |> Result<u16, ReadError>.unwrapOr(0) }
  pub fn searchRange(self: &Self) -> u16 { return FontData<'a>.readAt<u16>(&self.bytes, 6) |> Result<u16, ReadError>.unwrapOr(0) }
  pub fn entrySelector(self: &Self) -> u16 { return FontData<'a>.readAt<u16>(&self.bytes, 8) |> Result<u16, ReadError>.unwrapOr(0) }
  pub fn rangeShift(self: &Self) -> u16 { return FontData<'a>.readAt<u16>(&self.bytes, 10) |> Result<u16, ReadError>.unwrapOr(0) }
  pub fn offsetData(self: &Self) -> FontData<'a> { return self.bytes }
  pub fn tableRecords(self: &Self) -> TableRecords<'a> {
    // numTables is u16, so this calculation fits every supported usize.
    let end = 12 + u16.toUsize(TableDirectory.numTables(self)) * 16
    let data = FontData.slice(&self.bytes, 12, end) |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    return TableRecords { bytes: data }
  }
}
pub struct TableRecords<'a> { bytes: FontData<'a>, }
impl<'a> Copy for TableRecords<'a> {}
impl<'a> TableRecords<'a> {
  pub fn len(self: &Self) -> usize { return FontData.len(&self.bytes) / 16 }
  pub fn get(self: &Self, index: usize) -> Option<TableRecord<'a>> {
    if index >= TableRecords.len(self) { return Option<TableRecord<'a>>.None }
    return match move FontData.slice(&self.bytes, index * 16, index * 16 + 16) {
      Option<FontData<'a>>.Some { value } => Option<TableRecord<'a>>.some(TableRecord { bytes: value })
      Option<FontData<'a>>.None => Option<TableRecord<'a>>.None
    }
  }
}
pub struct TableRecord<'a> { bytes: FontData<'a>, }
impl<'a> Copy for TableRecord<'a> {}
impl<'a> TableRecord<'a> {
  pub fn tag(self: &Self) -> Tag { return FontData<'a>.readAt<Tag>(&self.bytes, 0) |> Result<Tag, ReadError>.unwrapOr(Tag.fromU32(0)) }
  pub fn checksum(self: &Self) -> u32 { return FontData<'a>.readAt<u32>(&self.bytes, 4) |> Result<u32, ReadError>.unwrapOr(0) }
  pub fn offset(self: &Self) -> u32 { return FontData<'a>.readAt<u32>(&self.bytes, 8) |> Result<u32, ReadError>.unwrapOr(0) }
  pub fn length(self: &Self) -> u32 { return FontData<'a>.readAt<u32>(&self.bytes, 12) |> Result<u32, ReadError>.unwrapOr(0) }
}

pub struct TTCHeader<'a> { bytes: FontData<'a>, }
impl<'a> Copy for TTCHeader<'a> {}
impl<'a> TTCHeader<'a> {
  pub fn read(data: FontData<'a>) -> Result<TTCHeader<'a>, ReadError> {
    if FontData.len(&data) < 12 { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    return Result<Self, ReadError>.succeed(TTCHeader { bytes: data })
  }
  pub fn ttcTag(self: &Self) -> Tag { return FontData<'a>.readAt<Tag>(&self.bytes, 0) |> Result<Tag, ReadError>.unwrapOr(Tag.fromU32(0)) }
  pub fn version(self: &Self) -> MajorMinor { return FontData<'a>.readAt<MajorMinor>(&self.bytes, 4) |> Result<MajorMinor, ReadError>.unwrapOr(MajorMinor.new(0, 0)) }
  pub fn numFonts(self: &Self) -> u32 { return FontData<'a>.readAt<u32>(&self.bytes, 8) |> Result<u32, ReadError>.unwrapOr(0) }
  pub fn tableDirectoryOffsets(self: &Self) -> ScalarArray<'a, u32> {
    let end = usize.saturatingAdd(12, usize.saturatingMultiply(u32.toUsize(TTCHeader.numFonts(self)), 4))
    return FontData<'a>.readArray<u32>(&self.bytes, 12, end) |> Result<ScalarArray<'a, u32>, ReadError>.unwrapOr(ScalarArray<u32>.empty())
  }
  fn dsig(self: &Self, field: usize) -> Option<u32> {
    if TTCHeader.version(self).major != 2 { return Option<u32>.None }
    let start = usize.saturatingAdd(12, usize.saturatingMultiply(u32.toUsize(TTCHeader.numFonts(self)), 4))
    return match move FontData<'a>.readAt<u32>(&self.bytes, usize.saturatingAdd(start, field)) {
      Result<u32, ReadError>.Success { value } => Option<u32>.some(value)
      Result<u32, ReadError>.Failure { error } => Option<u32>.None
    }
  }
  pub fn dsigTag(self: &Self) -> Option<u32> { return TTCHeader.dsig(self, 0) }
  pub fn dsigLength(self: &Self) -> Option<u32> { return TTCHeader.dsig(self, 4) }
  pub fn dsigOffset(self: &Self) -> Option<u32> { return TTCHeader.dsig(self, 8) }
}

pub struct FontRef<'a> { bytes: FontData<'a>, directory: TableDirectory<'a>, collectionIndex: u32, inTtc: bool, sorted: bool, }
impl<'a> Copy for FontRef<'a> {}
impl<'a> FontRef<'a> {
  pub fn new(data: &'a [u8]) -> Result<FontRef<'a>, ReadError> { return FontRef.at(FontData.new(data), 0, Option<u32>.None) }
  fn at(data: FontData<'a>, offset: usize, index: Option<u32>) -> Result<FontRef<'a>, ReadError> {
    let tail = match move FontData.splitOff(&data, offset) {
      Option<FontData<'a>>.Some { value } => value
      Option<FontData<'a>>.None => { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    }
    let directory = match move TableDirectory.read(tail) {
      Result<TableDirectory<'a>, ReadError>.Success { value } => value
      Result<TableDirectory<'a>, ReadError>.Failure { error } => { return Result<Self, ReadError>.failResult(error) }
    }
    let version = TableDirectory.sfntVersion(&directory)
    if version != 65536 && version != 1330926671 && version != 1953658213 {
      return Result<Self, ReadError>.failResult(ReadError.InvalidSfnt { value: version })
    }
    let records = TableDirectory.tableRecords(&directory)
    let mut sorted = true
    let mut last: u32 = 0
    let mut i: usize = 0
    while i < TableRecords.len(&records) {
      if let Option<TableRecord<'a>>.Some { value } = move TableRecords.get(&records, i) {
        let tag = TableRecord.tag(&value)
        let raw = Tag.toU32(tag)
        if raw <= last { sorted = false }
        last = raw
      }
      i = i + 1
    }
    let mut collectionIndex: u32 = 0
    let mut inTtc = false
    if let Option<u32>.Some { value } = move index { collectionIndex = value inTtc = true }
    return Result<Self, ReadError>.succeed(FontRef { bytes: data, directory: directory, collectionIndex: collectionIndex, inTtc: inTtc, sorted: sorted })
  }
  pub fn fromIndex(data: &'a [u8], index: u32) -> Result<FontRef<'a>, ReadError> {
    return match move FileRef.new(data) {
      Result<FileRef<'a>, ReadError>.Success { value } => FileRef.get(&value, index)
      Result<FileRef<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(error)
    }
  }
  pub fn data(self: &Self) -> FontData<'a> { return self.bytes }
  pub fn tableDirectory(self: &Self) -> &TableDirectory<'a> { return &self.directory }
  pub fn ttcIndex(self: &Self) -> Option<u32> { if self.inTtc { return Option<u32>.some(self.collectionIndex) } return Option<u32>.None }
  pub fn tableData(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    let records = TableDirectory.tableRecords(&self.directory)
    let mut start: usize = 0
    let mut end = TableRecords.len(&records)
    while start < end {
      let mut index = start
      if self.sorted { index = start + (end - start) / 2 }
      if let Option<TableRecord<'a>>.Some { value } = move TableRecords.get(&records, index) {
        let current = TableRecord.tag(&value)
        if &current == &tag {
          let offset = u32.toUsize(TableRecord.offset(&value))
          if offset == 0 { return Option<FontData<'a>>.None }
          let stop = match move usize.checkedAdd(offset, u32.toUsize(TableRecord.length(&value))) {
            Option<usize>.Some { value: stop } => stop
            Option<usize>.None => { return Option<FontData<'a>>.None }
          }
          return FontData.slice(&self.bytes, offset, stop)
        }
        if self.sorted && &current > &tag { end = index } else { start = index + 1 }
      } else { return Option<FontData<'a>>.None }
    }
    return Option<FontData<'a>>.None
  }
}

pub struct CollectionRef<'a> { bytes: FontData<'a>, offsets: ScalarArray<'a, u32>, }
impl<'a> Copy for CollectionRef<'a> {}
impl<'a> CollectionRef<'a> {
  pub fn new(bytes: &'a [u8]) -> Result<CollectionRef<'a>, ReadError> {
    let data = FontData.new(bytes)
    let header = match move TTCHeader.read(data) {
      Result<TTCHeader<'a>, ReadError>.Success { value } => value
      Result<TTCHeader<'a>, ReadError>.Failure { error } => { return Result<Self, ReadError>.failResult(error) }
    }
    let tag = TTCHeader.ttcTag(&header)
    if Tag.toU32(tag) != 1953784678 { return Result<Self, ReadError>.failResult(ReadError.InvalidTtc { tag: tag }) }
    let mut start: usize = 12
    let mut count = TTCHeader.numFonts(&header)
    let version = TTCHeader.version(&header)
    if (version.major == 1 || version.major == 2) && version.minor >= 1 {
      let end = usize.saturatingAdd(12, usize.saturatingMultiply(u32.toUsize(count), 4))
      let mut countPos = end
      if version.major == 2 { countPos = usize.saturatingAdd(end, 12) }
      count = match move FontData<'a>.readAt<u32>(&data, countPos) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => { return Result<Self, ReadError>.failResult(error) }
      }
      start = usize.saturatingAdd(countPos, 4)
    }
    // Saturated ranges cannot fit a real slice, so they produce OutOfBounds.
    let end = usize.saturatingAdd(start, usize.saturatingMultiply(u32.toUsize(count), 4))
    let offsets = match move FontData<'a>.readArray<u32>(&data, start, end) {
      Result<ScalarArray<'a, u32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u32>, ReadError>.Failure { error } => { return Result<Self, ReadError>.failResult(error) }
    }
    return Result<Self, ReadError>.succeed(CollectionRef { bytes: data, offsets: offsets })
  }
  pub fn len(self: &Self) -> u32 { return usize.toU32(ScalarArray<u32>.len(&self.offsets)) }
  pub fn isEmpty(self: &Self) -> bool { return CollectionRef.len(self) == 0 }
  pub fn get(self: &Self, index: u32) -> Result<FontRef<'a>, ReadError> {
    return match move ScalarArray<u32>.get(&self.offsets, u32.toUsize(index)) {
      Option<u32>.Some { value } => FontRef.at(self.bytes, u32.toUsize(value), Option<u32>.some(index))
      Option<u32>.None => Result<FontRef<'a>, ReadError>.failResult(ReadError.InvalidCollectionIndex { index: index })
    }
  }
}

pub union FileRef<'a> { Font { pub font: FontRef<'a> }, Collection { pub collection: CollectionRef<'a> }, }
impl<'a> Copy for FileRef<'a> {}
impl<'a> FileRef<'a> {
  pub fn new(data: &'a [u8]) -> Result<FileRef<'a>, ReadError> {
    if let Result<CollectionRef<'a>, ReadError>.Success { value } = move CollectionRef.new(data) {
      return Result<Self, ReadError>.succeed(FileRef.Collection { collection: value })
    }
    return match move FontRef.new(data) {
      Result<FontRef<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(FileRef.Font { font: value })
      Result<FontRef<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(error)
    }
  }
  pub fn len(self: &Self) -> u32 {
    return match self.* { FileRef.Font { font } => 1 FileRef.Collection { collection } => CollectionRef.len(&collection) }
  }
  pub fn get(self: &Self, index: u32) -> Result<FontRef<'a>, ReadError> {
    return match self.* {
      FileRef.Collection { collection } => CollectionRef.get(&collection, index)
      FileRef.Font { font } => {
        if index != 0 { return Result<FontRef<'a>, ReadError>.failResult(ReadError.InvalidCollectionIndex { index: index }) }
        return Result<FontRef<'a>, ReadError>.succeed(font)
      }
    }
  }
}

pub struct FontIter<'a> { file: Option<FileRef<'a>>, index: u32, count: u32, }
impl<'a> FontIter<'a> {
  pub fn next(self: &mut Self) -> Option<Result<FontRef<'a>, ReadError>> {
    if self.index >= self.count { return Option<Result<FontRef<'a>, ReadError>>.None }
    let index = self.index
    self.index = self.index + 1
    return match &self.file {
      Option<FileRef<'a>>.Some { value } => Option<Result<FontRef<'a>, ReadError>>.some(FileRef<'a>.get(&value, index))
      Option<FileRef<'a>>.None => Option<Result<FontRef<'a>, ReadError>>.None
    }
  }
}
impl<'a> FileRef<'a> {
  pub fn fonts(self: &Self) -> FontIter<'a> { return FontIter { file: Option<FileRef<'a>>.some(self.*), index: 0, count: FileRef.len(self) } }
}
impl<'a> FontRef<'a> {
  pub fn fonts(data: &'a [u8]) -> FontIter<'a> {
    return match move FileRef<'a>.new(data) {
      Result<FileRef<'a>, ReadError>.Success { value } => FileRef.fonts(&value)
      Result<FileRef<'a>, ReadError>.Failure { error } => FontIter { file: Option<FileRef<'a>>.None, index: 0, count: 0 }
    }
  }
}
impl<'a> CollectionRef<'a> {
  pub fn iter(self: &Self) -> FontIter<'a> {
    let file = FileRef<'a>.Collection { collection: self.* }
    return FileRef.fonts(&file)
  }
}

import read { FontRead, FontReadAt, ComputeSize }
import font_types.lib { FixedSize }
impl<'a> FontRead<'a, ()> for TableDirectory<'a> { fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> { return TableDirectory<'a>.read(data) } }
impl<'a> FontRead<'a, ()> for TTCHeader<'a> { fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> { return TTCHeader<'a>.read(data) } }
impl<'a> FixedSize for TableRecord<'a> { fn rawByteLen() -> usize { return 16 } }
impl<'a> ComputeSize<()> for TableRecord<'a> { fn computeSize(args: ()) -> Result<usize, ReadError> { return Result<usize, ReadError>.succeed(16) } }
impl<'a> FontReadAt<'a, ()> for TableRecord<'a> {
  fn readAt(data: FontData<'a>, offset: usize, args: ()) -> Result<Self, ReadError> {
    if offset > FontData.len(&data) || 16 > FontData.len(&data) - offset { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    return match move FontData.slice(&data, offset, offset + 16) {
      Option<FontData<'a>>.Some { value } => Result<Self, ReadError>.succeed(Self { bytes: value })
      Option<FontData<'a>>.None => Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}
impl<'a> TTCHeader<'a> { pub fn offsetData(self: &Self) -> FontData<'a> { return self.bytes } }

import table_provider { readTable }
import tables.head { Head }
import tables.maxp { Maxp, MaxpExtended, SelectedMaxp }
import tables.cmap { Cmap, Dmap }
import tables.hhea { Hhea, HheaExtended, SelectedHhea }
import tables.hmtx { Hmtx, HmtxExtended, GlyphMetricRecords }
import tables.name { Name }
import tables.os2 { Os2 }
import tables.post { Post }
impl<'a> FontRef<'a> {
  pub fn expectDataForTag(self: &Self, tag: Tag) -> Result<FontData<'a>, ReadError> {
    return match move FontRef<'a>.tableData(self, tag) { Option<FontData<'a>>.Some { value } => Result<FontData<'a>, ReadError>.succeed(value) Option<FontData<'a>>.None => Result<FontData<'a>, ReadError>.failResult(ReadError.TableIsMissing { tag: tag }) }
  }
  pub fn head(self: &Self) -> Result<Head<'a>, ReadError> { return readTable<Head<'a>, FontRef<'a>>(self, Head.tag()) }
  pub fn maxp(self: &Self) -> Result<Maxp<'a>, ReadError> { return readTable<Maxp<'a>, FontRef<'a>>(self, Maxp.tag()) }
  pub fn maxpExtended(self: &Self) -> Result<MaxpExtended<'a>, ReadError> { return readTable<MaxpExtended<'a>, FontRef<'a>>(self, MaxpExtended.tag()) }
  pub fn cmap(self: &Self) -> Result<Cmap<'a>, ReadError> { return readTable<Cmap<'a>, FontRef<'a>>(self, Cmap.tag()) }
  pub fn dmap(self: &Self) -> Result<Dmap<'a>, ReadError> { return readTable<Dmap<'a>, FontRef<'a>>(self, Dmap.tag()) }
  pub fn hhea(self: &Self) -> Result<Hhea<'a>, ReadError> { return readTable<Hhea<'a>, FontRef<'a>>(self, Hhea.tag()) }
  pub fn hheaExtended(self: &Self) -> Result<HheaExtended<'a>, ReadError> { return readTable<HheaExtended<'a>, FontRef<'a>>(self, HheaExtended.tag()) }
  pub fn name(self: &Self) -> Result<Name<'a>, ReadError> { return readTable<Name<'a>, FontRef<'a>>(self, Name.tag()) }
  pub fn os2(self: &Self) -> Result<Os2<'a>, ReadError> { return readTable<Os2<'a>, FontRef<'a>>(self, Os2.tag()) }
  pub fn post(self: &Self) -> Result<Post<'a>, ReadError> { return readTable<Post<'a>, FontRef<'a>>(self, Post.tag()) }
  pub fn hmtx(self: &Self) -> Result<Hmtx<'a>, ReadError> {
    let header = match move FontRef<'a>.hhea(self) { Result<Hhea<'a>, ReadError>.Success { value } => value Result<Hhea<'a>, ReadError>.Failure { error } => { return Result<Hmtx<'a>, ReadError>.failResult(error) } }
    let data = match move FontRef<'a>.expectDataForTag(self, Hmtx.tag()) { Result<FontData<'a>, ReadError>.Success { value } => value Result<FontData<'a>, ReadError>.Failure { error } => { return Result<Hmtx<'a>, ReadError>.failResult(error) } }
    return Hmtx<'a>.read(data, Hhea<'a>.numberOfHMetrics(&header))
  }
  pub fn hmtxExtended(self: &Self) -> Result<HmtxExtended<'a>, ReadError> {
    let data = match move FontRef<'a>.expectDataForTag(self, HmtxExtended.tag()) { Result<FontData<'a>, ReadError>.Success { value } => value Result<FontData<'a>, ReadError>.Failure { error } => { return Result<HmtxExtended<'a>, ReadError>.failResult(error) } }
    let header = match move FontRef<'a>.hheaExtended(self) { Result<HheaExtended<'a>, ReadError>.Success { value } => value Result<HheaExtended<'a>, ReadError>.Failure { error } => { return Result<HmtxExtended<'a>, ReadError>.failResult(error) } }
    return HmtxExtended<'a>.read(data, HheaExtended<'a>.numberOfHMetrics(&header))
  }
}

impl<'a> FontRef<'a> {
  pub fn selectedMaxp(self: &Self) -> Result<SelectedMaxp<'a>, ReadError> {
    match move FontRef<'a>.maxpExtended(self) {
      Result<MaxpExtended<'a>, ReadError>.Success { value } => { return Result<SelectedMaxp<'a>, ReadError>.succeed(SelectedMaxp<'a>.Extended { table: value }) }
      Result<MaxpExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, MaxpExtended.tag()) { return Result<SelectedMaxp<'a>, ReadError>.failResult(error) } }
    }
    return match move FontRef<'a>.maxp(self) { Result<Maxp<'a>, ReadError>.Success { value } => Result<SelectedMaxp<'a>, ReadError>.succeed(SelectedMaxp<'a>.Original { table: value }) Result<Maxp<'a>, ReadError>.Failure { error } => Result<SelectedMaxp<'a>, ReadError>.failResult(error) }
  }
  pub fn selectedHhea(self: &Self) -> Result<SelectedHhea<'a>, ReadError> {
    match move FontRef<'a>.hheaExtended(self) {
      Result<HheaExtended<'a>, ReadError>.Success { value } => { return Result<SelectedHhea<'a>, ReadError>.succeed(SelectedHhea<'a>.Extended { table: value }) }
      Result<HheaExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, HheaExtended.tag()) { return Result<SelectedHhea<'a>, ReadError>.failResult(error) } }
    }
    return match move FontRef<'a>.hhea(self) { Result<Hhea<'a>, ReadError>.Success { value } => Result<SelectedHhea<'a>, ReadError>.succeed(SelectedHhea<'a>.Original { table: value }) Result<Hhea<'a>, ReadError>.Failure { error } => Result<SelectedHhea<'a>, ReadError>.failResult(error) }
  }
  pub fn hGlyphMetricRecords(self: &Self) -> Result<GlyphMetricRecords<'a>, ReadError> {
    match move FontRef<'a>.hmtxExtended(self) {
      Result<HmtxExtended<'a>, ReadError>.Success { value } => { return Result<GlyphMetricRecords<'a>, ReadError>.succeed(GlyphMetricRecords<'a>.fromHmtxExtended(value)) }
      Result<HmtxExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, HmtxExtended.tag()) { return Result<GlyphMetricRecords<'a>, ReadError>.failResult(error) } }
    }
    return match move FontRef<'a>.hmtx(self) { Result<Hmtx<'a>, ReadError>.Success { value } => Result<GlyphMetricRecords<'a>, ReadError>.succeed(GlyphMetricRecords<'a>.fromHmtx(value)) Result<Hmtx<'a>, ReadError>.Failure { error } => Result<GlyphMetricRecords<'a>, ReadError>.failResult(error) }
  }
}
fn isMissingTable(error: ReadError, expected: Tag) -> bool { return match error { ReadError.TableIsMissing { tag } => &tag == &expected _ => false } }
