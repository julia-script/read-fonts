effect fn must<T>(result: Result<T, ReadError>) -> T ! AssertionError<'static> { return match move result { Result<T, ReadError>.Success { value } => move value Result<T, ReadError>.Failure { error } => { run Testing.expect(false, "upstream fixture parses") return Intrinsic.trap("test assertion") } } }
effect fn glyphs(array: ScalarArray<GlyphId16>, expected: &[u16]) -> () ! AssertionError<'static> {
  run Testing.expect(ScalarArray<GlyphId16>.len(&array) == expected.length, "glyph array length")
  let mut i: usize = 0
  while i < expected.length { let value = ScalarArray<GlyphId16>.get(&array, i) |> Option<GlyphId16>.unwrapOr(GlyphId16.new(0)) run Testing.expect(GlyphId16.toU16(value) == expected[i], "glyph array entry") i = i + 1 }
}
test effect fn gdefHeader() -> () ! AssertionError<'static> {
  let table = run must(Gdef.read(FontData.new(generated_layout_fixtures.gdefGdefHeader())))
  let version = Gdef.version(&table)
  run Testing.expect(version.major == 1 && version.minor == 0, "GDEF version")
  run Testing.expect(Offset16.toU32(Nullable<Offset16>.offset(&Gdef.markAttachClassDefOffset(&table)).*) == 90, "mark attachment offset")
}
test effect fn glyphClassDefTable() -> () ! AssertionError<'static> {
  let table = run must(ClassDefFormat2.read(FontData.new(generated_layout_fixtures.gdefGlyphclassdefTable())))
  run Testing.expect(ClassDefFormat2.classRangeCount(&table) == 4, "range count")
  let record = run must(ComputedArray<'static, (), ClassRangeRecord<'static>>.get(&ClassDefFormat2.classRangeRecords(&table), 3))
  run Testing.expect(GlyphId16.toU16(ClassRangeRecord.startGlyphId(&record)) == 399 && GlyphId16.toU16(ClassRangeRecord.endGlyphId(&record)) == 399, "last class range")
}
test effect fn attachListTable() -> () ! AssertionError<'static> {
  let table = run must(AttachList.read(FontData.new(generated_layout_fixtures.gdefAttachlistTable())))
  run Testing.expect(AttachList.glyphCount(&table) == 2 && ScalarArray<Offset16>.len(&AttachList.attachPointOffsets(&table)) == 2, "attachment count")
  let point = run must(ArrayOfOffsets<'static, (), AttachPoint<'static>, Offset16>.get(&AttachList.attachPoints(&table), 1))
  let indices = AttachPoint.pointIndices(&point)
  run Testing.expect((ScalarArray<u16>.get(&indices, 0) |> Option<u16>.unwrapOr(0)) == 14 && (ScalarArray<u16>.get(&indices, 1) |> Option<u16>.unwrapOr(0)) == 23, "point indices")
}
test effect fn ligCaretList() -> () ! AssertionError<'static> {
  let table = run must(LigCaretList.read(FontData.new(generated_layout_fixtures.gdefLigcaretlistTable())))
  let entries = LigCaretList.ligGlyphs(&table)
  let first = run must(ArrayOfOffsets<'static, (), LigGlyph<'static>, Offset16>.get(&entries, 0))
  let second = run must(ArrayOfOffsets<'static, (), LigGlyph<'static>, Offset16>.get(&entries, 1))
  run Testing.expect(ScalarArray<Offset16>.len(&LigGlyph.caretValueOffsets(&first)) == 1 && ScalarArray<Offset16>.len(&LigGlyph.caretValueOffsets(&second)) == 2, "caret counts")
  let a = ScalarArray<Offset16>.get(&LigGlyph.caretValueOffsets(&first), 0) |> Option<Offset16>.unwrapOr(Offset16.new(0))
  let b = ScalarArray<Offset16>.get(&LigGlyph.caretValueOffsets(&second), 1) |> Option<Offset16>.unwrapOr(Offset16.new(0))
  let ca = run must(resolve<CaretValueFormat1<'static>, Offset16>(a, LigGlyph.offsetData(&first)))
  let cb = run must(resolve<CaretValueFormat1<'static>, Offset16>(b, LigGlyph.offsetData(&second)))
  run Testing.expect(CaretValueFormat1.coordinate(&ca) == 603 && CaretValueFormat1.coordinate(&cb) == 1206, "caret coordinates")
}
test effect fn caretvalueformat3() -> () ! AssertionError<'static> {
  let table = run must(CaretValueFormat3.read(FontData.new(generated_layout_fixtures.gdefCaretvalueformat3Table())))
  run Testing.expect(CaretValueFormat3.coordinate(&table) == 1206, "coordinate")
  let target = run must(CaretValueFormat3.device(&table))
  match target { DeviceOrVariationIndex.Device { value } => {
    run Testing.expect(Device.startSize(&value) == 12 && Device.endSize(&value) == 17 && Device.deltaFormat(&value) == DeltaFormat.Local4BitDeltas, "device header")
    let deltas = Device.deltaValue(&value)
    run Testing.expect(ScalarArray<u16>.len(&deltas) == 2 && (ScalarArray<u16>.get(&deltas, 0) |> Option<u16>.unwrapOr(0)) == 4369 && (ScalarArray<u16>.get(&deltas, 1) |> Option<u16>.unwrapOr(0)) == 8704, "packed device deltas")
  } _ => run Testing.expect(false, "device variant") }
}
test effect fn singlesubstformat1() -> () ! AssertionError<'static> {
  let table = run must(SingleSubstFormat1.read(FontData.new(generated_layout_fixtures.gsubSinglesubstformat1Table())))
  run Testing.expect(SingleSubstFormat1.deltaGlyphId(&table) == 192, "substitution delta")
}
test effect fn singlesubstformat2() -> () ! AssertionError<'static> {
  let table = run must(SingleSubstFormat2.read(FontData.new(generated_layout_fixtures.gsubSinglesubstformat2Table())))
  run glyphs(SingleSubstFormat2.substituteGlyphIds(&table), &[305, 309, 318, 323])
}
test effect fn multiplesubstformat1() -> () ! AssertionError<'static> {
  let table = run must(MultipleSubstFormat1.read(FontData.new(generated_layout_fixtures.gsubMultiplesubstformat1Table())))
  let entries = MultipleSubstFormat1.sequences(&table)
  run Testing.expect(ArrayOfOffsets<'static, (), Sequence<'static>, Offset16>.len(&entries) == 1, "sequence count")
  let seq = run must(ArrayOfOffsets<'static, (), Sequence<'static>, Offset16>.get(&entries, 0))
  run glyphs(Sequence.substituteGlyphIds(&seq), &[26, 26, 29])
}
test effect fn alternatesubstformat1() -> () ! AssertionError<'static> {
  let table = run must(AlternateSubstFormat1.read(FontData.new(generated_layout_fixtures.gsubAlternatesubstformat1Table())))
  let entries = AlternateSubstFormat1.alternateSets(&table)
  run Testing.expect(ArrayOfOffsets<'static, (), AlternateSet<'static>, Offset16>.len(&entries) == 1, "alternate set count")
  let set = run must(ArrayOfOffsets<'static, (), AlternateSet<'static>, Offset16>.get(&entries, 0))
  run glyphs(AlternateSet.alternateGlyphIds(&set), &[201, 202])
}
test effect fn ligaturesubstformat1() -> () ! AssertionError<'static> {
  let table = run must(LigatureSubstFormat1.read(FontData.new(generated_layout_fixtures.gsubLigaturesubstformat1Table())))
  let entries = LigatureSubstFormat1.ligatureSets(&table)
  run Testing.expect(ArrayOfOffsets<'static, (), LigatureSet<'static>, Offset16>.len(&entries) == 2, "ligature set count")
  let first = run must(ArrayOfOffsets<'static, (), LigatureSet<'static>, Offset16>.get(&entries, 0))
  let second = run must(ArrayOfOffsets<'static, (), LigatureSet<'static>, Offset16>.get(&entries, 1))
  let ligs = LigatureSet.ligatures(&first)
  run Testing.expect(ArrayOfOffsets<'static, (), Ligature<'static>, Offset16>.len(&ligs) == 1, "first ligature count")
  let a = run must(ArrayOfOffsets<'static, (), Ligature<'static>, Offset16>.get(&ligs, 0))
  let b = run must(ArrayOfOffsets<'static, (), Ligature<'static>, Offset16>.get(&LigatureSet.ligatures(&second), 0))
  run Testing.expect(GlyphId16.toU16(Ligature.ligatureGlyph(&a)) == 347 && GlyphId16.toU16(Ligature.ligatureGlyph(&b)) == 241, "ligature glyphs")
  run glyphs(Ligature.componentGlyphIds(&a), &[40, 23])
  run glyphs(Ligature.componentGlyphIds(&b), &[26, 29])
}
test effect fn sanityCheckFormatConst() -> () ! AssertionError<'static> {
  let format = ValueFormat.xAdvanceDevice() | ValueFormat.yAdvanceDevice() | ValueFormat.yPlacementDevice() | ValueFormat.xPlacementDevice()
  run Testing.expect(&format == &ValueFormat.anyDeviceOrVaridx() && ValueFormat.recordByteLen(format) == 8, "device mask")
}
fn placement(record: &ValueRecord, index: usize) -> Option<i16> { return match index { 0 => ValueRecord.xPlacement(record) 1 => ValueRecord.yPlacement(record) 2 => ValueRecord.xAdvance(record) _ => ValueRecord.yAdvance(record) } }
test effect fn fieldOffsetsMatchSequentialLayout() -> () ! AssertionError<'static> {
  let data = FontData.new(b"\x00\x00\x00\x00\x00\x00\x11\x00\x11\x01\x11\x02\x11\x03\x11\x04\x11\x05\x11\x06\x11\x07")
  let mut bits: u16 = 0
  while bits < 256 {
    let format = ValueFormat.fromBitsTruncate(bits)
    let record = ValueRecord.new(data, 6, format)
    run Testing.expect(&ValueRecord.format(&record) == &format && ValueRecord.byteLen(&record) == ValueFormat.recordByteLen(format), "format and size")
    let mut field: usize = 0
    let mut flag: u16 = 1
    let mut position: u16 = 0
    while field < 8 {
      let mut got: Option<u16> = Option<u16>.None
      if field < 4 { if let Option<i16>.Some { value } = move placement(&record, field) { got = Option<u16>.some(i16.toU16(value)) } }
      else { if let Option<Nullable<Offset16>>.Some { value } = move ValueRecord.deviceOffset(&record, ValueFormat.fromBitsTruncate(flag)) { got = Option<u16>.some(u32.toU16(Offset16.toU32(Nullable<Offset16>.offset(&value).*))) } }
      if (bits & flag) != 0 {
        run Testing.expect((move got |> Option<u16>.unwrapOr(0)) == 4352 + position, "present field has sequential position")
        position = position + 1
      } else { run Testing.expect(match move got { Option<u16>.None => true _ => false }, "absent field stays absent") }
      field = field + 1
      flag = flag * 2
    }
    run Testing.expect(u16.toUsize(position) * 2 == ValueRecord.byteLen(&record), "sequential byte length")
    bits = bits + 1
  }
}
test effect fn lazyFieldsOutOfBounds() -> () ! AssertionError<'static> {
  let format = ValueFormat.xPlacement() | ValueFormat.yAdvance()
  let lazy = ValueRecord.new(FontData.new(b"\x00\x01\x00\x02"), 2, format)
  run Testing.expect((ValueRecord.xPlacement(&lazy) |> Option<i16>.unwrapOr(0)) == 2, "present first field")
  run Testing.expect(match move ValueRecord.yAdvance(&lazy) { Option<i16>.None => true _ => false }, "missing second field")
  let huge = ValueRecord.new(FontData.new(b"\x00\x01\x00\x02"), usize.MAX, format)
  run Testing.expect(match move ValueRecord.xPlacement(&huge) { Option<i16>.None => true _ => false }, "unrepresentable position")
}
import silk.i16
import silk.u32

import generated_layout { CoverageTable, CoverageFormat1, CoverageFormat2, CoverageIter, ClassDef, ClassIter, ClassEntry, ScriptList, ScriptRecord, Script, LangSys, LangSysRecord, FeatureList, FeatureRecord, Feature, HeaderOffset, SelectedLookupList, DeviceIter, SequenceContextFormat1, SequenceContextFormat2, SequenceContextFormat3, SequenceLookupRecord }
import generated_gsub { Gsub, SubstitutionLookup }
import font_types.lib { GlyphId, Offset32, Tag }

effect fn some<T>(option: Option<T>) -> T ! AssertionError<'static> { return match move option { Option<T>.Some { value } => move value Option<T>.None => { run Testing.expect(false, "expected present value") return Intrinsic.trap("test assertion") } } }
fn coverageCount(table: &CoverageTable) -> usize { let mut iter = CoverageTable.iter(table) let mut count: usize = 0 while let Option<GlyphId>.Some { value } = move CoverageIter.next(&mut iter) { count = count + 1 } return count }
fn classCount(table: &ClassDef) -> usize { let mut iter = ClassDef.iter(table) let mut count: usize = 0 while let Option<ClassEntry>.Some { value } = move ClassIter.next(&mut iter) { count = count + 1 } return count }
fn n16(value: u16) -> Nullable<Offset16> { return Nullable<Offset16>.new(Offset16.new(value)) }
fn n32(value: u32) -> Option<Nullable<Offset32>> { return Option<Nullable<Offset32>>.some(Nullable<Offset32>.new(Offset32.new(value))) }
test effect fn headerOffsetPrefersNonzeroExtendedOffset() -> () ! AssertionError<'static> { let selected = run must(HeaderOffset.select(n16(10), n32(70000), true)) run Testing.expect(selected.extended && Offset32.toU32(selected.offset) == 70000, "extended offset selected") }
test effect fn headerOffsetFallsBackToOriginalOffset() -> () ! AssertionError<'static> {
  let zero = run must(HeaderOffset.select(n16(10), n32(0), true))
  let version = run must(HeaderOffset.select(n16(10), n32(70000), false))
  let null = run must(HeaderOffset.select(n16(0), n32(0), true))
  run Testing.expect(!zero.extended && !version.extended && Offset32.toU32(zero.offset) == 10 && Offset32.toU32(version.offset) == 10 && HeaderOffset.isNull(&null), "original and null offsets")
}
test effect fn headerOffsetRequiresExtendedFieldInExtendedHeader() -> () ! AssertionError<'static> {
  let error = HeaderOffset.select(n16(10), Option<Nullable<Offset32>>.None, true)
  run Testing.expect(match move error { Result<HeaderOffset, ReadError>.Failure { error: ReadError.OutOfBounds } => true _ => false }, "extended field required")
  let original = run must(HeaderOffset.select(n16(10), Option<Nullable<Offset32>>.None, false))
  run Testing.expect(!original.extended && Offset32.toU32(original.offset) == 10, "older version ignores absent extension")
}
test effect fn majorVersion2ReadsOriginalLists() -> () ! AssertionError<'static> {
  let table = run must(Gsub.read(FontData.new(b"\x00\x02\x00\x00\x00\x0a\x00\x0c\x00\x0e\x00\x00\x00\x00\x00\x00")))
  let scripts = run must(Gsub.scriptList(&table)) let features = run must(Gsub.featureList(&table)) let lookups = run must(Gsub.lookupList(&table))
  run Testing.expect(ScriptList.scriptCount(&scripts) == 0 && FeatureList.featureCount(&features) == 0 && SelectedLookupList<'static, SubstitutionLookup<'static>>.lookupCount(&lookups) == 0, "major version 2 keeps original offsets")
}
test effect fn example1Scripts() -> () ! AssertionError<'static> {
  let table = run must(ScriptList.read(FontData.new(generated_layout_fixtures.layoutScripts())))
  run Testing.expect(ScriptList.scriptCount(&table) == 3, "script count")
  let records = ScriptList.scriptRecords(&table)
  let expected: [u32; 3] = [1751215721, 1801547361, 1818326126]
  let mut i: usize = 0
  while i < 3 { let record = run must(ComputedArray<'static, (), ScriptRecord<'static>>.get(&records, i)) run Testing.expect(Tag.toU32(ScriptRecord.scriptTag(&record)) == expected[i], "script tag") i = i + 1 }
}
test effect fn example2ScriptsAndLangs() -> () ! AssertionError<'static> {
  let table = run must(Script.read(FontData.new(generated_layout_fixtures.layoutScriptsAndLanguages())))
  let defaultResult = run some(Script.defaultLangSys(&table)) let defaultSys = run must(move defaultResult)
  run Testing.expect(LangSys.requiredFeatureIndex(&defaultSys) == 65535 && LangSys.featureIndexCount(&defaultSys) == 3 && Script.langSysCount(&table) == 1, "default language system")
  let record = run must(ComputedArray<'static, (), LangSysRecord<'static>>.get(&Script.langSysRecords(&table), 0))
  run Testing.expect(Tag.toU32(LangSysRecord.langSysTag(&record)) == 1431454752, "Urdu tag")
  let urdu = run must(LangSysRecord.langSys(&record, Script.offsetData(&table)))
  run Testing.expect(LangSys.requiredFeatureIndex(&urdu) == 3 && LangSys.featureIndexCount(&urdu) == 3, "Urdu system")
}
test effect fn example3FeaturelistAndFeature() -> () ! AssertionError<'static> {
  let table = run must(FeatureList.read(FontData.new(generated_layout_fixtures.layoutFeaturelistAndFeature())))
  run Testing.expect(FeatureList.featureCount(&table) == 3, "feature count")
  let record = run must(ComputedArray<'static, (), FeatureRecord<'static>>.get(&FeatureList.featureRecords(&table), 0))
  let feature = run must(FeatureRecord.feature(&record, FeatureList.offsetData(&table)))
  run Testing.expect(Nullable<Offset16>.isNull(&Feature.featureParamsOffset(&feature)) && ScalarArray<u16>.len(&Feature.lookupListIndices(&feature)) == 1, "feature parameters and lookups")
}
test effect fn coverage24bitGlyphsAndIndices() -> () ! AssertionError<'static> {
  let table = run must(CoverageTable.read(FontData.new(b"\x00\x03\x00\x00\x03\x00\xff\xff\x01\x00\x00\xff\xff\xff")))
  let mut iter = CoverageTable.iter(&table) let expected: [u32; 3] = [65535, 65536, 16777215] let mut i: usize = 0
  while i < 3 { let glyph = run some(CoverageIter.next(&mut iter)) run Testing.expect(GlyphId.toU32(glyph) == expected[i], "wide glyph") i = i + 1 }
  run Testing.expect((CoverageTable.get(&table, GlyphId.new(65536)) |> Option<u32>.unwrapOr(0)) == 1 && match move CoverageTable.get(&table, GlyphId.new(16777216)) { Option<u32>.None => true _ => false }, "wide lookup")
  let range = run must(CoverageTable.read(FontData.new(b"\x00\x04\x00\x00\x01\x01\x00\x00\x01\x00\x02\x01\x00\x00")))
  run Testing.expect((CoverageTable.get(&range, GlyphId.new(65538)) |> Option<u32>.unwrapOr(0)) == 65538 && CoverageTable.population(&range) == 3 && match move CoverageTable.get(&range, GlyphId.new(65539)) { Option<u32>.None => true _ => false }, "wide coverage index")
}
test effect fn classWidthsFollowTheFormat() -> () ! AssertionError<'static> {
  let a = run must(ClassDef.read(FontData.new(b"\x00\x03\x01\x00\x00\x00\x00\x02\x01\x00\x00\xff\xff\xff")))
  run Testing.expect(ClassDef.get(&a, GlyphId.new(65536)) == 65536 && ClassDef.get(&a, GlyphId.new(65537)) == 16777215 && ClassDef.get(&a, GlyphId.new(65538)) == 0, "24 bit class values")
  let b = run must(ClassDef.read(FontData.new(b"\x00\x04\x00\x00\x01\x01\x00\x00\x01\x00\x02\xff\xff")))
  run Testing.expect(ClassDef.get(&b, GlyphId.new(65538)) == 65535 && ClassDef.get(&b, GlyphId.new(65539)) == 0 && classCount(&b) == 3, "16 bit ranged class values")
}
test effect fn truncatedWideArraysDoNotMatch() -> () ! AssertionError<'static> {
  let a = run must(CoverageTable.read(FontData.new(b"\x00\x03\x00\x00\x01"))) let b = run must(CoverageTable.read(FontData.new(b"\x00\x04\x00\x00\x01")))
  run Testing.expect(match move CoverageTable.get(&a, GlyphId.new(0)) { Option<u32>.None => true _ => false }, "truncated array")
  run Testing.expect(match move CoverageTable.get(&b, GlyphId.new(0)) { Option<u32>.None => true _ => false }, "truncated ranges")
  let c = run must(ClassDef.read(FontData.new(b"\x00\x03\x01\x00\x00\x00\x00\x01"))) let d = run must(ClassDef.read(FontData.new(b"\x00\x04\x00\x00\x01")))
  run Testing.expect(ClassDef.get(&c, GlyphId.new(65536)) == 0 && ClassDef.get(&d, GlyphId.new(65536)) == 0, "truncated classes")
}
test effect fn coverageGetFormat1() -> () ! AssertionError<'static> {
  let c = run must(CoverageFormat1.read(FontData.new(b"\x00\x01\x00\x05\x00\x01\x00\x07\x00\x0d\x00\x1b\x00\x2c")))
  let gids: [u32; 5] = [1, 2, 7, 27, 45] let expected: [u16; 5] = [0, 65535, 1, 3, 65535] let mut i: usize = 0
  while i < 5 { run Testing.expect((CoverageFormat1.get(&c, GlyphId.new(gids[i])) |> Option<u16>.unwrapOr(65535)) == expected[i], "coverage index") i = i + 1 }
}
test effect fn coverageGetFormat2() -> () ! AssertionError<'static> {
  let c = run must(CoverageFormat2.read(FontData.new(b"\x00\x02\x00\x02\x00\x05\x00\x09\x00\x00\x00\x1e\x00\x27\x00\x05")))
  let gids: [u32; 7] = [2, 7, 9, 10, 32, 39, 40] let expected: [u16; 7] = [65535, 2, 4, 65535, 7, 14, 65535] let mut i: usize = 0
  while i < 7 { run Testing.expect((CoverageFormat2.get(&c, GlyphId.new(gids[i])) |> Option<u16>.unwrapOr(65535)) == expected[i], "ranged coverage index") i = i + 1 }
}
test effect fn coverageGetFormat2NoU16Overflow() -> () ! AssertionError<'static> {
  let c = run must(CoverageFormat2.read(FontData.new(b"\x00\x02\x00\x01\x9c\x40\x9c\x4a\x9c\x40")))
  let gids: [u32; 3] = [40000, 40005, 40010] let mut i: usize = 0
  while i < 3 { run Testing.expect(u16.toU32(CoverageFormat2.get(&c, GlyphId.new(gids[i])) |> Option<u16>.unwrapOr(0)) == gids[i], "large CJK range") i = i + 1 }
  run Testing.expect(match move CoverageFormat2.get(&c, GlyphId.new(40011)) { Option<u16>.None => true _ => false }, "outside range")
}
test effect fn coverageGetFormat2RejectsOverflowingCoverageIndex() -> () ! AssertionError<'static> {
  let c = run must(CoverageFormat2.read(FontData.new(b"\x00\x02\x00\x01\x00\x01\x00\x02\xff\xff")))
  run Testing.expect((CoverageFormat2.get(&c, GlyphId.new(1)) |> Option<u16>.unwrapOr(0)) == 65535 && match move CoverageFormat2.get(&c, GlyphId.new(2)) { Option<u16>.None => true _ => false }, "overflowing coverage index")
}
test effect fn classdefGetFormat2() -> () ! AssertionError<'static> {
  let table = run must(ClassDef.read(FontData.new(generated_layout_fixtures.gdefMarkattachclassdefTable())))
  let gids: [u32; 11] = [616,617,618,624,625,626,652,653,654,655,661]
  let mut i: usize = 0
  while i < 11 { let mut expected: u32 = 1 if i >= 6 { expected = 2 } run Testing.expect(ClassDef.get(&table, GlyphId.new(gids[i])) == expected, "class assignment") i = i + 1 }
  let mut iter = ClassDef.iter(&table)
  while let Option<ClassEntry>.Some { value } = move ClassIter.next(&mut iter) { run Testing.expect(ClassDef.get(&table, value.glyph) == value.class, "class iterator agrees with lookup") }
}
effect fn deviceDeltas(data: &'static [u8], expected: &[i8]) -> () ! AssertionError<'static> {
  let device = run must(Device.read(FontData.new(data))) let mut iter = Device.iter(&device) let mut i: usize = 0
  while i < expected.length { let value = run some(DeviceIter.next(&mut iter)) run Testing.expect(value == expected[i], "decoded device delta") i = i + 1 }
  run Testing.expect(match move DeviceIter.next(&mut iter) { Option<i8>.None => true _ => false }, "device iterator length")
}
test effect fn deltaDecode() -> () ! AssertionError<'static> {
  run deviceDeltas(b"\x00\x01\x00\x04\x00\x02\x12\x3f", &[1,2,3,-1])
  run deviceDeltas(b"\x00\x01\x00\x05\x00\x01\x55\x40", &[1,1,1,1,1])
}
test effect fn deltaDecodeNegativeNotInLastSlot() -> () ! AssertionError<'static> {
  run deviceDeltas(b"\x00\x01\x00\x02\x00\x03\xf4\x01", &[-12,1])
  run deviceDeltas(b"\x00\x01\x00\x04\x00\x02\x81\x23", &[-8,1,2,3])
  run deviceDeltas(b"\x00\x01\x00\x04\x00\x01\x95\x40", &[-2,1,1,1])
  run deviceDeltas(b"\x00\x01\x00\x02\x00\x03\x80\x00", &[-128,0])
}
test effect fn deltaDecodeAll() -> () ! AssertionError<'static> { run deviceDeltas(b"\x00\x07\x00\x0d\x00\x03\x01\xf4\x1e\xf5\x65\x08\x2a\x00", &[1,-12,30,-11,101,8,42]) }
test effect fn deviceDecodeDoesNotOverflow() -> () ! AssertionError<'static> { run deviceDeltas(b"\x00\x0a\x00\x01\x00\x01", &[]) }
test effect fn defaultCoverage() -> () ! AssertionError<'static> { run Testing.expect(coverageCount(&CoverageTable.default()) == 0, "empty default coverage") }
test effect fn defaultClassdef() -> () ! AssertionError<'static> { let table = ClassDef.default() run Testing.expect(ClassDef.population(&table) == 0 && classCount(&table) == 0, "empty default class definition") }
