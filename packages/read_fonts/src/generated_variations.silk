  }
  pub fn offsetData(self: &Self) -> FontData<'a> { return self._fontData }
/// The number of variation axes for this font. This must be the
/// same number as axisCount in the 'fvar' table.
  pub fn axisCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn axisCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[0] }
/// The number of variation region tables in the variation region
/// list. Must be less than 32,768.
  pub fn regionCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn regionCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[1] }
/// Array of variation regions.
  pub fn variationRegions(self: &Self) -> ComputedArray<'a, u16, VariationRegion<'a>> {
    return match move ComputedArray<'a, u16, VariationRegion<'a>>.new(self._fontData, self._fieldRanges[2].start, self._fieldRanges[2].end, VariationRegionList<'a>.axisCount(self)) { Result<ComputedArray<'a, u16, VariationRegion<'a>>, ReadError>.Success { value } => value Result<ComputedArray<'a, u16, VariationRegion<'a>>, ReadError>.Failure { error } => ComputedArray<'a, u16, VariationRegion<'a>>.empty(VariationRegionList<'a>.axisCount(self)) }
  }
  pub fn variationRegionsByteRange(self: &Self) -> ByteRange { return self._fieldRanges[2] }
}
impl<'a> FontRead<'a, ()> for VariationRegionList<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> { return VariationRegionList<'a>.read(data) }
}
impl<'a> MinByteRange<'a> for VariationRegionList<'a> {
  fn minByteRange(self: &Self) -> ByteRange { return ByteRange { start: 0, end: self._fieldRanges[2].end } }
  fn minTableBytes(self: &Self) -> &'a [u8] { return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) { Option<FontData<'a>>.Some { value } => FontData.asBytes(&value) Option<FontData<'a>>.None => b"" } }
}

/// The [VariationRegion](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#variation-regions) record
pub struct VariationRegion<'a> { _fontData: FontData<'a>, _fieldRanges: [ByteRange; 1], _axisCount: u16, }
impl<'a> Copy for VariationRegion<'a> {}
impl<'a> VariationRegion<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    let axisCountValue = args
    let mut ranges = [ByteRange { start: 0, end: 0 }; 1]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(axisCountValue), 6))
    ranges[0].end = end
    let value = Self { _fontData: data, _fieldRanges: ranges, _axisCount: axisCountValue }
    if let Result<ComputedArray<'a, (), RegionAxisCoordinates<'a>>, ReadError>.Failure { error } = move recordArray<RegionAxisCoordinates<'a>>(data, ranges[0].start, ranges[0].end) { return Result<Self, ReadError>.failResult(error) }
    return Result<Self, ReadError>.succeed(value)
  }
  pub fn default() -> Self { return VariationRegion<'a>.readAt(FontData.defaultTableData(), 0, 0) |> Result<Self, ReadError>.unwrapOr(Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 1], _axisCount: 0 }) }
/// Array of region axis coordinates records, in the order of axes
/// given in the 'fvar' table.
  pub fn regionAxes(self: &Self) -> ComputedArray<'a, (), RegionAxisCoordinates<'a>> {
    return match move recordArray<RegionAxisCoordinates<'a>>(self._fontData, self._fieldRanges[0].start, self._fieldRanges[0].end) { Result<ComputedArray<'a, (), RegionAxisCoordinates<'a>>, ReadError>.Success { value } => value Result<ComputedArray<'a, (), RegionAxisCoordinates<'a>>, ReadError>.Failure { error } => ComputedArray<'a, (), RegionAxisCoordinates<'a>>.empty(()) }
  }
}
impl<'a> ComputeSize<u16> for VariationRegion<'a> { fn computeSize(args: u16) -> Result<usize, ReadError> {
    let axisCountValue = args
    let mut end: usize = 0
    end = match move usize.checkedAdd(end, usize.saturatingMultiply(u16.toUsize(axisCountValue), 6)) { Option<usize>.Some { value } => value Option<usize>.None => { return Result<usize, ReadError>.failResult(ReadError.OutOfBounds) } }
    return Result<usize, ReadError>.succeed(end)
} }
impl<'a> FontReadAt<'a, u16> for VariationRegion<'a> { fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> { return VariationRegion<'a>.readAt(data, position, args) } }
impl<'a> FontRead<'a, u16> for VariationRegion<'a> { fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> { return VariationRegion<'a>.readAt(data, 0, args) } }
/// The [RegionAxisCoordinates](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#variation-regions) record
pub struct RegionAxisCoordinates<'a> { _fontData: FontData<'a>, position: usize, }
impl<'a> Copy for RegionAxisCoordinates<'a> {}
impl<'a> RegionAxisCoordinates<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }
  pub fn default() -> Self { return Self { _fontData: FontData.defaultTableData(), position: 0 } }
/// The region start coordinate value for the current axis.
  pub fn startCoord(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, (self.position + 0)) { Result<F2Dot14, ReadError>.Success { value } => value Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero() }
  }
/// The region peak coordinate value for the current axis.
  pub fn peakCoord(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, (self.position + 2)) { Result<F2Dot14, ReadError>.Success { value } => value Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero() }
  }
/// The region end coordinate value for the current axis.
  pub fn endCoord(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, (self.position + 4)) { Result<F2Dot14, ReadError>.Success { value } => value Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero() }
  }
}
impl<'a> FixedSize for RegionAxisCoordinates<'a> { fn rawByteLen() -> usize { return 6 } }
impl<'a> ComputeSize<()> for RegionAxisCoordinates<'a> { fn computeSize(args: ()) -> Result<usize, ReadError> { return Result<usize, ReadError>.succeed(6) } }
impl<'a> FontReadAt<'a, ()> for RegionAxisCoordinates<'a> { fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> { return RegionAxisCoordinates<'a>.readAt(data, position, ()) } }

/// The [ItemVariationStore](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#item-variation-store-header-and-item-variation-data-subtables) table
pub struct ItemVariationStore<'a> { _fontData: FontData<'a>, _fieldRanges: [ByteRange; 4], }
impl<'a> Copy for ItemVariationStore<'a> {}
impl<'a> ItemVariationStore<'a> {
  pub fn default() -> Self { return ItemVariationStore<'a>.read(FontData.defaultTableData()) |> Result<Self, ReadError>.unwrapOr(Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] }) }
  pub fn minSize() -> usize { return 8 }
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let variationRegionListOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let itemVariationDataCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(itemVariationDataCountValue), 4))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }
  pub fn offsetData(self: &Self) -> FontData<'a> { return self._fontData }
/// Format— set to 1
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn formatByteRange(self: &Self) -> ByteRange { return self._fieldRanges[0] }
/// Offset in bytes from the start of the item variation store to
/// the variation region list.
  pub fn variationRegionListOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) { Result<Offset32, ReadError>.Success { value } => value Result<Offset32, ReadError>.Failure { error } => Offset32.new(0) }
  }
  pub fn variationRegionList(self: &Self) -> Result<VariationRegionList<'a>, ReadError> {
    let offset = ItemVariationStore<'a>.variationRegionListOffset(self)
    return resolveWithArgs<(), VariationRegionList<'a>, Offset32>(offset, self._fontData, ())
  }
  pub fn variationRegionListOffsetByteRange(self: &Self) -> ByteRange { return self._fieldRanges[1] }
/// The number of item variation data subtables.
  pub fn itemVariationDataCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn itemVariationDataCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[2] }
/// Offsets in bytes from the start of the item variation store to
/// each item variation data subtable.
  pub fn itemVariationDataOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset32>> {
    return match move FontData<'a>.readArray<Nullable<Offset32>>(&self._fontData, self._fieldRanges[3].start, self._fieldRanges[3].end) { Result<ScalarArray<'a, Nullable<Offset32>>, ReadError>.Success { value } => value Result<ScalarArray<'a, Nullable<Offset32>>, ReadError>.Failure { error } => ScalarArray<Nullable<Offset32>>.empty() }
  }
  pub fn itemVariationData(self: &Self) -> ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32> { return ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32>.new(ItemVariationStore<'a>.itemVariationDataOffsets(self), self._fontData, ()) }
  pub fn itemVariationDataOffsetsByteRange(self: &Self) -> ByteRange { return self._fieldRanges[3] }
}
impl<'a> FontRead<'a, ()> for ItemVariationStore<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> { return ItemVariationStore<'a>.read(data) }
}
impl<'a> MinByteRange<'a> for ItemVariationStore<'a> {
  fn minByteRange(self: &Self) -> ByteRange { return ByteRange { start: 0, end: self._fieldRanges[3].end } }
  fn minTableBytes(self: &Self) -> &'a [u8] { return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) { Option<FontData<'a>>.Some { value } => FontData.asBytes(&value) Option<FontData<'a>>.None => b"" } }
}

/// The [ItemVariationData](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#item-variation-store-header-and-item-variation-data-subtables) subtable
pub struct ItemVariationData<'a> { _fontData: FontData<'a>, _fieldRanges: [ByteRange; 5], }
impl<'a> Copy for ItemVariationData<'a> {}
impl<'a> ItemVariationData<'a> {
  pub fn default() -> Self { return ItemVariationData<'a>.read(FontData.defaultTableData()) |> Result<Self, ReadError>.unwrapOr(Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 5] }) }
  pub fn minSize() -> usize { return 6 }
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 { return Result<Self, ReadError>.failResult(ReadError.OutOfBounds) }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let itemCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let wordDeltaCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let regionIndexCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(regionIndexCountValue), 2))
    ranges[3].end = end
    ranges[4].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(itemVariationDataLen(itemCountValue, wordDeltaCountValue, regionIndexCountValue), 1))
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }
  pub fn offsetData(self: &Self) -> FontData<'a> { return self._fontData }
/// The number of delta sets for distinct items.
  pub fn itemCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn itemCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[0] }
/// A packed field: the high bit is a flag—see details below.
  pub fn wordDeltaCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn wordDeltaCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[1] }
/// The number of variation regions referenced.
  pub fn regionIndexCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) { Result<u16, ReadError>.Success { value } => value Result<u16, ReadError>.Failure { error } => 0 }
  }
  pub fn regionIndexCountByteRange(self: &Self) -> ByteRange { return self._fieldRanges[2] }
/// Array of indices into the variation region list for the regions
/// referenced by this item variation data table.
  pub fn regionIndexes(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(&self._fontData, self._fieldRanges[3].start, self._fieldRanges[3].end) { Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty() }
  }
  pub fn regionIndexesByteRange(self: &Self) -> ByteRange { return self._fieldRanges[3] }
/// Delta-set rows.
  pub fn deltaSets(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(&self._fontData, self._fieldRanges[4].start, self._fieldRanges[4].end) { Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty() }
  }
  pub fn deltaSetsByteRange(self: &Self) -> ByteRange { return self._fieldRanges[4] }
}
impl<'a> FontRead<'a, ()> for ItemVariationData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> { return ItemVariationData<'a>.read(data) }
}
impl<'a> MinByteRange<'a> for ItemVariationData<'a> {
  fn minByteRange(self: &Self) -> ByteRange { return ByteRange { start: 0, end: self._fieldRanges[4].end } }
  fn minTableBytes(self: &Self) -> &'a [u8] { return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) { Option<FontData<'a>>.Some { value } => FontData.asBytes(&value) Option<FontData<'a>>.None => b"" } }
}


// Handwritten extension from packages/read_fonts/src/tables/variations_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
fn deltaSetIndexData(format: EntryFormat, count: usize) -> usize { return usize.saturatingMultiply(count, u8.toUsize(u8.shiftRight(EntryFormat.bits(&format) & 48, 4)) + 1) }
fn itemVariationDataLen(count: u16, words: u16, regions: u16) -> usize {
  let longs = u16.toUsize(words & 32767)
  let shorts = usize.saturatingSubtract(u16.toUsize(regions), longs)
  let mut wordSize: usize = 2
  let mut smallSize: usize = 1
  if (words & 32768) != 0 { wordSize = 4 smallSize = 2 }
  return (longs * wordSize + shorts * smallSize) * u16.toUsize(count)
}
