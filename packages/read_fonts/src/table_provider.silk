import font_data { FontData }
import font { FontRef }
import read { FontRead, ReadError, readWithArgs }
import font_types.lib { Tag }
import silk.option { Option }
import silk.result { Result }
import tables.head { Head }
import tables.maxp { Maxp, MaxpExtended, SelectedMaxp }
import tables.cmap { Cmap, Dmap }
import tables.hhea { Hhea, HheaExtended, SelectedHhea }
import tables.hmtx { Hmtx, HmtxExtended, GlyphMetricRecords }
import tables.name { Name }
import tables.os2 { Os2 }
import tables.post { Post }
import tables.gdef { Gdef }
import tables.fvar { Fvar }
import tables.avar { Avar }
import tables.mvar { Mvar }
import tables.gvar { Gvar, GvarExtended, SelectedGvar }
import tables.glyf { Glyf }
import tables.loca { Loca }
import tables.vvar { Vvar }
import tables.hvar { Hvar }
import tables.gsub { Gsub }
import tables.gpos { Gpos }
pub interface TopLevelTable { fn tag() -> Tag }
pub fn tableTag<T: TopLevelTable>() -> Tag { return TopLevelTable.tag() }
pub interface TableProvider<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>>
  fn expectDataForTag(self: &Self, tag: Tag) -> Result<FontData<'a>, ReadError> {
    return match move TableProvider.dataForTag(self, tag) { Option<FontData<'a>>.Some { value } => Result<FontData<'a>, ReadError>.succeed(value) Option<FontData<'a>>.None => Result<FontData<'a>, ReadError>.failResult(ReadError.TableIsMissing { tag: tag }) }
  }
  fn head(self: &Self) -> Result<Head<'a>, ReadError> { return readTable<Head<'a>, Self>(self, Head.tag()) }
  fn maxp(self: &Self) -> Result<Maxp<'a>, ReadError> { return readTable<Maxp<'a>, Self>(self, Maxp.tag()) }
  fn maxpExtended(self: &Self) -> Result<MaxpExtended<'a>, ReadError> { return readTable<MaxpExtended<'a>, Self>(self, MaxpExtended.tag()) }
  fn cmap(self: &Self) -> Result<Cmap<'a>, ReadError> { return readTable<Cmap<'a>, Self>(self, Cmap.tag()) }
  fn dmap(self: &Self) -> Result<Dmap<'a>, ReadError> { return readTable<Dmap<'a>, Self>(self, Dmap.tag()) }
  fn hhea(self: &Self) -> Result<Hhea<'a>, ReadError> { return readTable<Hhea<'a>, Self>(self, Hhea.tag()) }
  fn hheaExtended(self: &Self) -> Result<HheaExtended<'a>, ReadError> { return readTable<HheaExtended<'a>, Self>(self, HheaExtended.tag()) }
  fn name(self: &Self) -> Result<Name<'a>, ReadError> { return readTable<Name<'a>, Self>(self, Name.tag()) }
  fn os2(self: &Self) -> Result<Os2<'a>, ReadError> { return readTable<Os2<'a>, Self>(self, Os2.tag()) }
  fn post(self: &Self) -> Result<Post<'a>, ReadError> { return readTable<Post<'a>, Self>(self, Post.tag()) }
  fn hvar(self: &Self) -> Result<Hvar<'a>, ReadError> { return readTable<Hvar<'a>, Self>(self, Hvar.tag()) }
  fn vvar(self: &Self) -> Result<Vvar<'a>, ReadError> { return readTable<Vvar<'a>, Self>(self, Vvar.tag()) }
  fn glyf(self: &Self) -> Result<Glyf<'a>, ReadError> { return readTable<Glyf<'a>, Self>(self, Glyf.tag()) }
  fn glyfExtended(self: &Self) -> Result<Glyf<'a>, ReadError> { return readTable<Glyf<'a>, Self>(self, Tag.fromU32(1196185926)) }
  fn loca(self: &Self, isLong: Option<bool>) -> Result<Loca<'a>, ReadError> {
    let mut length = false
    match move isLong { Option<bool>.Some { value } => { length = value } Option<bool>.None => { let header = match move TableProvider.head(self) { Result<Head<'a>, ReadError>.Success { value } => value Result<Head<'a>, ReadError>.Failure { error } => { return Result<Loca<'a>, ReadError>.failResult(error) } } length = Head.indexToLocFormat(&header) == 1 } }
    let data = match move TableProvider.expectDataForTag(self, Loca.tag()) { Result<FontData<'a>, ReadError>.Success { value } => value Result<FontData<'a>, ReadError>.Failure { error } => { return Result<Loca<'a>, ReadError>.failResult(error) } }
    return Loca.read(data, length)
  }
  fn locaExtended(self: &Self, isLong: Option<bool>) -> Result<Loca<'a>, ReadError> {
    let data = match move TableProvider.expectDataForTag(self, Tag.fromU32(1280262977)) { Result<FontData<'a>, ReadError>.Success { value } => value Result<FontData<'a>, ReadError>.Failure { error } => { return Result<Loca<'a>, ReadError>.failResult(error) } }
    let mut length = false
    match move isLong { Option<bool>.Some { value } => { length = value } Option<bool>.None => { let header = match move TableProvider.head(self) { Result<Head<'a>, ReadError>.Success { value } => value Result<Head<'a>, ReadError>.Failure { error } => { return Result<Loca<'a>, ReadError>.failResult(error) } } length = Head.indexToLocFormat(&header) == 1 } }
    return Loca.read(data, length)
  }
  fn selectedGlyfLoca(self: &Self, isLong: Option<bool>) -> Result<GlyfLoca<'a>, ReadError> {
    match move TableProvider.glyfExtended(self) {
      Result<Glyf<'a>, ReadError>.Success { value: glyf } => { return match move TableProvider.locaExtended(self, move isLong) { Result<Loca<'a>, ReadError>.Success { value: loca } => Result<GlyfLoca<'a>, ReadError>.succeed(GlyfLoca<'a> { glyf: glyf, loca: loca }) Result<Loca<'a>, ReadError>.Failure { error } => Result<GlyfLoca<'a>, ReadError>.failResult(error) } }
      Result<Glyf<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, Tag.fromU32(1196185926)) { return Result<GlyfLoca<'a>, ReadError>.failResult(error) } }
    }
    let glyf = match move TableProvider.glyf(self) { Result<Glyf<'a>, ReadError>.Success { value } => value Result<Glyf<'a>, ReadError>.Failure { error } => { return Result<GlyfLoca<'a>, ReadError>.failResult(error) } }
    return match move TableProvider.loca(self, move isLong) { Result<Loca<'a>, ReadError>.Success { value } => Result<GlyfLoca<'a>, ReadError>.succeed(GlyfLoca<'a> { glyf: glyf, loca: value }) Result<Loca<'a>, ReadError>.Failure { error } => Result<GlyfLoca<'a>, ReadError>.failResult(error) }
  }
  fn gvar(self: &Self) -> Result<Gvar<'a>, ReadError> { return readTable<Gvar<'a>, Self>(self, Gvar.tag()) }
  fn gvarExtended(self: &Self) -> Result<GvarExtended<'a>, ReadError> { return readTable<GvarExtended<'a>, Self>(self, GvarExtended.tag()) }
  fn selectedGvar(self: &Self) -> Result<SelectedGvar<'a>, ReadError> {
    match move TableProvider.gvarExtended(self) {
      Result<GvarExtended<'a>, ReadError>.Success { value } => { return Result<SelectedGvar<'a>, ReadError>.succeed(SelectedGvar<'a>.Extended { table: value }) }
      Result<GvarExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, GvarExtended.tag()) { return Result<SelectedGvar<'a>, ReadError>.failResult(error) } }
    }
    return match move TableProvider.gvar(self) { Result<Gvar<'a>, ReadError>.Success { value } => Result<SelectedGvar<'a>, ReadError>.succeed(SelectedGvar<'a>.Original { table: value }) Result<Gvar<'a>, ReadError>.Failure { error } => Result<SelectedGvar<'a>, ReadError>.failResult(error) }
  }
  fn mvar(self: &Self) -> Result<Mvar<'a>, ReadError> { return readTable<Mvar<'a>, Self>(self, Mvar.tag()) }
  fn fvar(self: &Self) -> Result<Fvar<'a>, ReadError> { return readTable<Fvar<'a>, Self>(self, Fvar.tag()) }
  fn avar(self: &Self) -> Result<Avar<'a>, ReadError> { return readTable<Avar<'a>, Self>(self, Avar.tag()) }
  fn gdef(self: &Self) -> Result<Gdef<'a>, ReadError> { return readTable<Gdef<'a>, Self>(self, Gdef.tag()) }
  fn gsub(self: &Self) -> Result<Gsub<'a>, ReadError> { return readTable<Gsub<'a>, Self>(self, Gsub.tag()) }
  fn gpos(self: &Self) -> Result<Gpos<'a>, ReadError> { return readTable<Gpos<'a>, Self>(self, Gpos.tag()) }
  fn hmtx(self: &Self) -> Result<Hmtx<'a>, ReadError> {
    let header = match move TableProvider.hhea(self) { Result<Hhea<'a>, ReadError>.Success { value } => value Result<Hhea<'a>, ReadError>.Failure { error } => { return Result<Hmtx<'a>, ReadError>.failResult(error) } }
    let data = match move TableProvider.expectDataForTag(self, Hmtx.tag()) { Result<FontData<'a>, ReadError>.Success { value } => value Result<FontData<'a>, ReadError>.Failure { error } => { return Result<Hmtx<'a>, ReadError>.failResult(error) } }
    return Hmtx<'a>.read(data, Hhea<'a>.numberOfHMetrics(&header))
  }
  fn hmtxExtended(self: &Self) -> Result<HmtxExtended<'a>, ReadError> {
    let data = match move TableProvider.expectDataForTag(self, HmtxExtended.tag()) { Result<FontData<'a>, ReadError>.Success { value } => value Result<FontData<'a>, ReadError>.Failure { error } => { return Result<HmtxExtended<'a>, ReadError>.failResult(error) } }
    let header = match move TableProvider.hheaExtended(self) { Result<HheaExtended<'a>, ReadError>.Success { value } => value Result<HheaExtended<'a>, ReadError>.Failure { error } => { return Result<HmtxExtended<'a>, ReadError>.failResult(error) } }
    return HmtxExtended<'a>.read(data, HheaExtended<'a>.numberOfHMetrics(&header))
  }
  fn selectedMaxp(self: &Self) -> Result<SelectedMaxp<'a>, ReadError> {
    match move TableProvider.maxpExtended(self) {
      Result<MaxpExtended<'a>, ReadError>.Success { value } => { return Result<SelectedMaxp<'a>, ReadError>.succeed(SelectedMaxp<'a>.Extended { table: value }) }
      Result<MaxpExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, MaxpExtended.tag()) { return Result<SelectedMaxp<'a>, ReadError>.failResult(error) } }
    }
    return match move TableProvider.maxp(self) { Result<Maxp<'a>, ReadError>.Success { value } => Result<SelectedMaxp<'a>, ReadError>.succeed(SelectedMaxp<'a>.Original { table: value }) Result<Maxp<'a>, ReadError>.Failure { error } => Result<SelectedMaxp<'a>, ReadError>.failResult(error) }
  }
  fn selectedHhea(self: &Self) -> Result<SelectedHhea<'a>, ReadError> {
    match move TableProvider.hheaExtended(self) {
      Result<HheaExtended<'a>, ReadError>.Success { value } => { return Result<SelectedHhea<'a>, ReadError>.succeed(SelectedHhea<'a>.Extended { table: value }) }
      Result<HheaExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, HheaExtended.tag()) { return Result<SelectedHhea<'a>, ReadError>.failResult(error) } }
    }
    return match move TableProvider.hhea(self) { Result<Hhea<'a>, ReadError>.Success { value } => Result<SelectedHhea<'a>, ReadError>.succeed(SelectedHhea<'a>.Original { table: value }) Result<Hhea<'a>, ReadError>.Failure { error } => Result<SelectedHhea<'a>, ReadError>.failResult(error) }
  }
  fn hGlyphMetricRecords(self: &Self) -> Result<GlyphMetricRecords<'a>, ReadError> {
    match move TableProvider.hmtxExtended(self) {
      Result<HmtxExtended<'a>, ReadError>.Success { value } => { return Result<GlyphMetricRecords<'a>, ReadError>.succeed(GlyphMetricRecords<'a>.fromHmtxExtended(value)) }
      Result<HmtxExtended<'a>, ReadError>.Failure { error } => { if !isMissingTable(error, HmtxExtended.tag()) { return Result<GlyphMetricRecords<'a>, ReadError>.failResult(error) } }
    }
    return match move TableProvider.hmtx(self) { Result<Hmtx<'a>, ReadError>.Success { value } => Result<GlyphMetricRecords<'a>, ReadError>.succeed(GlyphMetricRecords<'a>.fromHmtx(value)) Result<Hmtx<'a>, ReadError>.Failure { error } => Result<GlyphMetricRecords<'a>, ReadError>.failResult(error) }
  }
}

impl<'a> TableProvider<'a> for FontRef<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> { return FontRef<'a>.tableData(self, tag) }
}

pub fn readTable<'a, T: FontRead<'a, ()>, P: TableProvider<'a>>(provider: &P, tag: Tag) -> Result<T, ReadError> {
  return match move TableProvider.dataForTag(provider, tag) {
    Option<FontData<'a>>.Some { value } => readWithArgs<(), T>(value, ())
    Option<FontData<'a>>.None => Result<T, ReadError>.failResult(ReadError.TableIsMissing { tag: tag })
  }
}

fn isMissingTable(error: ReadError, expected: Tag) -> bool { return match error { ReadError.TableIsMissing { tag } => &tag == &expected _ => false } }

// compiler-bugs/004: a free generic helper avoids an unsupported generic default operation.
pub fn expectTable<'a, T: TopLevelTable + FontRead<'a, ()>, P: TableProvider<'a>>(provider: &P) -> Result<T, ReadError> { return readTable<T, P>(provider, tableTag<T>()) }

pub struct GlyfLoca<'a> { pub glyf: Glyf<'a>, pub loca: Loca<'a>, }
