import ps.cff.font { CffFontRef, Subfont, Metadata, Encoding, HintedSubfont }
import ps.cff.index { Index }
import ps.cff.charset { Charset, Iter }
import ps.cff.blend { BlendState }
import ps.string { Sid }
import ps.encoding { PredefinedEncoding }
import ps.hinting { HintingParams, Blues }
import ps.transform { Transform, ScaledFontMatrix }
import tables.variations { ItemVariationStore }
import table_ref { ByteRange }
import font_data { FontData }
import font_types.lib { Fixed, F2Dot14, GlyphId, Matrix, BoundingBox }
import model.error { Error }
import generated_cff_fixtures { exampleCff2, notoSerifTable, iconsTable, iconsMatrixTable, cantarellTable }
import silk.option { Option }
import silk.result { Result }
import silk.slice { Slice }
import silk.string { String }
import silk.equal { Equal }
import silk.testing { Testing, AssertionError }
import silk.usize
import silk.i32
effect fn must<T,E>(value:Result<T,E>) -> T ! AssertionError<'static> { return match move value { Result<T,E>.Success { value: item } => move item _ => { run Testing.expect(false,"CFF font fixture parses") return Intrinsic.trap("assertion") } } }
effect fn some<T>(value:Option<T>) -> T ! AssertionError<'static> { return match move value { Option<T>.Some { value:item } => move item _ => { run Testing.expect(false,"CFF value exists") return Intrinsic.trap("assertion") } } }
fn absent<T>(value:Option<T>) -> bool { return match move value { Option<T>.None => true _ => false } }
fn failed<T,E>(value:Result<T,E>) -> bool { return match move value { Result<T,E>.Failure { error } => true _ => false } }
fn equal<T:Equal>(a:T,b:T) -> bool { return &a==&b }
effect fn font(data:&'static [u8]) -> CffFontRef<'static> ! AssertionError<'static> { return run must(CffFontRef.new(data,0,Option<i32>.None)) }
effect fn checkCommon(cff:&CffFontRef<'static>,version:u16,glyphs:u32,globals:u32) -> () ! AssertionError<'static> {
  run Testing.expect(CffFontRef.version(cff)==version,"CFF version")
  run Testing.expect(absent(CffFontRef.varStore(cff))==(version==1),"variation store presence")
  run Testing.expect(CffFontRef.numGlyphs(cff)==glyphs && CffFontRef.numSubfonts(cff)==1,"glyph and subfont count")
  run Testing.expect((run some(CffFontRef.subfontIndex(cff,GlyphId.new(1))))==0,"subfont selection")
  run Testing.expect(Index.count(&CffFontRef.globalSubrs(cff))==globals,"global subroutines")
}
test effect fn readCffStatic() ! AssertionError<'static> { let cff=run must(CffFontRef.newCff(notoSerifTable(),0,Option<i32>.None)) run checkCommon(&cff,1,5,17) let range=run some(CffFontRef.sidPrivateDictRange(&cff)) run Testing.expect(range.end>range.start,"SID private dictionary") }
test effect fn readCff2Static() ! AssertionError<'static> { let cff=run must(CffFontRef.newCff2(cantarellTable(),Option<i32>.None)) run checkCommon(&cff,2,6,0) run Testing.expect(absent(CffFontRef.strings(&cff)),"CFF2 has no SID strings") }
test effect fn readExampleCff2Table() ! AssertionError<'static> { let cff=run must(CffFontRef.newCff2(exampleCff2(),Option<i32>.None)) run checkCommon(&cff,2,2,0) }
effect fn checkMetadata(data:&'static [u8],name:string,full:string,family:Option<string<'static>>,bbox:[i32;4]) -> () ! AssertionError<'static> {
  let cff=run font(data) let meta=run some(CffFontRef.metadata(&cff))
  run Testing.expect((run some(Metadata.name(&meta)))==name && (run some(Metadata.fullName(&meta)))==full,"PostScript and full names")
  run Testing.expect((Option<string<'static>>.unwrapOr(Metadata.familyName(&meta),"")==Option<string<'static>>.unwrapOr(move family,"")) && absent(Metadata.weight(&meta)),"family and absent weight")
  let b=Metadata.bbox(&meta) run Testing.expect(Fixed.toBits(b.xMin)==i32.shiftLeft(bbox[0],16) && Fixed.toBits(b.yMin)==i32.shiftLeft(bbox[1],16) && Fixed.toBits(b.xMax)==i32.shiftLeft(bbox[2],16) && Fixed.toBits(b.yMax)==i32.shiftLeft(bbox[3],16),"font bbox")
  run Testing.expect(Fixed.toBits(Metadata.italicAngle(&meta))==0 && !Metadata.isFixedPitch(&meta),"metadata defaults")
  run Testing.expect(Fixed.toI32(Metadata.underlinePosition(&meta)) == -100 && Fixed.toI32(Metadata.underlineThickness(&meta))==50,"underline defaults")
}
test effect fn readCffMetadata() ! AssertionError<'static> { run checkMetadata(notoSerifTable(),"NotoSerifDisplay-Regular","Noto Serif Display Regular",Option<string>.some("Noto Serif Display"),[-693,-470,2797,1048]) run checkMetadata(iconsTable(),"GoogleMaterialIcons-Regular","GoogleMaterialIcons-Regular",Option<string>.None,[-1,0,513,512]) }
test effect fn charset() ! AssertionError<'static> { let cff=run font(notoSerifTable()) let chars=run some(CffFontRef.charset(&cff)) let mut iter=Charset.iter(&chars) let expected:[string;5]=[".notdef","i","j","k","l"] let mut i:usize=0 while i<expected.length { let item=run some(Iter.next(&mut iter)) run Testing.expect(GlyphId.toU32(item.glyph)==usize.toU32(i),"charset glyph order") run Testing.expect((run must(String.fromUtf8(run must(Sid.resolveStandard(item.sid)))))==expected[i],"standard glyph name") i=i+1 } run Testing.expect(absent(Iter.next(&mut iter)),"exact charset length") }
test effect fn topDictIvsOffsetOverflow() ! AssertionError<'static> { let data:[u8;16]=[2,0,5,0,6,29,255,255,255,255,24,0,0,0,0,0] run Testing.expect(failed(CffFontRef.newCff2(&data,Option<i32>.None)),"negative IVS offset is checked before adding length") }
test effect fn subrsOffsetOverflow() ! AssertionError<'static> { let data:[u8;10]=[0,0,0,0,29,255,255,255,255,19] run Testing.expect(failed(Subfont.new(&data,ByteRange { start:4,end:10 },Option<BlendState<'static,'static>>.None,Option<ScaledFontMatrix>.None)),"negative local offset is checked") }
test effect fn emptyPrivateDict() ! AssertionError<'static> { let cff=run font(iconsTable()) let range=run some(CffFontRef.sidPrivateDictRange(&cff)) run Testing.expect(range.start==range.end,"empty private DICT accepted") }
test effect fn captureFamilyOtherBlues() ! AssertionError<'static> { let data=exampleCff2() let store=run must(ItemVariationStore.read(FontData.new(Slice.view<u8>(data,18,data.length-18)))) let coords=[F2Dot14.zero()] let blend=run must(BlendState.new(store,&coords,0)) let hinted=run must(Subfont.newHinted(data,ByteRange { start:79,end:193 },Option<BlendState>.some(blend),Option<ScaledFontMatrix>.None)) let expected=Blues.new(&[Fixed.fromI32(-249),Fixed.fromI32(-239)]) run Testing.expect(equal(hinted.hinting.familyOtherBlues,expected),"family other blues are independent") }
effect fn checkSubfont(sub:&Subfont,nominal:i32) -> () ! AssertionError<'static> { run Testing.expect(absent(Subfont.defaultWidth(sub)) && Fixed.toI32(Subfont.nominalWidth(sub))==nominal && Subfont.vsIndex(sub)==0 && absent(Subfont.matrix(sub)),"private dictionary values") }
test effect fn subfontCff() ! AssertionError<'static> { let cff=run font(notoSerifTable()) let sub=run must(CffFontRef.subfont(&cff,0,&[])) run checkSubfont(&sub,598) }
test effect fn subfontCff2() ! AssertionError<'static> { let cff=run font(cantarellTable()) let sub=run must(CffFontRef.subfont(&cff,0,&[])) run checkSubfont(&sub,0) }
fn makeBlues(values:&[i32]) -> Blues { let mut fixed:[Fixed;14]=[Fixed.zero();14] let mut i:usize=0 while i<values.length { fixed[i]=Fixed.fromI32(values[i]) i=i+1 } return Blues.new(Slice.view<Fixed>(&fixed,0,values.length)) }
effect fn checkHinted(hinted:&HintedSubfont,nominal:i32,blues:&[i32],other:&[i32],scale:f64,fuzz:i32) -> () ! AssertionError<'static> { run checkSubfont(&hinted.subfont,nominal) let h=hinted.hinting run Testing.expect(equal(h.blues,makeBlues(blues)) && equal(h.otherBlues,makeBlues(other)) && equal(h.familyBlues,Blues.default()) && equal(h.familyOtherBlues,Blues.default()),"all hinting blue regions") run Testing.expect(Fixed.toBits(h.blueScale)==Fixed.toBits(Fixed.fromF64(scale)) && Fixed.toI32(h.blueShift)==7 && Fixed.toI32(h.blueFuzz)==fuzz && h.languageGroup==0,"hinting scalars") }
test effect fn hintedSubfontCff() ! AssertionError<'static> { let cff=run font(notoSerifTable()) let hinted=run must(CffFontRef.subfontHinted(&cff,0,&[])) run checkHinted(&hinted,598,&[-15,0,536,547,571,582,714,726,760,772],&[-255,-240],0.0500030517578125,0) }
test effect fn hintedSubfontCff2() ! AssertionError<'static> { let cff=run font(cantarellTable()) let hinted=run must(CffFontRef.subfontHinted(&cff,0,&[])) run checkHinted(&hinted,0,&[-10,0,482,492,694,704,739,749],&[-227,-217],0.0625,1) }
test effect fn subfontMatrix() ! AssertionError<'static> { let cff=run font(iconsMatrixTable()) let sub=run must(CffFontRef.subfont(&cff,0,&[])) run Testing.expect(absent(Subfont.defaultWidth(&sub)) && Fixed.toBits(Subfont.nominalWidth(&sub))==0 && Subfont.vsIndex(&sub)==0,"matrix font metrics") let matrix=run some(Subfont.matrix(&sub)) run Testing.expect(matrix.scale==10 && equal(matrix.matrix,Matrix.fromElements<Fixed>([Fixed.fromI32(5),Fixed.zero(),Fixed.zero(),Fixed.fromI32(5),Fixed.zero(),Fixed.zero()])) ,"raw subfont matrix") }
test effect fn selectVersion() ! AssertionError<'static> { let cff2=run font(cantarellTable()) let cff=run font(iconsMatrixTable()) run Testing.expect(CffFontRef.version(&cff2)==2 && CffFontRef.version(&cff)==1,"header selects version") let mut version:u8=0 while version<3 { let bytes=[version,1,4,5] run Testing.expect(failed(CffFontRef.new(&bytes,0,Option<i32>.None)),"spoofed or unknown version rejected") version=version+1 } }
test effect fn transform() ! AssertionError<'static> { let cff=run must(CffFontRef.new(iconsMatrixTable(),0,Option<i32>.some(512))) let sub=run must(CffFontRef.subfont(&cff,0,&[])) let expected=Matrix.fromElements<Fixed>([Fixed.fromBits(65536),Fixed.zero(),Fixed.fromBits(5604),Fixed.fromBits(65536),Fixed.zero(),Fixed.zero()]) let unscaled=CffFontRef.transform(&cff,&sub,Option<f32>.None) run Testing.expect(equal(unscaled.matrix,expected) && Fixed.toBits(run some(move unscaled.scale))==2097152,"normalized matrix and UPEM adjustment") let scaled=CffFontRef.transform(&cff,&sub,Option<f32>.some(16.0)) run Testing.expect(equal(scaled.matrix,expected) && Fixed.toBits(run some(move scaled.scale))==65536,"16 ppem scale") }
test effect fn cffEncoding() ! AssertionError<'static> { let cff=run font(notoSerifTable()) let enc=run some(CffFontRef.encoding(&cff)) run Testing.expect((run some(Encoding.predefined(&enc)))==PredefinedEncoding.Standard,"default standard encoding") }
test effect fn cff2LacksEncoding() ! AssertionError<'static> { let cff=run font(cantarellTable()) run Testing.expect(absent(CffFontRef.encoding(&cff)),"CFF2 uses cmap") }
