//! Bounds-checked big-endian scalar codecs; decoding never reinterprets native memory.
import cast
import silk.option { Option }
import silk.ownership { Copy }
import silk.u8
import silk.u16
import silk.u32
import silk.u64
import silk.usize

/// A fixed-width big-endian font value. Reading requires the exact encoded byte count.
pub interface Scalar {
  fn rawByteLen() -> usize
  fn read(bytes: &[u8]) -> Option<Self>
  fn write(value: Self, bytes: &mut [u8]) -> bool
}
pub fn rawByteLen<T: Scalar>() -> usize { return Scalar.rawByteLen() }
pub fn readScalar<T: Scalar>(bytes: &[u8]) -> Option<T> { return Scalar.read(bytes) }
pub fn writeScalar<T: Scalar>(value: T, bytes: &mut [u8]) -> bool {
  return Scalar.write(move value, move bytes)
}
fn unsigned(bytes: &[u8]) -> u64 {
  let mut value: u64 = 0
  let mut index: usize = 0
  while index < bytes.length {
    value = u64.shiftLeft(value, 8) | u8.toU64(bytes[index])
    index = index + 1
  }
  return value
}
fn putUnsigned(value: u64, bytes: &mut [u8], length: usize) -> () {
  let mut remaining = length
  let mut bits = value
  while remaining > 0 {
    remaining = remaining - 1
    bytes[remaining] = u64.toU8(bits & 255)
    bits = u64.shiftRight(bits, 8)
  }
}

impl Scalar for u8 {
  fn rawByteLen() -> usize { return 1 }
  fn read(bytes: &[u8]) -> Option<u8> {
    if bytes.length != 1 { return Option<u8>.None }
    return Option<u8>.some(u64.toU8(unsigned(bytes)))
  }
  fn write(value: u8, bytes: &mut [u8]) -> bool {
    if bytes.length < 1 { return false }
    putUnsigned(u8.toU64(value), move bytes, 1)
    return true
  }
}

impl Scalar for u16 {
  fn rawByteLen() -> usize { return 2 }
  fn read(bytes: &[u8]) -> Option<u16> {
    if bytes.length != 2 { return Option<u16>.None }
    return Option<u16>.some(u64.toU16(unsigned(bytes)))
  }
  fn write(value: u16, bytes: &mut [u8]) -> bool {
    if bytes.length < 2 { return false }
    putUnsigned(u16.toU64(value), move bytes, 2)
    return true
  }
}

impl Scalar for u32 {
  fn rawByteLen() -> usize { return 4 }
  fn read(bytes: &[u8]) -> Option<u32> {
    if bytes.length != 4 { return Option<u32>.None }
    return Option<u32>.some(u64.toU32(unsigned(bytes)))
  }
  fn write(value: u32, bytes: &mut [u8]) -> bool {
    if bytes.length < 4 { return false }
    putUnsigned(u32.toU64(value), move bytes, 4)
    return true
  }
}

impl Scalar for u64 {
  fn rawByteLen() -> usize { return 8 }
  fn read(bytes: &[u8]) -> Option<u64> {
    if bytes.length != 8 { return Option<u64>.None }
    return Option<u64>.some(unsigned(bytes))
  }
  fn write(value: u64, bytes: &mut [u8]) -> bool {
    if bytes.length < 8 { return false }
    putUnsigned(value, move bytes, 8)
    return true
  }
}

impl Scalar for i8 {
  fn rawByteLen() -> usize { return 1 }
  fn read(bytes: &[u8]) -> Option<i8> {
    if bytes.length != 1 { return Option<i8>.None }
    return Option<i8>.some(cast.u8ToI8(u64.toU8(unsigned(bytes))))
  }
  fn write(value: i8, bytes: &mut [u8]) -> bool {
    if bytes.length < 1 { return false }
    putUnsigned(u8.toU64(cast.i8ToU8(value)), move bytes, 1)
    return true
  }
}

impl Scalar for i16 {
  fn rawByteLen() -> usize { return 2 }
  fn read(bytes: &[u8]) -> Option<i16> {
    if bytes.length != 2 { return Option<i16>.None }
    return Option<i16>.some(cast.u16ToI16(u64.toU16(unsigned(bytes))))
  }
  fn write(value: i16, bytes: &mut [u8]) -> bool {
    if bytes.length < 2 { return false }
    putUnsigned(u16.toU64(cast.i16ToU16(value)), move bytes, 2)
    return true
  }
}

impl Scalar for i32 {
  fn rawByteLen() -> usize { return 4 }
  fn read(bytes: &[u8]) -> Option<i32> {
    if bytes.length != 4 { return Option<i32>.None }
    return Option<i32>.some(cast.u32ToI32(u64.toU32(unsigned(bytes))))
  }
  fn write(value: i32, bytes: &mut [u8]) -> bool {
    if bytes.length < 4 { return false }
    putUnsigned(u32.toU64(cast.i32ToU32(value)), move bytes, 4)
    return true
  }
}

impl Scalar for i64 {
  fn rawByteLen() -> usize { return 8 }
  fn read(bytes: &[u8]) -> Option<i64> {
    if bytes.length != 8 { return Option<i64>.None }
    return Option<i64>.some(cast.u64ToI64(unsigned(bytes)))
  }
  fn write(value: i64, bytes: &mut [u8]) -> bool {
    if bytes.length < 8 { return false }
    putUnsigned(cast.i64ToU64(value), move bytes, 8)
    return true
  }
}

pub interface FixedSize { fn rawByteLen() -> usize }

pub fn fixedByteLen<T: FixedSize>() -> usize { return FixedSize.rawByteLen() }
impl FixedSize for u8 { fn rawByteLen() -> usize { return 1 } }
impl FixedSize for i8 { fn rawByteLen() -> usize { return 1 } }
impl FixedSize for u16 { fn rawByteLen() -> usize { return 2 } }
impl FixedSize for i16 { fn rawByteLen() -> usize { return 2 } }
impl FixedSize for u32 { fn rawByteLen() -> usize { return 4 } }
impl FixedSize for i32 { fn rawByteLen() -> usize { return 4 } }
impl FixedSize for u64 { fn rawByteLen() -> usize { return 8 } }
impl FixedSize for i64 { fn rawByteLen() -> usize { return 8 } }
