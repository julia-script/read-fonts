//! Numeric preflight for the pinned vector backend; this never emits geometry or coverage.
import svg_core.scene { Color, RenderError, Stroke }
import vector.geometry { Affine, Point }
import vector.path { Path, MOVE, QUAD, CUBIC, CLOSE }
import vector.flatten { Line }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.usize

const F32_MAX: f64 = 3.4028234663852886e38

// Aggregate output plus isolated surfaces: 256 MiB of premultiplied RGBA storage.
pub const MAX_SURFACE_PIXELS: usize = 67108864

pub effect fn dimensions(width: u32, height: u32) -> ()
  ! RenderError {
  if width == 0 || height == 0 {
    fail RenderError.InvalidSize
  }

  // Coverage uses f32 pixel boundaries and u32 alpha offsets, including padded bands.
  if width > 16777216 || height > 16777216 {
    fail RenderError.TooLarge
  }
  if u32.toU64(width) * u32.toU64(height) > usize.toU64(MAX_SURFACE_PIXELS) {
    fail RenderError.TooLarge
  }
  let paddedHeight = ((u32.toU64(height) + 3) / 4) * 4
  let bytes = u32.toU64(width) * paddedHeight * 4
  if bytes > 4294967295 || bytes > usize.toU64(usize.MAX) {
    fail RenderError.TooLarge
  }
}

pub effect fn unit(value: f64) -> u8
  ! RenderError {
  if !f64.isFinite(value) || value < 0.0 || value > 1.0 {
    fail RenderError.InvalidGeometry
  }
  return f64.toU8(value * 255.0 + 0.5)
}

pub effect fn color(value: Color) -> ()
  ! RenderError {
  drop run unit(value.r)
  drop run unit(value.g)
  drop run unit(value.b)
  drop run unit(value.a)
}

pub effect fn affine(value: &Affine) -> ()
  ! RenderError {
  if !f64.isFinite(value.a) || !f64.isFinite(value.b) || !f64.isFinite(value.c)
    || !f64.isFinite(value.d)
    || !f64.isFinite(value.e)
    || !f64.isFinite(value.f) {
    fail RenderError.InvalidGeometry
  }
}

pub effect fn path(path: &Path, transform: &Affine) -> ()
  ! RenderError {
  run affine(transform)
  let points = path.pointList()
  let mut i: usize = 0
  while i < points.length {
    let p = points[i]
    let q = transform.apply(p)

    // flatten.emit narrows to f32; nonfinite coordinates would otherwise disappear silently.
    if !p.isFinite() || !q.isFinite() || f64.abs(q.x) > F32_MAX || f64.abs(q.y) > F32_MAX {
      fail RenderError.InvalidGeometry
    }
    i = i + 1
  }
}

pub effect fn stroke(path: &Path, transform: &Affine, style: Stroke, dashes: &[f64]) -> ()
  ! RenderError {
  if !f64.isFinite(style.width) || style.width < 0.0 || !f64.isFinite(style.miterLimit)
    || style.miterLimit < 1.0
    || !f64.isFinite(style.dashOffset) {
    fail RenderError.InvalidGeometry
  }
  if style.width == 0.0 {
    return
  }

  // Stroker.maxScale uses unscaled fourth powers, unlike svg_geometry.maxScale.
  let t = transform.a * transform.a + transform.b * transform.b + transform.c * transform.c
    + transform.d * transform.d
  let det = transform.a * transform.d - transform.b * transform.c
  if !f64.isFinite(t * t) || !f64.isFinite(4.0 * det * det) {
    fail RenderError.InvalidGeometry
  }

  // Round-join area arithmetic squares the radius and multiplies by its segment count.
  if !f64.isFinite(style.width * style.width * 4096.0)
    || !f64.isFinite(style.width * style.miterLimit) {
    fail RenderError.InvalidGeometry
  }
  let points = path.pointList()
  let verbs = path.verbList()
  let mut lengthBound: f64 = 0.0
  let mut subpathLength: f64 = 0.0
  let mut current = Point.make(0.0, 0.0)
  let mut start = current
  let mut pointIndex: usize = 0
  let mut i: usize = 0
  while i < verbs.length {
    let verb = verbs[i]
    if verb == MOVE {
      lengthBound = f64.max(lengthBound, subpathLength)
      subpathLength = 0.0
      current = points[pointIndex]
      start = current
      pointIndex = pointIndex + 1
    } else if verb == CLOSE {
      subpathLength = subpathLength + run distance(current, start)
      current = start
    } else {
      let count: usize = if verb == CUBIC {
        3
      } else if verb == QUAD {
        2
      } else {
        1
      }
      let mut j: usize = 0
      while j < count {
        let next = points[pointIndex]
        subpathLength = subpathLength + run distance(current, next)
        current = next
        pointIndex = pointIndex + 1
        j = j + 1
      }
    }
    if !f64.isFinite(subpathLength) {
      fail RenderError.InvalidGeometry
    }
    i = i + 1
  }
  lengthBound = f64.max(lengthBound, subpathLength)
  let mut total: f64 = 0.0
  let mut minimum = f64.INFINITY
  i = 0
  while i < dashes.length {
    let value = dashes[i]
    if !f64.isFinite(value) || value < 0.0 {
      fail RenderError.InvalidGeometry
    }
    total = total + value
    if value > 0.0 {
      minimum = f64.min(minimum, value)
    }
    i = i + 1
  }
  if dashes.length % 2 == 1 {
    total = total * 2.0
  }
  if !f64.isFinite(total) {
    fail RenderError.InvalidGeometry
  }
  if total > 0.0 {
    let cycles = f64.floor(style.dashOffset / total)
    if !f64.isFinite(cycles) || !f64.isFinite(total * cycles) {
      fail RenderError.InvalidGeometry
    }

    // A dash advance must make progress at the largest centerline distance. The backend
    // cannot represent more than u32-indexed outline segments either.
    if minimum <= lengthBound * 2.220446049250313e-16 || lengthBound / minimum > 4294967295.0 {
      fail RenderError.InvalidGeometry
    }
  }
}

effect fn distance(a: Point, b: Point) -> f64
  ! RenderError {
  let dx = b.x - a.x
  let dy = b.y - a.y
  let squared = dx * dx + dy * dy
  if !f64.isFinite(squared) {
    fail RenderError.InvalidGeometry
  }
  return f64.sqrt(squared)
}

pub effect fn lines(lines: &[Line], width: u32, height: u32) -> ()
  ! RenderError {
  let w = u32.toF32(width)
  let h = u32.toF32(height)
  let mut bandEntries: u64 = 0
  let mut i: usize = 0
  while i < lines.length {
    let line = lines[i]
    if !f32.isFinite(line.x0) || !f32.isFinite(line.y0) || !f32.isFinite(line.x1)
      || !f32.isFinite(line.y1) {
      fail RenderError.InvalidGeometry
    }
    if f32.max(line.y0, line.y1) > 0.0 && f32.min(line.y0, line.y1) < h && line.y0 != line.y1 {
      run lineArithmetic(line, w, h)
      let low = f32.toU32(f32.max(f32.min(line.y0, line.y1), 0.0)) / 4
      let high = (f32.toU32(f32.ceil(f32.min(f32.max(line.y0, line.y1), h))) - 1) / 4
      bandEntries = bandEntries + u32.toU64(high - low + 1) * 3
      if bandEntries > 4294967295 {
        fail RenderError.InvalidGeometry
      }
    }
    i = i + 1
  }
  if lines.length > 1431655765 {
    fail RenderError.InvalidGeometry
  }
}

// Check the exact f32 operations the backend will perform at the two x clipping
// boundaries. Candidate pairs only certify arithmetic; vector owns all clipping,
// subdivision, coverage integration and pixel conversion.
effect fn lineArithmetic(line: Line, width: f32, height: f32) -> ()
  ! RenderError {
  let dx = line.x1 - line.x0
  let dy = line.y1 - line.y0
  if !f32.isFinite(dx) || !f32.isFinite(dy) {
    fail RenderError.InvalidGeometry
  }
  let mut xs: [f32; 4] = [
    f32.min(f32.max(line.x0, 0.0), width),
    f32.min(f32.max(line.x1, 0.0), width),
    0.0,
    0.0,
  ]
  let mut ys: [f32; 4] = [line.y0, line.y1, 0.0, 0.0]
  let mut count: usize = 2
  let mut edge: usize = 0
  while edge < 2 {
    let x: f32 = if edge == 0 {
      0.0
    } else {
      width
    }
    if (line.x0 < x && line.x1 > x) || (line.x0 > x && line.x1 < x) {
      let product = (x - line.x0) * dy
      let y = line.y0 + product / dx
      if !f32.isFinite(product) || !f32.isFinite(y) {
        fail RenderError.InvalidGeometry
      }
      xs[count] = x
      ys[count] = y
      count = count + 1
    }
    edge = edge + 1
  }
  let mut a: usize = 0
  while a < count {
    let mut b = a + 1
    while b < count {
      let low = f32.min(ys[a], ys[b])
      let high = f32.max(ys[a], ys[b])
      if low < high && low < height && high > 0.0 {
        let slope = (xs[b] - xs[a]) / (ys[b] - ys[a])
        let first = (f32.max(low, 0.0) - low) * slope
        let last = (f32.min(high, height) - low) * slope
        if !f32.isFinite(slope) || !f32.isFinite(first) || !f32.isFinite(last)
          || !f32.isFinite(width + f32.abs(first))
          || !f32.isFinite(width + f32.abs(last)) {
          fail RenderError.InvalidGeometry
        }
      }
      b = b + 1
    }
    a = a + 1
  }
}
