//! CLI policy (not SVG syntax): one input and mandatory -o output; no stdin or stdout PNG.
//! Dimensions are positive decimal u32 values; zoom is a complete positive finite decimal.
//! Options take separate values, may appear in any order, and may not repeat. -- ends options.
//! --help and --version stand alone. Unsupported options are errors, never ignored.
import silk.collections.bytes { Bytes }
import silk.core.result { Result }
import silk.option { Option }
import silk.num.u8
import silk.num.f64
import svg_geometry.svg

pub enum Action {
  Render,
  Help,
  Version
}

pub enum ArgumentError {
  MissingInput,
  MissingOutput,
  MissingValue,
  UnknownOption,
  ExtraInput,
  DuplicateOption,
  InvalidDimension,
  InvalidZoom,
  InvalidPath,
  InformationOnly,
}

// File paths remain owned by the argument list, and indices avoid borrowed result lifetimes.
pub struct Parsed {
  pub action: Action,
  pub input: usize,
  pub output: usize,
  pub width: u32,
  pub height: u32,
  pub zoom: f64,
}

fn equals(bytes: &[u8], text: string) -> bool {
  let expected = Intrinsic.stringUtf8Bytes(text)
  if bytes.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn dimension(bytes: &[u8]) -> Option<u32> {
  if bytes.length == 0 {
    return Option<u32>.None
  }
  let mut value: u32 = 0
  let mut index: usize = 0
  while index < bytes.length {
    let byte = bytes[index]
    if byte < 48 || byte > 57 {
      return Option<u32>.None
    }
    let digit = u8.toU32(byte - 48)

    // The precondition proves both multiply and add remain in range.
    if value > (4294967295 - digit) / 10 {
      return Option<u32>.None
    }
    value = value * 10 + digit
    index = index + 1
  }
  if value == 0 {
    return Option<u32>.None
  }
  return Option<u32>.Some { value: value }
}

fn zoom(bytes: &[u8]) -> Option<f64> {
  // SVG number parsing may tolerate surrounding SVG whitespace; CLI tokens do not.
  let mut index: usize = 0
  while index < bytes.length {
    let byte = bytes[index]
    if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
      return Option<f64>.None
    }
    index = index + 1
  }
  let parsed = svg.number(bytes)
  if let Option<f64>.Some { value } = &parsed {
    if value > 0.0 && f64.isFinite(value) {
      return Option<f64>.Some { value: value }
    }
  }
  return Option<f64>.None
}

fn validPath(bytes: &[u8]) -> bool {
  if bytes.length == 0 || equals(bytes, "-") {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if bytes[index] == 0 {
      return false
    }
    index = index + 1
  }
  return true
}

pub fn parse(args: &[Bytes]) -> Result<Parsed, ArgumentError> {
  let mut parsed = Parsed {
    action: Action.Render,
    input: args.length,
    output: args.length,
    width: 0,
    height: 0,
    zoom: 1.0,
  }
  if args.length == 1 {
    let first = Bytes.asSlice(&args[0])
    if equals(first, "--help") {
      parsed.action = Action.Help
      return Result<Parsed, ArgumentError>.succeed(move parsed)
    }
    if equals(first, "--version") {
      parsed.action = Action.Version
      return Result<Parsed, ArgumentError>.succeed(move parsed)
    }
  }
  let mut endOptions = false
  let mut seenZoom = false
  let mut index: usize = 0
  while index < args.length {
    let arg = Bytes.asSlice(&args[index])
    if !endOptions && equals(arg, "--") {
      endOptions = true
      index = index + 1
      continue
    }
    if !endOptions && (equals(arg, "--help") || equals(arg, "--version")) {
      return Result<Parsed, ArgumentError>.failResult(ArgumentError.InformationOnly)
    }
    let output = !endOptions && equals(arg, "-o")
    let width = !endOptions && equals(arg, "--width")
    let height = !endOptions && equals(arg, "--height")
    let scale = !endOptions && equals(arg, "--zoom")
    if output || width || height || scale {
      if (output && parsed.output != args.length) || (width && parsed.width != 0)
        || (height && parsed.height != 0)
        || (scale && seenZoom) {
        return Result<Parsed, ArgumentError>.failResult(ArgumentError.DuplicateOption)
      }

      // index < length proves increment cannot overflow.
      index = index + 1
      if index == args.length {
        return Result<Parsed, ArgumentError>.failResult(ArgumentError.MissingValue)
      }
      let value = Bytes.asSlice(&args[index])
      if value.length >= 2 && value[0] == 45 && value[1] == 45 {
        return Result<Parsed, ArgumentError>.failResult(ArgumentError.MissingValue)
      }
      if output {
        if !validPath(value) {
          return Result<Parsed, ArgumentError>.failResult(ArgumentError.InvalidPath)
        }
        if value[0] == 45 {
          return Result<Parsed, ArgumentError>.failResult(ArgumentError.MissingValue)
        }
        parsed.output = index
      } else if width || height {
        let number = dimension(value)
        if let Option<u32>.Some { value: size } = &number {
          if width {
            parsed.width = size
          } else {
            parsed.height = size
          }
        } else {
          return Result<Parsed, ArgumentError>.failResult(ArgumentError.InvalidDimension)
        }
      } else {
        let number = zoom(value)
        if let Option<f64>.Some { value: factor } = &number {
          parsed.zoom = factor
          seenZoom = true
        } else {
          return Result<Parsed, ArgumentError>.failResult(ArgumentError.InvalidZoom)
        }
      }
    } else {
      if !validPath(arg) {
        return Result<Parsed, ArgumentError>.failResult(ArgumentError.InvalidPath)
      }
      if !endOptions && arg[0] == 45 {
        return Result<Parsed, ArgumentError>.failResult(ArgumentError.UnknownOption)
      }
      if parsed.input != args.length {
        return Result<Parsed, ArgumentError>.failResult(ArgumentError.ExtraInput)
      }
      parsed.input = index
    }
    index = index + 1
  }
  if parsed.input == args.length {
    return Result<Parsed, ArgumentError>.failResult(ArgumentError.MissingInput)
  }
  if parsed.output == args.length {
    return Result<Parsed, ArgumentError>.failResult(ArgumentError.MissingOutput)
  }
  return Result<Parsed, ArgumentError>.succeed(move parsed)
}

pub fn message(error: ArgumentError) -> string<'static> {
  return match error {
    ArgumentError.MissingInput => "svg_cli: missing input SVG path\n"
    ArgumentError.MissingOutput => "svg_cli: output path is required (-o output.png)\n"
    ArgumentError.MissingValue => "svg_cli: option requires a value\n"
    ArgumentError.UnknownOption => "svg_cli: unknown or unimplemented option\n"
    ArgumentError.ExtraInput => "svg_cli: only one input SVG is accepted\n"
    ArgumentError.DuplicateOption => "svg_cli: option specified more than once\n"
    ArgumentError.InvalidDimension => "svg_cli: width and height must be positive decimal u32 integers\n"
    ArgumentError.InvalidZoom => "svg_cli: zoom must be a positive finite decimal number\n"
    ArgumentError.InvalidPath => "svg_cli: file paths must be nonempty; stdin and stdout PNG are unsupported\n"
    ArgumentError.InformationOnly => "svg_cli: --help and --version must be used alone\n"
  }
}
