//! CLI policy is defined in options.silk; SVG citations delimit viewport/processing scope.
import options { Parsed, Action, ArgumentError }
import options
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

// Arguments exclude argv[0], just as options.parse expects.
effect fn parse(args: &[string]) -> Result<Parsed, ArgumentError>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = List<Bytes>.make()
  let mut index: usize = 0
  while index < args.length {
    let bytes = run Bytes.copy(Intrinsic.stringUtf8Bytes(args[index]))
    run List<Bytes>.append(&mut owned, move bytes)
    index = index + 1
  }
  return options.parse(List<Bytes>.asSlice(&owned))
}

effect fn rejects(args: &[string], expected: ArgumentError) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let result = run parse(args)
  let rejected = match &result {
    Result<Parsed, ArgumentError>.Failure { error } => error == expected
    _ => false
  }
  run Testing.expect(rejected, "invalid invocation returns the specified argument error")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#InitialCoordinateSystem
// CLI policy: dimensions are positive ASCII decimal u32; zoom is a positive finite complete decimal token.
effect fn numberCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let maximum = run parse(&["in.svg", "-o", "out.png", "--width", "4294967295"])
  let accepted = match &maximum {
    Result<Parsed, ArgumentError>.Success { value } => value.width == 4294967295
    _ => false
  }
  run Testing.expect(accepted, "u32 boundary parses; renderer enforces the pixel budget")
  let badDimensions: &[string] = &[
    "",
    "0",
    "-1",
    "+1",
    "1.5",
    "1e2",
    " 2",
    "2 ",
    "2px",
    "4294967296",
    "999999999999999999999999",
  ]
  let mut index: usize = 0
  while index < badDimensions.length {
    let bad = badDimensions[index]
    run rejects(&["in.svg", "-o", "out.png", "--width", bad], ArgumentError.InvalidDimension)
    run rejects(&["in.svg", "-o", "out.png", "--height", bad], ArgumentError.InvalidDimension)
    index = index + 1
  }
  let badZooms: &[string] = &[
    "",
    "0",
    "-0",
    "-1",
    "NaN",
    "inf",
    "Infinity",
    "1e999",
    "1e-999",
    "1e",
    "1px",
    "1 2",
    " 1",
    "1 ",
  ]
  index = 0
  while index < badZooms.length {
    let bad = badZooms[index]
    run rejects(&["in.svg", "-o", "out.png", "--zoom", bad], ArgumentError.InvalidZoom)
    index = index + 1
  }
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/conform.html#processing-modes
// CLI policy: unsupported capabilities must not be silently accepted or advertised.
effect fn invocationCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty: [string; 0] = []
  run rejects(&empty, ArgumentError.MissingInput)
  run rejects(&["in.svg"], ArgumentError.MissingOutput)
  run rejects(&["-o", "out.png"], ArgumentError.MissingInput)
  let valued: &[string] = &["-o", "--width", "--height", "--zoom"]
  let mut index: usize = 0
  while index < valued.length {
    let flag = valued[index]
    run rejects(&["in.svg", flag], ArgumentError.MissingValue)
    index = index + 1
  }
  let unsupported: &[string] = &[
    "--time",
    "--fragment",
    "--mode",
    "--font-dir",
    "--bogus",
    "--width=10",
    "-x",
  ]
  index = 0
  while index < unsupported.length {
    let flag = unsupported[index]
    run rejects(&["in.svg", "-o", "out.png", flag], ArgumentError.UnknownOption)
    index = index + 1
  }
  run rejects(&["in.svg", "another.svg", "-o", "out.png"], ArgumentError.ExtraInput)
  run rejects(&["in.svg", "-o", "out.png", "-o", "other.png"], ArgumentError.DuplicateOption)
  run rejects(
    &["in.svg", "-o", "out.png", "--width", "1", "--width", "2"],
    ArgumentError.DuplicateOption,
  )
  run rejects(
    &["in.svg", "-o", "out.png", "--height", "1", "--height", "2"],
    ArgumentError.DuplicateOption,
  )
  run rejects(
    &["in.svg", "-o", "out.png", "--zoom", "1", "--zoom", "2"],
    ArgumentError.DuplicateOption,
  )
  run rejects(&["in.svg", "-o", "--width", "2"], ArgumentError.MissingValue)
  run rejects(&["in.svg", "-o", "-"], ArgumentError.InvalidPath)
  run rejects(&["-", "-o", "out.png"], ArgumentError.InvalidPath)
  run rejects(&["", "-o", "out.png"], ArgumentError.InvalidPath)
  let escaped = run parse(&["-o", "out.png", "--", "-input.svg"])
  let valid = match &escaped {
    Result<Parsed, ArgumentError>.Success { value } => value.input == 3
    _ => false
  }
  run Testing.expect(valid, "double dash permits a dash-prefixed file name")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/conform.html#processing-modes
// CLI policy: informational invocations stand alone, so unknown flags never disappear behind help.
effect fn informationCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let help = run parse(&["--help"])
  let helpOnly = match &help {
    Result<Parsed, ArgumentError>.Success { value } => value.action == Action.Help
    _ => false
  }
  run Testing.expect(helpOnly, "help does not need file paths")
  let version = run parse(&["--version"])
  let versionOnly = match &version {
    Result<Parsed, ArgumentError>.Success { value } => value.action == Action.Version
    _ => false
  }
  run Testing.expect(versionOnly, "version does not need file paths")
  run rejects(&["--help", "--bogus"], ArgumentError.InformationOnly)
  run rejects(&["in.svg", "--version"], ArgumentError.InformationOnly)
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#InitialCoordinateSystem
// https://www.w3.org/TR/2018/CR-SVG2-20181004/conform.html#processing-modes
test effect fn commandLinePolicy() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run numberCases() |> Effect.provideMut<Allocator>(&mut allocator)
  run invocationCases() |> Effect.provideMut<Allocator>(&mut allocator)
  run informationCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
