//! Allocation-free paths for the bounded table graph traversal.
import silk.ownership { Copy }
import silk.writer { Writer, WriterError }
import silk.format { Format, Display }
import silk.option { Option }
import font_types.lib { Version16Dot16, readScalar }
import read_fonts.lib { ReadError }
import dump

struct Segment { name: string<'static>, index: usize, indexed: bool, }
impl Copy for Segment {}
struct NodeKey { typ: u32, remaining: usize, args: [u64; 3], }
impl Copy for NodeKey {}
struct Node { key: NodeKey, id: usize, }
impl Copy for Node {}
fn nodeHash(key: NodeKey) -> usize {
  let mut hash = u64.wrappingMultiply(u32.toU64(key.typ), 1099511628211) ^ usize.toU64(key.remaining)
  let mut i: usize = 0
  while i < 3 { hash = u64.wrappingMultiply(hash, 1099511628211) ^ key.args[i] i = i + 1 }
  return u64.toUsize(hash & 16383)
}
fn nodeEqual(a: NodeKey, b: NodeKey) -> bool { return a.typ == b.typ && a.remaining == b.remaining && a.args[0] == b.args[0] && a.args[1] == b.args[1] && a.args[2] == b.args[2] }
pub struct DumpPath { segments: [Segment; 128], depth: usize, visits: usize, args: [u64; 3], nodes: [Node; 16384], nextNode: usize, scopeStart: usize, }
impl DumpPath {
  pub fn new(index: usize) -> Self {
    let mut value = Self { segments: [Segment { name: "", index: 0, indexed: false }; 128], depth: 1, visits: 0, args: [0; 3], nodes: [Node { key: NodeKey { typ: 0, remaining: 0, args: [0; 3] }, id: 0 }; 16384], nextNode: 1, scopeStart: 1 }
    value.segments[0] = Segment { name: "font", index: index, indexed: true }
    return move value
  }
  pub fn arguments(self: &Self) -> [u64; 3] { return self.args }
  pub fn setArguments(self: &mut Self, args: [u64; 3]) -> () { self.args = args }
  pub fn beginTable(self: &mut Self) -> () { self.scopeStart = self.nextNode self.args = [0; 3] }
  pub effect fn visit(self: &mut Self, typ: u32, remaining: usize, args: [u64; 3]) -> bool ! WriterError ? &mut Writer {
    if !DumpPath.enter(&mut self) { run scalar(&self, "traversal-limit") return false }
    let key = NodeKey { typ: typ, remaining: remaining, args: args }
    let first = nodeHash(key)
    let mut slot = first
    let mut probes: usize = 0
    while probes < 16384 && self.nodes[slot].id >= self.scopeStart {
      if nodeEqual(self.nodes[slot].key, key) {
        let id = self.nodes[slot].id
        DumpPath.push(&mut self, "ref") run scalar(&self, id) DumpPath.pop(&mut self)
        return false
      }
      slot = (slot + 1) & 16383 probes = probes + 1
    }
    // Eviction only causes a later view to be printed again; no fields are omitted.
    if probes == 16384 { slot = first }
    let id = self.nextNode
    self.nextNode = self.nextNode + 1
    self.nodes[slot] = Node { key: key, id: id }
    DumpPath.push(&mut self, "node") run scalar(&self, id) DumpPath.pop(&mut self)
    return true
  }
  pub fn enter(self: &mut Self) -> bool {
    if self.depth >= 64 || self.visits >= 10000000 { return false }
    self.visits = self.visits + 1
    return true
  }
  pub fn push(self: &mut Self, name: string<'static>) -> () {
    // Each generated node stops before depth 64, leaving room for field paths.
    if self.depth >= 128 { return Intrinsic.trap("generated dump path exceeds its static bound") }
    self.segments[self.depth] = Segment { name: name, index: 0, indexed: false }
    self.depth = self.depth + 1
  }
  pub fn pop(self: &mut Self) -> () { if self.depth > 1 { self.depth = self.depth - 1 } }
  pub fn setIndex(self: &mut Self, index: usize) -> () { self.segments[self.depth - 1].index = index self.segments[self.depth - 1].indexed = true }
  pub fn clearIndex(self: &mut Self) -> () { self.segments[self.depth - 1].indexed = false }
  pub effect fn write(self: &Self) -> () ! WriterError ? &mut Writer {
    let mut i: usize = 0
    while i < self.depth {
      if i != 0 { run Writer.writeString(".") }
      run Writer.writeString(self.segments[i].name)
      if self.segments[i].indexed { run Format.format("[{index}]", &.{ index: self.segments[i].index }) }
      i = i + 1
    }
  }
}
pub effect fn scalar<T: Display>(path: &DumpPath, value: T) -> () ! WriterError ? &mut Writer {
  run DumpPath.write(path)
  run Format.format("={value}\n", &.{ value: move value })
}
pub effect fn absent(path: &DumpPath) -> () ! WriterError ? &mut Writer { run scalar(path, "none") }
pub effect fn bytes(path: &DumpPath, data: &[u8]) -> () ! WriterError ? &mut Writer {
  run DumpPath.write(path)
  run Writer.writeString("=")
  let mut i: usize = 0
  while i < data.length { run Format.format("{value:02x}", &.{ value: data[i] }) i = i + 1 }
  run Writer.writeString("\n")
}
pub effect fn readError(path: &DumpPath, value: ReadError) -> () ! WriterError ? &mut Writer {
  run DumpPath.write(path)
  run Writer.writeString(".error=")
  run dump.error(value)
  run Writer.writeString("\n")
}
pub fn versionBits(value: Version16Dot16) -> u32 { let bytes = Version16Dot16.toBeBytes(&value) return readScalar<u32>(&bytes) |> Option<u32>.unwrapOr(0) }

pub import generated_dump_traits { DumpTable }

import silk.usize
import silk.u32
import silk.u64
