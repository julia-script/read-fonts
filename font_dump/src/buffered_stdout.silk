//! Fixed-capacity output buffering for large differential dumps.
import silk.effect { Effect }
import silk.writer { Writer, WriterError }
import silk.os_writer { StdoutWriter }
import silk.slice { Slice }

pub struct BufferedStdout {
  output: StdoutWriter,
  buffer: [u8; 65536],
  length: usize,
}

impl BufferedStdout {
  pub fn make() -> Self {
    return Self { output: StdoutWriter.make(), buffer: [0; 65536], length: 0 }
  }

  effect fn flushOutput(self: &mut Self) -> ()
    ! WriterError {
    if self.length == 0 {
      return
    }
    run Writer.writeAll(Slice.view<u8>(&self.buffer, 0, self.length))
      |> Effect.provideMut<Writer>(&mut self.output)
    self.length = 0
  }

  effect fn write(self: &mut Self, value: &[u8]) -> ()
    ! WriterError {
    if value.length > self.buffer.length - self.length {
      run BufferedStdout.flushOutput(&mut self)
    }
    if value.length > self.buffer.length {
      run Writer.writeAll(value) |> Effect.provideMut<Writer>(&mut self.output)
      return
    }
    let mut i: usize = 0
    while i < value.length {
      self.buffer[self.length + i] = value[i]
      i = i + 1
    }
    self.length = self.length + value.length
  }
}

impl Writer for BufferedStdout {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    run BufferedStdout.write(&mut self, value)
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    run BufferedStdout.flushOutput(&mut self)
  }
}
