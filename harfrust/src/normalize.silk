//! Font-aware canonical decomposition, mark ordering and recomposition.
import trace
import buffer { Buffer, Glyph, ClusterLevel, reverseRange }
import font { ConfiguredShaper, FontFuncs, NominalGlyphs, ShaperData }
import direction { Direction }
import unicode
import arabic
import font_types.lib { GlyphId }
import silk.option { Option }
import silk.u32
import silk.u8
import silk.list { List }
import silk.allocator { Allocator, OutOfMemoryError }

pub effect fn normalize<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  hasGposMark: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut allSimple = true
  let mut scan: usize = 1
  while scan < Buffer.len(&buffer.*) {
    if unicode.isMark(List<Glyph>.get(&buffer.glyphs, scan).codepoint) {
      allSimple = false
      break
    }
    scan = scan + 1
  }
  let decomposeEnabled = run trace.message(font, &buffer.*, "start decompose")
  if decomposeEnabled {
    if !buffer.dumber && buffer.script == 0x48616e67 {
      let mut j: usize = 0
      while j < Buffer.len(&buffer.*) {
        let mut item = List<Glyph>.get(&buffer.glyphs, j)
        item.info.glyphId = ConfiguredShaper.glyphOrNotdef(font, item.codepoint)
        List<Glyph>.set(&mut buffer.glyphs, j, item)
        j = j + 1
      }
      drop run trace.message(font, &buffer.*, "end decompose")
      return
    }

    // Glyphs mapped in place stay in the buffer until the first glyph that needs more work;
    // only then is the output list started, with everything before it.
    let mut output = List<Glyph>.make()
    let mut materialized = false
    let mut i: usize = 0
    while i < Buffer.len(&buffer.*) {
      if buffer.shaper == 0 {
        let mut end = i
        while end < Buffer.len(&buffer.*) {
          if unicode.isMark(List<Glyph>.get(&buffer.glyphs, end).codepoint) {
            break
          }
          if end + 1 < Buffer.len(&buffer.*)
            && unicode.isMark(List<Glyph>.get(&buffer.glyphs, end + 1).codepoint) {
            break
          }
          end = end + 1
        }
        if end > i {
          let mut mapped: usize = 0
          if true {
            let mut batch = NominalGlyphs.new(List<Glyph>.asMutSlice(&mut buffer.glyphs), i, end)
            mapped = ConfiguredShaper.nominalGlyphs(font, &mut batch)
          }
          if mapped > end - i {
            mapped = end - i
          }
          let last = i + mapped
          if !materialized {
            i = last
          }
          while i < last {
            run List<Glyph>.append(&mut output, List<Glyph>.get(&buffer.glyphs, i))
            i = i + 1
          }
          if mapped != 0 {
            continue
          }
        }
      }
      if !materialized {
        let mut kept: usize = 0
        while kept < i {
          run List<Glyph>.append(&mut output, List<Glyph>.get(&buffer.glyphs, kept))
          kept = kept + 1
        }
        materialized = true
      }
      let item = List<Glyph>.get(&buffer.glyphs, i)
      if i + 1 < Buffer.len(&buffer.*) {
        let next = List<Glyph>.get(&buffer.glyphs, i + 1)
        if unicode.isVariationSelector(next.codepoint) {
          if let Option<GlyphId>.Some { value: glyph } = ConfiguredShaper.variationGlyph(
            font,
            item.codepoint,
            next.codepoint,
          ) {
            let mut combined = item
            combined.info.glyphId = GlyphId.toU32(glyph)
            run List<Glyph>.append(&mut output, combined)
            i = i + 2
            continue
          }
          let mut base = item
          base.info.glyphId = ConfiguredShaper.glyphOrNotdef(font, item.codepoint)
          let mut selector = next
          selector.info.glyphId = ConfiguredShaper.glyphOrNotdef(font, next.codepoint)
          selector.selectorFallback = true
          if let Option<u32>.Some { value } = &buffer.notFoundVariationSelectorGlyph {
            selector.ignorable = false
          }
          run List<Glyph>.append(&mut output, base)
          run List<Glyph>.append(&mut output, selector)
          i = i + 2
          continue
        }
      }
      let mut shortest = true
      if unicode.isMark(item.codepoint)
        || (i + 1 < Buffer.len(&buffer.*)
          && unicode.isMark(List<Glyph>.get(&buffer.glyphs, i + 1).codepoint)) {
        shortest = false
      }
      if buffer.shaper != 0 {
        shortest = false
      }
      let before = List<Glyph>.length(&output)
      if !run decompose(font, &mut output, item, shortest, 0, buffer.shaper) {
        let mut mapped = item
        let mut cp = item.codepoint
        if cp == 0x2011 && !ConfiguredShaper.hasGlyph(font, cp) {
          cp = 0x2010
        }
        mapped.info.glyphId = ConfiguredShaper.glyphFor(font, cp)
        if !ConfiguredShaper.mappedGlyphExists(font, cp, mapped.info.glyphId) {
          let space = spaceType(item.codepoint)
          mapped.info.glyphId = buffer.notFoundGlyph
          if space != 0 {
            mapped.info.glyphId = ConfiguredShaper.glyphFor(font, 32)
            if !ConfiguredShaper.mappedGlyphExists(font, 32, mapped.info.glyphId) {
              mapped.info.glyphId = GlyphId.toU32(
                Buffer.getInvisibleGlyph(&buffer.*) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)),
              )
            }
            if mapped.info.glyphId != 0 {
              mapped.spaceFallback = space
            }
          }
        }
        run List<Glyph>.append(&mut output, mapped)
      }
      if before == List<Glyph>.length(&output) {
        run List<Glyph>.append(&mut output, item)
      }
      i = i + 1
    }
    if materialized {
      buffer.glyphs = move output
    }
    drop run trace.message(font, &buffer.*, "end decompose")
  } else {
    let mut n: usize = 0
    while n < Buffer.len(&buffer.*) {
      let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
      slots[n].info.glyphId = 0
      n = n + 1
    }
    allSimple = true
  }
  let mut i: usize = 0
  if !allSimple && (run trace.message(font, &buffer.*, "start reorder")) {
    // Sorting is bounded like Harfrust's MAX_COMBINING_MARKS (32).
    i = 0
    while i < Buffer.len(&buffer.*) {
      if List<Glyph>.get(&buffer.glyphs, i).combiningClass == 0 {
        i = i + 1
        continue
      }
      let mut end = i + 1
      while end < Buffer.len(&buffer.*)
        && List<Glyph>.get(&buffer.glyphs, end).combiningClass != 0 {
        end = end + 1
      }
      if end - i <= 32 {
        let mut j = i + 1
        while j < end {
          let item = List<Glyph>.get(&buffer.glyphs, j)
          let mut pos = j
          while pos > i
            && List<Glyph>.get(&buffer.glyphs, pos - 1).combiningClass > item.combiningClass {
            pos = pos - 1
          }
          if pos != j {
            Buffer.mergeClusters(&mut buffer, pos, j + 1)
            let sorted = List<Glyph>.remove(&mut buffer.glyphs, j)
            run List<Glyph>.insert(&mut buffer.glyphs, pos, sorted)
          }
          j = j + 1
        }
      }
      if !buffer.dumber && end - i <= 32 {
        run reorderMarks(&mut buffer, i, end)
      }
      i = end
    }
    drop run trace.message(font, &buffer.*, "end reorder")
  }
  i = 1
  while i + 1 < Buffer.len(&buffer.*) {
    let mut item = List<Glyph>.get(&buffer.glyphs, i)
    if item.codepoint == 0x34f {
      let next = List<Glyph>.get(&buffer.glyphs, i + 1).combiningClass
      if next == 0 || List<Glyph>.get(&buffer.glyphs, i - 1).combiningClass <= next {
        item.hidden = false
        List<Glyph>.set(&mut buffer.glyphs, i, item)
      }
    }
    i = i + 1
  }
  if allSimple || !run trace.message(font, &buffer.*, "start compose") {
    return
  }
  let mut starter: usize = 0
  i = 1
  while i < Buffer.len(&buffer.*) {
    let item = List<Glyph>.get(&buffer.glyphs, i)
    let previous = List<Glyph>.get(&buffer.glyphs, i - 1)
    if unicode.isMark(item.codepoint)
      && (previous.combiningClass < item.combiningClass || i == starter + 1) {
      let base = List<Glyph>.get(&buffer.glyphs, starter)
      let mut composed = unicode.composeRaw(base.codepoint, item.codepoint)
      if composed == 0 && !buffer.dumber && buffer.script == 0x48656272 && !hasGposMark {
        composed = hebrewCompose(base.codepoint, item.codepoint)
      }
      if (buffer.shaper == 1 || buffer.shaper == 2 || buffer.shaper == 4)
        && unicode.isMark(base.codepoint) {
        composed = 0
      }
      if buffer.shaper == 1 && base.codepoint == 0x09af && item.codepoint == 0x09bc {
        composed = 0x09df
      }
      if composed != 0 {
        let glyph = ConfiguredShaper.glyphFor(font, composed)
        if ConfiguredShaper.mappedGlyphExists(font, composed, glyph) {
          Buffer.mergeClusters(&mut buffer, starter, i + 1)
          let mut changed = List<Glyph>.get(&buffer.glyphs, starter)
          changed.codepoint = composed
          changed.info.glyphId = glyph
          List<Glyph>.set(&mut buffer.glyphs, starter, changed)
          drop List<Glyph>.remove(&mut buffer.glyphs, i)
          continue
        }
      }
    }
    if item.combiningClass == 0 {
      starter = i
    }
    i = i + 1
  }
  drop run trace.message(font, &buffer.*, "end compose")
}

effect fn decompose<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  output: &mut List<Glyph>,
  item: Glyph,
  shortest: bool,
  depth: usize,
  shaper: u32,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let glyph = ConfiguredShaper.glyphFor(font, item.codepoint)
  if shortest && ConfiguredShaper.mappedGlyphExists(font, item.codepoint, glyph) {
    let mut mapped = item
    mapped.info.glyphId = glyph
    run List<Glyph>.append(&mut output, mapped)
    return true
  }
  let mut parts = unicode.decomposeRaw(item.codepoint)
  if shaper == 1
    && (item.codepoint == 0x0931 || item.codepoint == 0x09dc || item.codepoint == 0x09dd
      || item.codepoint == 0x0b94) {
    parts.first = 0
  }
  if shaper == 2
    && (item.codepoint == 0x17be || item.codepoint == 0x17bf || item.codepoint == 0x17c0
      || item.codepoint == 0x17c4
      || item.codepoint == 0x17c5) {
    parts.first = 0x17c1
    parts.second = item.codepoint
  }
  if parts.first != 0 && depth < 32
    && (parts.second == 0 || ConfiguredShaper.hasGlyph(font, parts.second)) {
    let mut first = item
    first.codepoint = parts.first
    first.combiningClass = unicode.modifiedCombiningClass(parts.first)
    if run decompose(font, &mut output, first, shortest, depth + 1, shaper) {
      if parts.second != 0 {
        let mut second = item
        second.codepoint = parts.second
        second.info.glyphId = ConfiguredShaper.glyphFor(font, parts.second)
        second.combiningClass = unicode.modifiedCombiningClass(parts.second)
        run List<Glyph>.append(&mut output, second)
      }
      return true
    }
  }
  if ConfiguredShaper.mappedGlyphExists(font, item.codepoint, glyph) {
    let mut mapped = item
    mapped.info.glyphId = glyph
    run List<Glyph>.append(&mut output, mapped)
    return true
  }
  return false
}

pub fn formClusters(buffer: &mut Buffer) -> () {
  let mut start: usize = 0
  let mut previousContinuation = false
  let mut i: usize = 1
  while i <= Buffer.len(&buffer.*) {
    let mut continuation = false
    if i < Buffer.len(&buffer.*) {
      let cp = List<Glyph>.get(&buffer.glyphs, i).codepoint
      let prev = List<Glyph>.get(&buffer.glyphs, i - 1).codepoint
      continuation = unicode.isMark(cp) || cp == 0x200d || (cp >= 0x1f3fb && cp <= 0x1f3ff)
        || (prev == 0x200d && unicode.isExtendedPictographic(cp))
        || (cp >= 0xe0020 && cp <= 0xe007f)
        || (cp >= 0xff9e && cp <= 0xff9f)
        || (cp >= 0x1f1e6 && cp <= 0x1f1ff && prev >= 0x1f1e6 && prev <= 0x1f1ff
          && !previousContinuation)
    }
    if i < Buffer.len(&buffer.*) {
      let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
      slots[i].continuation = continuation
    }
    if !continuation {
      Buffer.mergeGraphemeClusters(&mut buffer, start, i)
      start = i
    }
    previousContinuation = continuation
    i = i + 1
  }
}

pub fn nativeDirection(buffer: &mut Buffer) -> () {
  let mut rtl = unicode.isRtl(buffer.script)
  if rtl && buffer.direction == Direction.LeftToRight {
    let mut number = false
    let mut letter = false
    let mut i: usize = 0
    while i < Buffer.len(&buffer.*) {
      let cp = List<Glyph>.get(&buffer.glyphs, i).codepoint
      let gc = unicode.generalCategory(cp)
      number = number || gc == 13 || (cp >= 0x1f1e6 && cp <= 0x1f1ff)
      letter = letter || (gc >= 5 && gc <= 9)
      i = i + 1
    }
    if number && !letter {
      rtl = false
    }
  }
  let directionless = buffer.script == 0x48756e67 || buffer.script == 0x4974616c
    || buffer.script == 0x52756e72
    || buffer.script == 0x54666e67
  let reverse = (Direction.isHorizontal(buffer.direction) && !directionless
    && (buffer.direction == Direction.RightToLeft) != rtl)
    || buffer.direction == Direction.BottomToTop
  if reverse {
    let length = Buffer.len(&buffer.*)
    let mut start: usize = 0
    let mut i: usize = 1
    while i <= length {
      if i == length || !List<Glyph>.get(&buffer.glyphs, i).continuation {
        reverseRange(&mut buffer.glyphs, start, i)
        start = i
      }
      i = i + 1
    }
    Buffer.reverse(&mut buffer)
    buffer.direction = Direction.reverse(buffer.direction)
  }
}

pub fn spaceType(cp: u32) -> u8 {
  return match cp {
    0x20 => 32
    0xa0 => 32
    0x2000 => 2
    0x2001 => 1
    0x2002 => 2
    0x2003 => 1
    0x2004 => 3
    0x2005 => 4
    0x2006 => 6
    0x2007 => 33
    0x2008 => 34
    0x2009 => 5
    0x200a => 16
    0x202f => 35
    0x205f => 36
    0x3000 => 1
    _ => 0
  }
}

effect fn reorderMarks(buffer: &mut Buffer, start: usize, end: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if arabic.usesScript(buffer.script) {
    let mut from = start
    let mut i = start
    let mut cc: u8 = 220
    while cc <= 230 {
      while i < end && List<Glyph>.get(&buffer.glyphs, i).combiningClass < cc {
        i = i + 1
      }
      let mut j = i
      while j < end {
        let item = List<Glyph>.get(&buffer.glyphs, j)
        if item.combiningClass != cc || !modifierMark(item.codepoint) {
          break
        }
        j = j + 1
      }
      if i != j {
        Buffer.mergeClusters(&mut buffer, from, j)
        let count = j - i
        let mut n: usize = 0
        while n < count {
          let mut item = List<Glyph>.remove(&mut buffer.glyphs, i + n)
          item.combiningClass = 22
          if cc == 230 {
            item.combiningClass = 26
          }
          run List<Glyph>.insert(&mut buffer.glyphs, from + n, item)
          n = n + 1
        }
        from = from + count
        i = j
      }
      cc = cc + 10
    }
  } else if buffer.script == 0x48656272 {
    let mut i = start
    while i + 2 < end {
      let a = List<Glyph>.get(&buffer.glyphs, i).combiningClass
      let b = List<Glyph>.get(&buffer.glyphs, i + 1).combiningClass
      let c = List<Glyph>.get(&buffer.glyphs, i + 2).combiningClass
      if (a == unicode.modifiedCombiningClass(0x5b7) || a == unicode.modifiedCombiningClass(0x5b8))
        && (b == unicode.modifiedCombiningClass(0x5b0)
          || b == unicode.modifiedCombiningClass(0x5b4))
        && (c == 22 || c == 220) {
        Buffer.mergeClusters(&mut buffer, i + 1, i + 3)
        reverseRange(&mut buffer.glyphs, i + 1, i + 3)
        break
      }
      i = i + 1
    }
  }
}

fn modifierMark(cp: u32) -> bool {
  return cp == 0x654 || cp == 0x655 || cp == 0x658 || cp == 0x6dc || cp == 0x6e3 || cp == 0x6e7
    || cp == 0x6e8
    || cp == 0x8ca
    || cp == 0x8cb
    || cp == 0x8cd
    || cp == 0x8ce
    || cp == 0x8cf
    || cp == 0x8d3
    || cp == 0x8f3
}

// Presentation forms deliberately excluded from Unicode NFC, needed by older
// Hebrew fonts without OpenType mark positioning.
pub fn hebrewCompose(a: u32, b: u32) -> u32 {
  if b == 0x05b4 && a == 0x05d9 {
    return 0xfb1d
  }
  if b == 0x05b7 {
    if a == 0x05d9 {
      return 0xfb1f
    }
    if a == 0x05d0 {
      return 0xfb2e
    }
  }
  if b == 0x05b8 && a == 0x05d0 {
    return 0xfb2f
  }
  if b == 0x05b9 && a == 0x05d5 {
    return 0xfb4b
  }
  if b == 0x05bc {
    if a >= 0x05d0 && a <= 0x05ea {
      let forms: [u32; 27] = [
        0xfb30,
        0xfb31,
        0xfb32,
        0xfb33,
        0xfb34,
        0xfb35,
        0xfb36,
        0,
        0xfb38,
        0xfb39,
        0xfb3a,
        0xfb3b,
        0xfb3c,
        0,
        0xfb3e,
        0,
        0xfb40,
        0xfb41,
        0,
        0xfb43,
        0xfb44,
        0,
        0xfb46,
        0xfb47,
        0xfb48,
        0xfb49,
        0xfb4a,
      ]
      return forms[u32.toUsize(a - 0x05d0)]
    }
    if a == 0xfb2a {
      return 0xfb2c
    }
    if a == 0xfb2b {
      return 0xfb2d
    }
  }
  if b == 0x05bf {
    if a == 0x05d1 {
      return 0xfb4c
    }
    if a == 0x05db {
      return 0xfb4d
    }
    if a == 0x05e4 {
      return 0xfb4e
    }
  }
  if b == 0x05c1 {
    if a == 0x05e9 {
      return 0xfb2a
    }
    if a == 0xfb49 {
      return 0xfb2c
    }
  }
  if b == 0x05c2 {
    if a == 0x05e9 {
      return 0xfb2b
    }
    if a == 0xfb49 {
      return 0xfb2d
    }
  }
  return 0
}
