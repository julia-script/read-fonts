//! Checked, table-relative reads. Invalid offsets yield an empty view.
import read_fonts.lib { FontData, ReadError }
import read_fonts.tables.layout { CoverageTable, ClassDef }
import font_types.lib { GlyphId }
import silk.ownership { Copy }
import silk.option { Option }
import silk.result { Result }
import silk.u8
import silk.u16
import silk.u32
import silk.usize

pub struct View<'a> {
  pub data: FontData<'a>,
}

impl<'a> Copy for View<'a> {}

impl<'a> View<'a> {
  pub fn bytes(data: &'a [u8]) -> Self {
    return Self { data: FontData.new(data) }
  }

  pub fn new(data: FontData<'a>) -> Self {
    return Self { data: data }
  }

  pub fn empty() -> Self {
    return View.new(FontData.new(b""))
  }

  pub fn len(self: &Self) -> usize {
    return FontData.len(&self.data)
  }

  pub fn u8(self: &Self, at: usize) -> u8 {
    return FontData<'a>.readAt<u8>(&self.data, at) |> Result<u8, ReadError>.unwrapOr(0)
  }

  pub fn u16(self: &Self, at: usize) -> u16 {
    return FontData<'a>.readAt<u16>(&self.data, at) |> Result<u16, ReadError>.unwrapOr(0)
  }

  pub fn uint(self: &Self, at: usize, width: usize) -> u32 {
    if width == 2 {
      return u16.toU32(View.u16(self, at))
    }
    if width == 4 {
      return View.u32(self, at)
    }
    if width != 3 || offset(at, 1, 3) > View.len(self) {
      return 0
    }
    return u16.toU32(View.u16(self, at)) * 256 + u8.toU32(View.u8(self, at + 2))
  }

  pub fn offset(self: &Self, at: usize, width: usize) -> Self {
    let value = View.uint(self, at, width)
    if value == 0 {
      return View.empty()
    }
    return View.tail(self, u32.toUsize(value))
  }

  // Version 1.2's optional 32-bit lists override the original 16-bit lists.
  pub fn layoutList(self: &Self, index: usize) -> Self {
    if View.u16(self, 0) == 1 && View.u16(self, 2) >= 2 && View.u32(self, 14 + index * 4) != 0 {
      return View.offset32(self, 14 + index * 4)
    }
    return View.offset16(self, 4 + index * 2)
  }

  pub fn i16(self: &Self, at: usize) -> i16 {
    return FontData<'a>.readAt<i16>(&self.data, at) |> Result<i16, ReadError>.unwrapOr(0)
  }

  pub fn u32(self: &Self, at: usize) -> u32 {
    return FontData<'a>.readAt<u32>(&self.data, at) |> Result<u32, ReadError>.unwrapOr(0)
  }

  pub fn i32(self: &Self, at: usize) -> i32 {
    return FontData<'a>.readAt<i32>(&self.data, at) |> Result<i32, ReadError>.unwrapOr(0)
  }

  pub fn range(self: &Self, start: usize, end: usize) -> Self {
    return View.new(
      FontData.slice(&self.data, start, end) |> Option<FontData<'a>>.unwrapOr(FontData.new(b"")),
    )
  }

  /// Optional GDEF 1.4 offsets override the original class/attachment lists.
  pub fn gdefVarStore(self: &Self) -> Self {
    if View.u16(self, 0) != 1 || View.u16(self, 2) < 3 {
      return View.empty()
    }
    return View.offset32(self, 14)
  }

  pub fn gdefList(self: &Self, index: usize) -> Self {
    if View.u16(self, 0) == 1 && View.u16(self, 2) >= 4 && View.u32(self, 18 + index * 4) != 0 {
      return View.offset32(self, 18 + index * 4)
    }
    if index == 4 && View.u16(self, 2) < 2 {
      return View.empty()
    }
    return View.offset16(self, 4 + index * 2)
  }

  pub fn tail(self: &Self, at: usize) -> Self {
    return View.new(
      FontData.slice(&self.data, at, View.len(self))
        |> Option<FontData<'a>>.unwrapOr(FontData.new(b"")),
    )
  }

  pub fn offset16(self: &Self, at: usize) -> Self {
    let offset = View.u16(self, at)
    if offset == 0 {
      return View.empty()
    }
    return View.tail(self, u16.toUsize(offset))
  }

  pub fn offset32(self: &Self, at: usize) -> Self {
    let offset = View.u32(self, at)
    if offset == 0 {
      return View.empty()
    }
    return View.tail(self, u32.toUsize(offset))
  }

  pub fn coverage(self: &Self, glyph: u32) -> Option<u32> {
    let format = View.u16(self, 0)
    if format < 1 || format > 4 {
      return Option<u32>.None
    }
    let mut width: usize = 2
    if format >= 3 {
      width = 3
    }
    let header = 2 + width
    let count = u32.toUsize(View.uint(self, 2, width))
    let mut stride = width
    if format == 2 || format == 4 {
      stride = width * 3
    }
    if header > View.len(self) || count > (View.len(self) - header) / stride {
      return Option<u32>.None
    }
    let mut lo: usize = 0
    let mut hi = count
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let at = header + mid * stride
      let start = View.uint(self, at, width)
      if glyph < start {
        hi = mid
      } else {
        if stride == width {
          if glyph == start {
            return Option<u32>.some(usize.toU32(mid))
          }
        } else if glyph <= View.uint(self, at + width, width) {
          return Option<u32>.some(View.uint(self, at + width * 2, width) + glyph - start)
        }
        lo = mid + 1
      }
    }
    return Option<u32>.None
  }

  pub fn class(self: &Self, glyph: u32) -> u32 {
    let format = View.u16(self, 0)
    if format < 1 || format > 4 {
      return 0
    }
    let mut width: usize = 2
    if format >= 3 {
      width = 3
    }
    if format == 1 || format == 3 {
      let start = View.uint(self, 2, width)
      let count = View.uint(self, 2 + width, width)
      if glyph < start || glyph - start >= count {
        return 0
      }
      let header = 2 + width * 2
      if header > View.len(self) || u32.toUsize(count) > (View.len(self) - header) / width {
        return 0
      }
      return View.uint(self, header + u32.toUsize(glyph - start) * width, width)
    }
    let header = 2 + width
    let stride = width * 2 + 2
    let count = u32.toUsize(View.uint(self, 2, width))
    if header > View.len(self) || count > (View.len(self) - header) / stride {
      return 0
    }
    let mut lo: usize = 0
    let mut hi = count
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let at = header + mid * stride
      let start = View.uint(self, at, width)
      if glyph < start {
        hi = mid
      } else {
        if glyph <= View.uint(self, at + width, width) {
          return u16.toU32(View.u16(self, at + width * 2))
        }
        lo = mid + 1
      }
    }
    return 0
  }
}

pub fn offset(base: usize, index: usize, size: usize) -> usize with Intrinsic.inlineAlways() {
  return usize.saturatingAdd(base, usize.saturatingMultiply(index, size))
}
