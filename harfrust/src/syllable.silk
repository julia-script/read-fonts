//! Shared interpreter for the pinned Ragel syllable machines.
import generated_machines as data
import buffer { Buffer, Glyph }
import view { View }
import unicode
import silk.list { List }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.u8
import silk.u16
import silk.u32
import silk.i32
import silk.usize

pub fn indicCategory(cp: u32) -> u16 {
  let d = View.bytes(data.indicData())
  let mut index: usize = 37
  if cp < 71396 {
    let u = u32.toUsize(cp)
    let nibble = u / 512
    let mut a = u8.toUsize(View.u8(&d, nibble / 2))
    if (nibble & 1) != 0 {
      a = a / 16
    }
    a = (a & 15) * 8 + ((u / 64) & 7)
    a = u8.toUsize(View.u8(&d, 70 + a)) * 8 + ((u / 8) & 7)
    a = u8.toUsize(View.u8(&d, 186 + a)) * 4 + ((u / 2) & 3)
    a = u8.toUsize(View.u8(&d, 488 + a)) + (u & 1)
    index = u8.toUsize(View.u8(&d, 996 + a))
  }
  return View.u16(&View.bytes(data.indicValues()), index * 2)
}

pub fn useCategory(cp: u32) -> u8 {
  if cp >= 921600 {
    return 0
  }
  let d = View.bytes(data.use_u8())
  let wide = View.bytes(data.use_u16())
  let u = u32.toUsize(cp)
  let nibble = u / 4096
  let mut a = u8.toUsize(View.u8(&d, nibble / 2))
  if (nibble & 1) != 0 {
    a = a / 16
  }
  a = (a & 15) * 32 + ((u / 128) & 31)
  a = u8.toUsize(View.u8(&d, 113 + a)) * 8 + ((u / 16) & 7)
  a = u16.toUsize(View.u16(&wide, a * 2)) + ((u / 2) & 7)
  a = u8.toUsize(View.u8(&d, 625 + a)) * 2 + (u & 1)
  return View.u8(&d, 2969 + a)
}

pub fn universal(script: u32) -> bool {
  let data = View.bytes(data.universalScripts())
  let mut i: usize = 0
  while i < View.len(&data) {
    if View.u32(&data, i) == script {
      return true
    }
    i = i + 4
  }
  return false
}

pub fn next(buffer: &Buffer, start: usize) -> usize {
  if start >= Buffer.len(buffer) {
    return Buffer.len(buffer)
  }
  let syllable = List<Glyph>.get(&buffer.glyphs, start).syllable
  let mut end = start + 1
  while end < Buffer.len(buffer) && List<Glyph>.get(&buffer.glyphs, end).syllable == syllable {
    end = end + 1
  }
  return end
}

pub effect fn find(buffer: &mut Buffer, machine: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut states = View.bytes(data.indicStates())
  let mut transitions = View.bytes(data.indicTransitions())
  let mut actions = View.bytes(data.indicActions())
  if machine == 2 {
    states = View.bytes(data.khmerStates())
    transitions = View.bytes(data.khmerTransitions())
    actions = View.bytes(data.khmerActions())
  }
  if machine == 3 {
    states = View.bytes(data.myanmarStates())
    transitions = View.bytes(data.myanmarTransitions())
    actions = View.bytes(data.myanmarActions())
  }
  if machine == 4 {
    states = View.bytes(data.useStates())
    transitions = View.bytes(data.useTransitions())
    actions = View.bytes(data.useActions())
  }
  let stateCount = (View.len(&states) - 4) / 2
  let mut indices = List<usize>.make()
  let length = Buffer.len(&buffer.*)
  if length > 1048576 {
    return
  }
  let mut i: usize = 0
  while i < length {
    let item = List<Glyph>.get(&buffer.glyphs, i)
    let mut include = true
    if machine == 4 {
      include = item.category != 6
      if item.category == 14 {
        let mut j = i + 1
        while j < length {
          let other = List<Glyph>.get(&buffer.glyphs, j)
          if other.category != 6 {
            include = !unicode.isMark(other.codepoint)
            break
          }
          j = j + 1
        }
      }
    }
    if include {
      run List<usize>.append(&mut indices, i)
    }
    i = i + 1
  }
  let len = usize.toI32(List<usize>.length(&indices))
  run List<usize>.append(&mut indices, length)
  let mut p: i32 = 0
  let mut ts: i32 = 0
  let mut te: i32 = 0
  let mut act: u8 = 0
  let mut state = u16.toUsize(View.u16(&states, 0))
  let mut serial: u32 = 1
  let mut budget = length * 8 + 16
  while p <= len && budget != 0 {
    budget = budget - 1
    if state >= stateCount || p < 0 {
      break
    }
    if View.u8(&states, 4 + state) != 0 {
      ts = p
    }
    let mut category: usize = 59
    if p < len {
      category = u8.toUsize(
        List<Glyph>.get(&buffer.glyphs, List<usize>.get(&indices, i32.toUsize(p))).category,
      )
      if category >= 59 {
        category = 0
      }
    }
    let pos = (state * 60 + category) * 4
    state = u16.toUsize(View.u16(&transitions, pos))
    let mut pc = u16.toUsize(View.u16(&transitions, pos + 2))
    while pc < View.len(&actions) {
      let op = View.u8(&actions, pc)
      if op == 0 {
        break
      }
      let arg = View.u8(&actions, pc + 1)
      pc = pc + 2
      if op == 1 {
        te = p + 1
      }
      if op == 2 {
        te = p
      }
      if op == 3 {
        p = p - 1
      }
      if op == 4 {
        p = te - 1
      }
      if op == 5 {
        act = arg
      }
      if op == 6 && ts >= 0 && ts < te && te <= len {
        let start = List<usize>.get(&indices, i32.toUsize(ts))
        let end = List<usize>.get(&indices, i32.toUsize(te))
        i = start
        while i < end {
          let mut glyph = List<Glyph>.get(&buffer.glyphs, i)
          glyph.syllable = serial * 16 + u8.toU32(arg)
          List<Glyph>.set(&mut buffer.glyphs, i, glyph)
          i = i + 1
        }
        serial = serial + 1
        if serial == 16 {
          serial = 1
        }
        Buffer.unsafeToBreak(&mut buffer, start, end)
      }
      if op == 7 {
        let skip = u8.toUsize(View.u8(&actions, pc))
        pc = pc + 1
        if act != arg {
          pc = pc + skip
        }
      }
    }
    if p == len {
      break
    }
    if View.u8(&states, 4 + stateCount + state) != 0 {
      ts = 0
    }
    p = p + 1
  }
}
