//! Bounded OpenType lookup execution. Subtables borrow checked font views.
import silk.slice { Slice }
import trace
import view { View, read16, offset }
import set_digest { SetDigest }
import buffer { Buffer, Glyph, GlyphPosition }
import font { ConfiguredShaper, FontFuncs, Shaper }
import plan { OtPlan, LookupStep, LookupSubtable, ClassTable, featureValue }
import feature { Feature }
import arabic
import complex
import preprocess
import scale { Scale, add, sub, clamp }
import direction { Direction }
import font_types.lib { F2Dot14, F48Dot16 }
import read_fonts.lib { ReadError, FontData }
import read_fonts.tables.variations { ItemVariationStore, DeltaSetIndex }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.ownership { Copy }
import silk.list { List }
import silk.option { Option }
import silk.result { Result }
import silk.u16
import silk.u32
import silk.i16
import silk.i32
import silk.i64
import silk.usize
import silk.u8
import silk.u64

struct Context<'a, 's> {
  savedInput: List<Glyph>,
  haveSavedInput: bool,
  table: View<'a>,
  gdef: View<'a>,
  scale: Scale,
  coords: &'s [F2Dot14],
  features: &'s [Feature],
  steps: &'s [LookupStep],
  positioning: bool,
  autoZwj: bool,
  autoZwnj: bool,
  randomState: u32,
  budget: usize,
  maxLength: usize,
  ligatureId: u32,
  shaper: u32,
  restrictSyllable: bool,
  // Ligature component positions, reused so each candidate ligature skips a 512-byte memset.
  positions: [usize; 64],
  classTables: &'s [ClassTable],
  classValues: &'s [u16],
  /// Per rule set digests of contextual subtables' second input values (`OtPlan.ruleDigests`).
  ruleDigests: &'s [u64],
  /// Expanded starting coverages of the plan's subtables (`OtPlan.coverageValues`).
  coverageValues: &'s [u16],
  /// Contextual input positions, 64 per lookup nesting depth.
  positionStack: List<usize>,
  glyphClasses: Classes<'a, 's>,
  markAttachClasses: Classes<'a, 's>,
  /// GDEF's variation store, read once; None without variation coordinates, as in harfrust.
  varStore: Option<ItemVariationStore<'a>>,
}

/// A class definition, expanded to one class per glyph when the plan holds it.
struct Classes<'a, 's> {
  view: View<'a>,
  first: u32,
  values: &'s [u16],
}

impl<'a, 's> Copy for Classes<'a, 's> {}

fn noClasses<'a, 's>(context: &Context<'a, 's>) -> Classes<'a, 's> {
  return Classes { view: View.empty(), first: 0, values: Slice.view(context.classValues, 0, 0) }
}

/// Finds the plan's expansion of the class definition `view`, which must lie in the layout table.
fn classesFor<'a, 's>(context: &Context<'a, 's>, view: View<'a>) -> Classes<'a, 's> {
  let offset = View.len(&context.table) - View.len(&view)
  let tables = context.classTables
  let mut lo: usize = 0
  let mut hi = tables.length
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if tables[mid].offset < offset {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < tables.length && tables[lo].offset == offset {
    let table = tables[lo]
    return Classes {
      view: view,
      first: table.first,
      values: Slice.view(context.classValues, table.start, table.count),
    }
  }
  return Classes { view: view, first: 0, values: Slice.view(context.classValues, 0, 0) }
}

fn gdefClasses<'a, 's>(
  plan: &'s OtPlan<'a>,
  gdef: View<'a>,
  list: usize,
  table: ClassTable,
) -> Classes<'a, 's,> {
  return Classes {
    view: View.gdefList(&gdef, list),
    first: table.first,
    values: Slice.view(List<u16>.asSlice(&plan.classValues), table.start, table.count),
  }
}

/// The GDEF glyph class of `glyph`, using the plan's expansion when it has one.
pub fn gdefGlyphClass<'a>(plan: &OtPlan<'a>, gdef: View<'a>, glyph: u32) -> u32 {
  return classOf(&gdefClasses(plan, gdef, 0, plan.glyphClasses), glyph)
}

fn classOf(classes: &Classes, glyph: u32) -> u32 with Intrinsic.inlineAlways() {
  if classes.values.length == 0 {
    return View.class(&classes.view, glyph)
  }
  if glyph < classes.first {
    return 0
  }
  let index = u32.toUsize(glyph - classes.first)
  if index >= classes.values.length {
    return 0
  }
  return u16.toU32(classes.values[index])
}

struct Lookup<'a> {
  table: View<'a>,
  kind: u16,
  flags: u16,
  markSet: u16,
}

impl<'a> Copy for Lookup<'a> {}

struct Applied {
  yes: bool,
  next: usize,
}

impl Copy for Applied {}

fn no() -> Applied {
  return Applied { yes: false, next: 0 }
}

fn yes(next: usize) -> Applied {
  return Applied { yes: true, next: next }
}

pub effect fn apply<'a, 's, F: FontFuncs>(
  font: &ConfiguredShaper<'a, 's, F>,
  buffer: &mut Buffer,
  plan: &OtPlan<'a>,
  features: &[Feature],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut tableStart = "start table GSUB"
  let mut tableEnd = "end table GSUB"
  if plan.positioning {
    tableStart = "start table GPOS"
    tableEnd = "end table GPOS"
  }
  if !run trace.table(font, &buffer.*, tableStart, plan.chosenScript) {
    return
  }
  let steps = List<LookupStep>.asSlice(&plan.steps)
  let length = Buffer.len(&buffer.*)
  let maxLength = buffer.maxLength
  let mut context = Context {
    savedInput: List<Glyph>.make(),
    haveSavedInput: false,
    table: plan.table,
    gdef: font.data.gdef,
    scale: font.scale,
    coords: List<F2Dot14>.asSlice(&font.coords),
    features: features,
    steps: steps,
    positioning: plan.positioning,
    autoZwj: true,
    autoZwnj: true,
    randomState: 1,
    budget: usize.saturatingMultiply(buffer.maxOperations, 64),
    maxLength: maxLength,
    ligatureId: 0,
    shaper: buffer.shaper,
    restrictSyllable: false,
    positions: [0; 64],
    positionStack: List<usize>.make(),
    classTables: List<ClassTable>.asSlice(&plan.classTables),
    classValues: List<u16>.asSlice(&plan.classValues),
    ruleDigests: List<u64>.asSlice(&plan.ruleDigests),
    coverageValues: List<u16>.asSlice(&plan.coverageValues),
    glyphClasses: gdefClasses(plan, font.data.gdef, 0, plan.glyphClasses),
    markAttachClasses: gdefClasses(plan, font.data.gdef, 3, plan.markAttachClasses),
    varStore: readVarStore(font.data.gdef, List<F2Dot14>.length(&font.coords)),
  }
  let mut step: usize = 0
  let mut stage: u32 = 0
  let mut stageLimit: u32 = 1
  if buffer.shaper != 0 {
    stageLimit = 15
  }
  if arabic.usesScript(buffer.script) && stageLimit < 13 {
    stageLimit = 13
  }
  if steps.length > 0 && steps[steps.length - 1].stage + 1 > stageLimit {
    stageLimit = steps[steps.length - 1].stage + 1
  }

  // A digest of the buffer's glyphs lets a lookup that cannot apply to any of them skip the
  // glyph walk. Positioning never changes glyphs, so only substitution refreshes it.
  let mut glyphDigest = SetDigest.new()
  let mut digestStale = true
  while stage < stageLimit && context.budget != 0 && buffer.successful {
    if !plan.positioning {
      run complex.pause(font, &mut buffer, plan, stage, features)
      digestStale = true
    }
    context.restrictSyllable = !plan.positioning && buffer.shaper != 0
    while step < steps.length && steps[step].stage == stage && context.budget != 0
      && buffer.successful {
      let mut end = step + 1
      while end < steps.length && steps[end].index == steps[step].index
        && steps[end].stage == steps[step].stage {
        end = end + 1
      }
      context.haveSavedInput = false
      List<Glyph>.clear(&mut context.savedInput)
      let tag = steps[step].tag
      let mut messageTag = tag
      if steps[step].required {
        messageTag = 0
      }
      if !run trace.lookup(
        font,
        &buffer.*,
        "start lookup ",
        u16.toUsize(steps[step].index),
        messageTag,
        "",
      ) {
        step = end
        continue
      }
      context.restrictSyllable = !plan.positioning && complex.perSyllable(buffer.shaper, tag)
      context.autoZwj = true
      context.autoZwnj = true
      let common = tag == 0x63636d70 || tag == 0x6c6f636c
      if buffer.shaper != 0 && !common && tag != 0x7276726e {
        context.autoZwj = false
        if buffer.shaper == 1 || buffer.shaper == 2 {
          context.autoZwnj = false
        }
      }
      if arabic.usesScript(buffer.script)
        && (common || arabic.isFeature(tag) || tag == 0x726c6967 || tag == 0x63616c74
        || tag == 0x6c696761
        || tag == 0x636c6967
        || tag == 0x6d736574) {
        context.autoZwj = false
      }
      let lookup = lookupAt(&context, steps[step].lookupOffset)
      let subtables = Slice.view(
        List<LookupSubtable>.asSlice(&plan.subtables),
        steps[step].firstSubtable,
        steps[step].subtableCount,
      )
      if digestStale {
        glyphDigest = bufferDigest(&buffer.*)
        digestStale = false
      }
      if !SetDigest.mayIntersect(&steps[step].digest, &glyphDigest) {
        // Nothing in the buffer is covered.
      } else if lookup.kind == 8 && !context.positioning {
        digestStale = true
        let mut i = Buffer.len(&buffer.*)
        while i > 0 && context.budget != 0 && buffer.successful {
          i = i - 1
          let glyph = &List<Glyph>.asSlice(&buffer.glyphs)[i]
          if SetDigest.mayHave(&steps[step].digest, glyph.info.glyphId)
            && enabled(&context, glyph, step, end) > 0 {
            drop run applyLookup(
              font,
              &mut context,
              &mut buffer,
              lookup,
              subtables,
              i,
              step,
              end,
              0,
            )
          }
        }
      } else {
        let mut i: usize = 0
        while i < Buffer.len(&buffer.*) && context.budget != 0 && buffer.successful {
          i = nextCandidate(List<Glyph>.asSlice(&buffer.glyphs), i, &steps[step].digest)
          if i >= Buffer.len(&buffer.*) {
            break
          }
          let mut result = no()
          let glyph = &List<Glyph>.asSlice(&buffer.glyphs)[i]
          if enabled(&context, glyph, step, end) > 0 {
            result = run applyLookup(
              font,
              &mut context,
              &mut buffer,
              lookup,
              subtables,
              i,
              step,
              end,
              0,
            )
          }
          if result.yes {
            if !context.positioning {
              digestStale = true
            }
            i = result.next
          } else {
            i = i + 1
          }
        }
      }
      if !buffer.successful && context.haveSavedInput {
        digestStale = true
        buffer.glyphs = move context.savedInput
        context.savedInput = List<Glyph>.make()
        context.haveSavedInput = false
      }
      drop run trace.lookup(
        font,
        &buffer.*,
        "end lookup ",
        u16.toUsize(steps[step].index),
        messageTag,
        "",
      )
      step = end
    }
    stage = stage + 1
  }
  if context.budget == 0 {
    buffer.successful = false
  }
  drop run trace.table(font, &buffer.*, tableEnd, plan.chosenScript)
}

/// The first glyph from `from` that `digest` may hold, or the buffer's length. Kept apart from
/// `apply` so the scan over glyphs a lookup cannot start at stays a tight loop.
fn nextCandidate(glyphs: &[Glyph], from: usize, digest: &SetDigest) -> usize {
  let mut i = from
  while i < glyphs.length && !SetDigest.mayHave(digest, glyphs[i].info.glyphId) {
    i = i + 1
  }
  return i
}

fn bufferDigest(buffer: &Buffer) -> SetDigest {
  let mut digest = SetDigest.new()
  let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
  let mut i: usize = 0
  while i < glyphs.length {
    SetDigest.add(&mut digest, glyphs[i].info.glyphId)
    i = i + 1
  }
  return digest
}

/// The lookup at a plan step's cached offset.
fn lookupAt<'a, 's>(context: &Context<'a, 's>, offset: usize) -> Lookup<'a> {
  let table = View.tail(&context.table, offset)
  return Lookup {
    table: table,
    kind: View.u16(&table, 0),
    flags: View.u16(&table, 2),
    markSet: View.u16(&table, 6 + u16.toUsize(View.u16(&table, 4)) * 2),
  }
}

fn getLookup<'a, 's>(context: &Context<'a, 's>, index: u16) -> Lookup<'a> {
  let list = View.layoutList(&context.table, 2)
  let mut width: usize = 2
  if View.u16(&context.table, 0) == 1 && View.u16(&context.table, 2) >= 2
    && View.u32(&context.table, 22) != 0 {
    width = 4
  }
  let mut table = View.tail(&context.table, View.len(&context.table))
  if index < View.u16(&list, 0) {
    table = View.offset(&list, 2 + u16.toUsize(index) * width, width)
  }
  return Lookup {
    table: table,
    kind: View.u16(&table, 0),
    flags: View.u16(&table, 2),
    markSet: View.u16(&table, 6 + u16.toUsize(View.u16(&table, 4)) * 2),
  }
}

pub effect fn wouldSubstitute<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  plan: &OtPlan,
  tag: u32,
  glyphs: &[u32],
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let steps = List<LookupStep>.asSlice(&plan.steps)

  // Shapers probe many glyph pairs per run; most fail every step's digest.
  let mut candidate = false
  let mut k: usize = 0
  while k < steps.length && !candidate {
    candidate = steps[k].tag == tag && glyphs.length != 0
      && SetDigest.mayHave(&steps[k].digest, glyphs[0])
    k = k + 1
  }
  if !candidate {
    return false
  }
  let mut context = Context {
    savedInput: List<Glyph>.make(),
    haveSavedInput: false,
    table: plan.table,
    gdef: font.data.gdef,
    scale: font.scale,
    coords: List<F2Dot14>.asSlice(&font.coords),
    features: &[],
    steps: steps,
    positioning: false,
    autoZwj: true,
    autoZwnj: true,
    randomState: 1,
    budget: 2048,
    maxLength: 64,
    ligatureId: 0,
    shaper: 0,
    restrictSyllable: false,
    positions: [0; 64],
    positionStack: List<usize>.make(),
    classTables: List<ClassTable>.asSlice(&plan.classTables),
    classValues: List<u16>.asSlice(&plan.classValues),
    ruleDigests: List<u64>.asSlice(&plan.ruleDigests),
    coverageValues: List<u16>.asSlice(&plan.coverageValues),
    glyphClasses: gdefClasses(plan, font.data.gdef, 0, plan.glyphClasses),
    markAttachClasses: gdefClasses(plan, font.data.gdef, 3, plan.markAttachClasses),
    varStore: readVarStore(font.data.gdef, List<F2Dot14>.length(&font.coords)),
  }
  let mut i: usize = 0
  while i < steps.length {
    if steps[i].tag == tag && SetDigest.mayHave(&steps[i].digest, glyphs[0]) {
      let lookup = lookupAt(&context, steps[i].lookupOffset)
      if glyphs.length > 1 && lookup.kind <= 3 {
        i = i + 1
        continue
      }
      let mut buffer = Buffer.new()
      let mut j: usize = 0
      while j < glyphs.length {
        let mut item = Glyph.new(0, 0)
        item.info.glyphId = glyphs[j]
        item.form = tag
        item.featureMask = 4294967295
        run List<Glyph>.append(&mut buffer.glyphs, item)
        j = j + 1
      }
      let subtables = Slice.view(
        List<LookupSubtable>.asSlice(&plan.subtables),
        steps[i].firstSubtable,
        steps[i].subtableCount,
      )
      let result = run applyLookup(
        font,
        &mut context,
        &mut buffer,
        lookup,
        subtables,
        0,
        i,
        i + 1,
        0,
      )
      if result.yes {
        return true
      }
    }
    i = i + 1
  }
  return false
}

fn enabled(context: &Context, glyph: &Glyph, first: usize, last: usize) -> u32 {
  let mut result: u32 = 0
  let mut i = first
  while i < last {
    let step = context.steps[i]
    if step.required {
      return 1
    }
    let mut initial = step.value
    if context.shaper != 1 && arabic.isFeature(step.tag) && glyph.form != step.tag {
      initial = 0
    }
    if !context.positioning && !complex.featureEnabled(context.shaper, glyph, step.tag) {
      initial = 0
    }
    if (step.tag == 0x6c6a6d6f || step.tag == 0x766a6d6f || step.tag == 0x746a6d6f)
      && glyph.form != step.tag {
      initial = 0
    }
    if step.tag == 0x63616c74 && preprocess.isJamo(glyph.codepoint) {
      initial = 0
    }
    if step.tag == 0x66726163 || step.tag == 0x6e756d72 || step.tag == 0x646e6f6d {
      initial = 0
      if (step.tag == 0x66726163 && glyph.fraction != 0)
        || (step.tag == 0x6e756d72 && glyph.fraction == 1)
        || (step.tag == 0x646e6f6d && glyph.fraction == 2) {
        initial = 1
      }
    }
    if step.tag == 0x72746c6d && !glyph.mirrored {
      initial = 0
    }
    let value = featureValue(step.tag, initial, glyph.info.cluster, context.features)
    if value > result {
      result = value
    }
    i = i + 1
  }
  return result
}

fn ignored(context: &Context, lookup: Lookup, glyph: &Glyph) -> bool {
  if glyph.glyphClass == 1 && (lookup.flags & 2) != 0 {
    return true
  }
  if glyph.glyphClass == 2 && (lookup.flags & 4) != 0 {
    return true
  }
  if glyph.glyphClass == 3 {
    if (lookup.flags & 8) != 0 {
      return true
    }
    if (lookup.flags & 16) != 0 {
      let sets = View.gdefList(&context.gdef, 4)
      if lookup.markSet >= View.u16(&sets, 2) {
        return true
      }
      let coverage = View.offset32(&sets, 4 + u16.toUsize(lookup.markSet) * 4)
      return !hasCoverage(coverage, glyph.info.glyphId)
    }
    if (lookup.flags & 0xff00) != 0 {
      return classOf(&context.markAttachClasses, glyph.info.glyphId)
        != u16.toU32(lookup.flags / 256)
    }
  }
  return false
}

fn next(context: &Context, buffer: &Buffer, lookup: Lookup, start: usize, backward: bool) -> Option<
  usize
> {
  let mut i = start
  while true {
    if backward {
      if i == 0 {
        return Option<usize>.None
      }
      i = i - 1
    } else {
      if i >= Buffer.len(buffer) {
        return Option<usize>.None
      }
      i = i + 1
      if i >= Buffer.len(buffer) {
        return Option<usize>.None
      }
    }
    let item = List<Glyph>.get(&buffer.glyphs, i)
    if context.restrictSyllable
      && item.syllable != List<Glyph>.get(&buffer.glyphs, start).syllable {
      return Option<usize>.None
    }
    if ignored(context, lookup, &item) {
      continue
    }
    if item.ignorable && !item.substituted && (!item.hidden || context.positioning) {
      if (item.codepoint == 0x200c || (context.shaper != 0 && item.codepoint == 0x200d))
        && !context.positioning {
        return Option<usize>.some(i)
      }
      continue
    }
    return Option<usize>.some(i)
  }
}

/// Applies the first subtable of `lookup` that matches at `at`. `subtables` is the plan's
/// cached subtable list for this lookup; when it is empty the subtables are read from the table.
effect fn applyLookup<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  context: &mut Context,
  buffer: &mut Buffer,
  lookup: Lookup,
  subtables: &[LookupSubtable],
  at: usize,
  first: usize,
  last: usize,
  depth: usize,
) -> Applied
  ! OutOfMemoryError
  ? &mut Allocator {
  if depth > 64 {
    buffer.successful = false
    return no()
  }
  if !buffer.successful || context.budget == 0 || at >= Buffer.len(&buffer.*)
    || ignored(&context.*, lookup, &List<Glyph>.get(&buffer.glyphs, at)) {
    return no()
  }
  context.budget = context.budget - 1
  let cached = subtables.length != 0
  let mut count = u16.toUsize(View.u16(&lookup.table, 4))
  let mut glyph: u32 = 0
  if cached {
    count = subtables.length
    glyph = List<Glyph>.get(&buffer.glyphs, at).info.glyphId
  }
  let mut i: usize = 0
  while i < count && context.budget != 0 && buffer.successful {
    context.budget = context.budget - 1
    let mut table = View.empty()
    let mut kind = lookup.kind
    let mut known: u32 = 0
    if cached {
      if !SetDigest.mayHave(&subtables[i].digest, glyph) {
        i = i + 1
        continue
      }

      // An expanded coverage rejects an uncovered glyph without calling the subtable, which
      // would reject it first thing.
      // A covered glyph's index is passed on so the subtable does not search for it again.
      let sub = &subtables[i]
      if sub.coverageCount != 0 {
        if glyph >= sub.coverageFirst
          && u32.toUsize(glyph - sub.coverageFirst) < sub.coverageCount {
          known = u16.toU32(
            context.coverageValues[sub.coverageStart + u32.toUsize(glyph - sub.coverageFirst)],
          )
        }
        if known == 0 {
          if sub.missSpends && context.budget != 0 {
            context.budget = context.budget - 1
          }
          i = i + 1
          continue
        }
      }
      table = View.tail(&context.table, subtables[i].offset)
      kind = subtables[i].kind
    } else {
      table = View.offset16(&lookup.table, 6 + i * 2)
      let extension = (!context.positioning && kind == 7) || (context.positioning && kind == 9)
      if extension {
        if View.u16(&table, 0) != 1 {
          i = i + 1
          continue
        }
        kind = View.u16(&table, 2)
        table = View.offset32(&table, 4)
      }
    }
    let mut result = no()
    if (!context.positioning && (kind == 5 || kind == 6))
      || (context.positioning && (kind == 7 || kind == 8)) {
      let mut digests = Slice.view(context.ruleDigests, 0, 0)
      if cached {
        digests = Slice.view(context.ruleDigests, subtables[i].ruleDigests, subtables[i].ruleSets)
      }
      result = run contextual(
        font,
        &mut context,
        &mut buffer,
        lookup,
        table,
        digests,
        known,
        at,
        first,
        last,
        depth,
        kind == 6 || kind == 8,
      )
    } else if context.positioning {
      result = run position(font, &context.*, &mut buffer, lookup, table, kind, known, at)
    } else {
      result = run substitute(
        font,
        &mut context,
        &mut buffer,
        lookup,
        table,
        kind,
        known,
        at,
        first,
        last,
      )
    }
    if result.yes {
      return result
    }
    i = i + 1
  }
  return no()
}

fn setGlyph(
  context: &Context,
  buffer: &mut Buffer,
  at: usize,
  glyphId: u32,
  ligature: bool,
  multiplied: bool,
) -> () {
  let mut item = List<Glyph>.get(&buffer.glyphs, at)
  item.info.glyphId = glyphId
  item.substituted = true
  if ligature {
    item.ligated = true
    item.multiplied = false
  }
  if multiplied {
    item.multiplied = true
  }
  if View.len(&context.glyphClasses.view) > 0 {
    item.glyphClass = classOf(&context.glyphClasses, glyphId)
  }

  List<Glyph>.set(&mut buffer.glyphs, at, item)
}

effect fn substitute<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  context: &mut Context,
  buffer: &mut Buffer,
  lookup: Lookup,
  table: View,
  kind: u16,
  known: u32,
  at: usize,
  first: usize,
  last: usize,
) -> Applied
  ! OutOfMemoryError
  ? &mut Allocator {
  let glyph = List<Glyph>.get(&buffer.glyphs, at)
  let rawFormat = View.u16(&table, 0)
  let wide = (kind == 1 && (rawFormat == 3 || rawFormat == 4)) || (kind != 1 && rawFormat == 2)
  let mut width: usize = 2
  let mut header: usize = 4
  let mut coverageWidth: usize = 2
  if wide {
    width = 3
    header = 6
    coverageWidth = 4
  }
  let mut coverage = usize.wrappingSubtract(u32.toUsize(known), 1)
  if known == 0 {
    coverage = match move View.coverage(
      &View.offset(&table, 2, coverageWidth),
      glyph.info.glyphId,
    ) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return no()
      }
    }
  }
  let mut format = rawFormat
  if wide {
    if kind == 1 {
      format = format - 2
    } else {
      format = 1
    }
  }
  if kind == 1 {
    let mut substitute: u32 = 0
    if format == 1 {
      substitute = u32.wrappingAdd(glyph.info.glyphId, View.uint(&table, header, width)) & 0xffffff
      if !wide {
        substitute = substitute & 65535
      }
    } else if format == 2 && coverage < u32.toUsize(View.uint(&table, header, width)) {
      substitute = View.uint(&table, offset(header + width, coverage, width), width)
    } else {
      return no()
    }
    drop run trace.indexed(font, &buffer.*, "replacing glyph at ", at, " (single substitution)")
    setGlyph(&context.*, &mut buffer, at, substitute, false, false)
    drop run trace.indexed(font, &buffer.*, "replaced glyph at ", at, " (single substitution)")
    return yes(at + 1)
  }
  if (kind == 2 || kind == 3 || kind == 4) && format == 1 {
    if coverage >= u32.toUsize(View.uint(&table, header, width)) {
      return no()
    }
    let set = View.offset(&table, offset(header + width, coverage, width), width)
    let count = u16.toUsize(View.u16(&set, 0))
    if kind == 2 {
      if count > (usize.saturatingSubtract(View.len(&set), 2) / width) {
        return no()
      }
      if Buffer.len(&buffer.*) + count - 1 > context.maxLength {
        buffer.successful = false
        return no()
      }
      if count == 0 {
        drop run trace.indexed(
          font,
          &buffer.*,
          "deleting glyph at ",
          at,
          " (multiple substitution)",
        )
        Buffer.deleteGlyph(&mut buffer, at)
        drop run trace.indexed(font, &buffer.*, "deleted glyph at ", at, " (multiple substitution)")
        return yes(at)
      }
      if count == 1 {
        drop run trace.indexed(
          font,
          &buffer.*,
          "replacing glyph at ",
          at,
          " (multiple substitution)",
        )
        setGlyph(&context.*, &mut buffer, at, View.uint(&set, 2, width), false, false)
        drop run trace.indexed(
          font,
          &buffer.*,
          "replaced glyph at ",
          at,
          " (multiple substitution)",
        )
        return yes(at + 1)
      }
      run saveInput(&mut context, &buffer.*)
      drop run trace.indexed(font, &buffer.*, "multiplying glyph at ", at, "")
      let mut i: usize = 0
      while i < count {
        let mut item = glyph
        if item.ligatureId == 0 {
          item.component = usize.toU32(i) & 15
          item.numComponents = 1
        }
        if View.len(&View.gdefList(&context.gdef, 0)) == 0 && glyph.glyphClass == 2 {
          item.glyphClass = 1
        }
        if i == 0 {
          List<Glyph>.set(&mut buffer.glyphs, at, item)
        } else {
          run List<Glyph>.insert(&mut buffer.glyphs, at + i, item)
        }
        setGlyph(
          &context.*,
          &mut buffer,
          at + i,
          View.uint(&set, 2 + i * width, width),
          false,
          true,
        )
        i = i + 1
      }
      if trace.enabled(font, &buffer.*) {
        let mut indices = List<usize>.make()
        let mut n: usize = 0
        while n < count {
          run List<usize>.append(&mut indices, n)
          n = n + 1
        }
        drop run trace.indices(
          font,
          &buffer.*,
          "multiplied glyphs at ",
          List<usize>.asSlice(&indices),
          at,
        )
      }
      return yes(at + count)
    }
    if kind == 3 {
      let mut selection = u32.toUsize(enabled(&context.*, &glyph, first, last))
      if selection == 4294967295 && count != 0 {
        context.randomState = u32.wrappingMultiply(context.randomState, 48271) % 2147483647
        selection = u32.toUsize(context.randomState) % count + 1
        let length = Buffer.len(&buffer.*)
        Buffer.unsafeToBreak(&mut buffer, 0, length)
      }
      if selection == 0 || selection > count {
        return no()
      }
      drop run trace.indexed(
        font,
        &buffer.*,
        "replacing glyph at ",
        at,
        " (alternate substitution)",
      )
      setGlyph(
        &context.*,
        &mut buffer,
        at,
        View.uint(&set, 2 + (selection - 1) * width, width),
        false,
        false,
      )
      drop run trace.indexed(font, &buffer.*, "replaced glyph at ", at, " (alternate substitution)")
      return yes(at + 1)
    }

    // With several candidates, find the glyph after this one once and reject ligatures whose
    // second component differs without matching them, as harfrust does.
    let mut second: u32 = 0
    let mut secondAt: usize = 0
    let mut haveSecond = false
    let mut skippedAny = false
    if count > 1 {
      if let Option<usize>.Some { value } = ligatureSecond(&context.*, &buffer.*, lookup, at) {
        second = List<Glyph>.get(&buffer.glyphs, value).info.glyphId
        secondAt = value
        haveSecond = true
      }
    }
    let mut i: usize = 0
    while i < count && context.budget != 0 && buffer.successful {
      if haveSecond && width == 2 {
        let skipped = skipLigatures16(&mut context, set, i, count, second)
        if skipped.marked && !skippedAny {
          Buffer.unsafeToConcat(&mut buffer, at, secondAt + 1)
          skippedAny = true
        }
        i = skipped.index
        if i >= count || context.budget == 0 {
          break
        }
      }
      context.budget = context.budget - 1
      let ligature = View.offset(&set, 2 + i * width, width)
      let components = u16.toUsize(View.u16(&ligature, width))
      if components == 0 || components > 64 {
        i = i + 1
        continue
      }
      if haveSecond && components > 1 && View.uint(&ligature, 2 + width, width) != second {
        // A full match would have failed at the second glyph and marked the same span.
        if !skippedAny {
          Buffer.unsafeToConcat(&mut buffer, at, secondAt + 1)
          skippedAny = true
        }
        i = i + 1
        continue
      }
      let mut matchKind: u32 = 0
      if wide {
        matchKind = 4
      }
      context.positions[0] = at
      let mut matched: usize = 1
      let mut cursor = at
      while matched < components {
        match move nextExpected(
          &context.*,
          &buffer.*,
          lookup,
          cursor,
          false,
          ligature,
          2 + matched * width,
          matchKind,
          noClasses(&context.*),
          false,
        ) {
          Option<usize>.Some { value } => {
            cursor = value
          }
          _ => {
            break
          }
        }
        let item = List<Glyph>.get(&buffer.glyphs, cursor)
        if item.info.glyphId != View.uint(&ligature, 2 + matched * width, width)
          || enabled(&context.*, &item, first, last) == 0
          || !compatibleComponents(&context.*, &buffer.*, lookup, at, &item) {
          break
        }
        context.positions[matched] = cursor
        matched = matched + 1
      }
      if matched == components {
        drop run trace.indices(
          font,
          &buffer.*,
          "ligating glyphs at ",
          Slice.view(&context.positions, 0, components),
          0,
        )
        Buffer.mergeClusters(&mut buffer, at, cursor + 1)
        Buffer.unsafeToBreak(&mut buffer, at, cursor + 1)
        let original = List<Glyph>.get(&buffer.glyphs, at)
        let mut baseLigature = original.glyphClass == 1
        let mut markLigature = original.glyphClass == 3
        let mut total = Glyph.ligNumComps(&original)
        let mut n: usize = 1
        while n < components {
          let part = List<Glyph>.get(&buffer.glyphs, context.positions[n])
          if part.glyphClass != 3 {
            baseLigature = false
            markLigature = false
          }
          total = total + Glyph.ligContribution(&part)
          n = n + 1
        }
        let isLigature = !baseLigature && !markLigature
        let mut id: u32 = 0
        let mut lastId = original.ligatureId
        let mut lastNum = Glyph.ligNumComps(&original)
        let mut soFar = lastNum
        let mut item = original
        if isLigature {
          context.ligatureId = context.ligatureId % 7 + 1
          id = context.ligatureId
          item.ligatureId = id
          item.component = 0
          item.numComponents = total & 15
          if View.len(&View.gdefList(&context.gdef, 0)) == 0 {
            item.glyphClass = 2
          }
        }
        List<Glyph>.set(&mut buffer.glyphs, at, item)
        setGlyph(&context.*, &mut buffer, at, View.uint(&ligature, 0, width), true, false)
        let mut p = at + 1
        n = 1
        while p <= cursor {
          let mut part = List<Glyph>.get(&buffer.glyphs, p)
          if n < components && p == context.positions[n] {
            n = n + 1
            lastId = part.ligatureId
            lastNum = Glyph.ligContribution(&part)
            soFar = soFar + lastNum
          } else if isLigature {
            let mut comp = part.component
            if comp == 0 || comp > lastNum {
              comp = lastNum
            }
            part.ligatureId = id
            part.component = (soFar - lastNum + comp) & 15
            part.numComponents = 1
            List<Glyph>.set(&mut buffer.glyphs, p, part)
          }
          p = p + 1
        }
        if !markLigature && lastId != 0 {
          while p < Buffer.len(&buffer.*) {
            let mut part = List<Glyph>.get(&buffer.glyphs, p)
            if part.ligatureId != lastId || part.component == 0 {
              break
            }
            let mut comp = part.component
            if comp > lastNum {
              comp = lastNum
            }
            part.ligatureId = id
            part.component = (soFar - lastNum + comp) & 15
            part.numComponents = 1
            List<Glyph>.set(&mut buffer.glyphs, p, part)
            p = p + 1
          }
        }
        n = components
        while n > 1 {
          n = n - 1
          drop List<Glyph>.remove(&mut buffer.glyphs, context.positions[n])
        }
        drop run trace.indexed(font, &buffer.*, "ligated glyph at ", at, "")
        return yes(at + 1)
      }
      Buffer.unsafeToConcat(&mut buffer, at, cursor + 1)
      i = i + 1
    }
  }
  if kind == 8 && format == 1 {
    let backCount = u16.toUsize(View.u16(&table, header))
    let aheadPos = header + 2 + backCount * width
    let mut matchKind: u32 = 2
    if wide {
      matchKind = 6
    }
    let aheadCount = u16.toUsize(View.u16(&table, aheadPos))
    if !matchOutside(
      &context.*,
      &buffer.*,
      lookup,
      table,
      header + 2,
      backCount,
      at,
      true,
      matchKind,
      noClasses(&context.*),
    )
      || !matchOutside(
      &context.*,
      &buffer.*,
      lookup,
      table,
      aheadPos + 2,
      aheadCount,
      at,
      false,
      matchKind,
      noClasses(&context.*),
    ) {
      return no()
    }
    let substitutes = aheadPos + 2 + aheadCount * width
    if coverage >= u32.toUsize(View.uint(&table, substitutes, width)) {
      return no()
    }
    drop run trace.indexed(
      font,
      &buffer.*,
      "replacing glyph at ",
      at,
      " (reverse chaining substitution)",
    )
    setGlyph(
      &context.*,
      &mut buffer,
      at,
      View.uint(&table, substitutes + width + coverage * width, width),
      false,
      false,
    )
    drop run trace.indexed(
      font,
      &buffer.*,
      "replaced glyph at ",
      at,
      " (reverse chaining substitution)",
    )
    return yes(at + 1)
  }
  return no()
}

// Contextual matches obey the same component boundaries as ligatures.
fn compatibleComponents(
  context: &Context,
  buffer: &Buffer,
  lookup: Lookup,
  at: usize,
  item: &Glyph,
) -> bool {
  let first = List<Glyph>.get(&buffer.glyphs, at)
  if first.ligatureId != 0 && first.component != 0 {
    if first.ligatureId == item.ligatureId && first.component == item.component {
      return true
    }
    let mut p = at
    while p > 0 {
      p = p - 1
      let base = List<Glyph>.get(&buffer.glyphs, p)
      if base.ligatureId != first.ligatureId {
        break
      }
      if base.component == 0 {
        return ignored(context, lookup, &base)
      }
    }
    return false
  }
  return item.ligatureId == 0 || item.component == 0 || item.ligatureId == first.ligatureId
}

/// The glyph a ligature's second component must match: the next glyph the lookup does not
/// ignore. None when that glyph may be skipped as default-ignorable, or the syllable ends,
/// since then each ligature must be matched in full.
fn ligatureSecond(context: &Context, buffer: &Buffer, lookup: Lookup, at: usize) -> Option<usize> {
  let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
  let mut i = at + 1
  while i < glyphs.length {
    let item = &glyphs[i]
    if context.restrictSyllable && item.syllable != glyphs[at].syllable {
      return Option<usize>.None
    }
    if !ignored(context, lookup, item) {
      if item.ignorable && !item.substituted && (!item.hidden || context.positioning) {
        return Option<usize>.None
      }
      return Option<usize>.some(i)
    }
    i = i + 1
  }
  return Option<usize>.None
}

fn matchWidth(kind: u32) -> usize {
  if kind >= 4 {
    return 3
  }
  return 2
}

fn matches(table: View, pos: usize, kind: u32, classes: Classes, glyph: u32) -> bool {
  let expected = View.uint(&table, pos, matchWidth(kind))
  if (kind & 3) == 2 {
    return hasCoverage(View.tail(&table, u32.toUsize(expected)), glyph)
  }
  if (kind & 3) == 1 {
    return classOf(&classes, glyph) == expected
  }
  return glyph == expected
}

fn nextExpected(
  context: &Context,
  buffer: &Buffer,
  lookup: Lookup,
  start: usize,
  backward: bool,
  table: View,
  pos: usize,
  kind: u32,
  classes: Classes,
  contextual: bool,
) -> Option<usize> {
  let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
  let syllable = glyphs[start].syllable
  let mut i = start
  while true {
    if backward {
      if i == 0 {
        return Option<usize>.None
      }
      i = i - 1
    } else {
      i = i + 1
      if i >= glyphs.length {
        return Option<usize>.None
      }
    }
    let item = &glyphs[i]
    if context.restrictSyllable && item.syllable != syllable {
      return Option<usize>.None
    }
    if ignored(context, lookup, item) {
      continue
    }
    if matches(table, pos, kind, classes, item.info.glyphId) {
      return Option<usize>.some(i)
    }
    if item.ignorable && !item.substituted && (!item.hidden || context.positioning)
      && (item.codepoint != 0x200c || context.positioning || (contextual && context.autoZwnj))
      && (item.codepoint != 0x200d || contextual || context.autoZwj) {
      continue
    }
    return Option<usize>.some(i)
  }
}

/// Where a rule's lookahead and actions sit, and whether its action records fit in the rule.
struct RuleTail {
  aheadPos: usize,
  aheadCount: usize,
  actionPos: usize,
  actionCount: usize,
  valid: bool,
}

/// Reads the rest of a rule from `pos`, just past its input values. Unchained rules store the
/// action count before the input, so the caller passes it in.
fn ruleTail(
  rule: View,
  pos: usize,
  chained: bool,
  actionCount: usize,
  width: usize,
) -> RuleTail with Intrinsic.inline() {
  let mut at = pos
  let mut aheadPos: usize = 0
  let mut aheadCount: usize = 0
  let mut actions = actionCount
  if chained {
    aheadCount = u16.toUsize(View.u16(&rule, at))
    aheadPos = at + 2
    at = at + 2 + aheadCount * width
    actions = u16.toUsize(View.u16(&rule, at))
    at = at + 2
  }
  return RuleTail {
    aheadPos: aheadPos,
    aheadCount: aheadCount,
    actionPos: at,
    actionCount: actions,
    valid: actions <= 64 && offset(at, actions, 4) <= View.len(&rule),
  }
}

/// Skips the rules of a format 1 or 2 rule set whose second input value cannot match, exactly as
/// the full loop in `contextual` would reject them, and returns the first rule that needs the
/// full match. Positions are read from the rule set directly, without a view per rule.
fn skipRules(
  context: &mut Context,
  buffer: &mut Buffer,
  ruleSet: View,
  from: usize,
  count: usize,
  offsetWidth: usize,
  chained: bool,
  width: usize,
  found: bool,
  secondValue: u32,
  at: usize,
  secondEnd: usize,
) -> usize {
  if offsetWidth == 2 && width == 2 {
    return skipRules16(
      &mut context,
      &mut buffer,
      ruleSet,
      from,
      count,
      chained,
      found,
      secondValue,
      at,
      secondEnd,
    )
  }
  let length = View.len(&ruleSet)
  let mut index = from
  while index < count && context.budget != 0 {
    let start = u32.toUsize(
      View.uint(
        &ruleSet,
        usize.wrappingAdd(2, usize.wrappingMultiply(index, offsetWidth)),
        offsetWidth,
      ),
    )
    let mut pos = start
    if chained {
      let backCount = u16.toUsize(View.u16(&ruleSet, pos))
      pos = usize.wrappingAdd(pos, usize.wrappingAdd(2, usize.wrappingMultiply(backCount, width)))
    }
    let inputCount = u16.toUsize(View.u16(&ruleSet, pos))
    pos = usize.wrappingAdd(pos, 2)
    let mut actionCount: usize = 0
    if !chained {
      actionCount = u16.toUsize(View.u16(&ruleSet, pos))
      pos = usize.wrappingAdd(pos, 2)
    }

    // A missing rule reads as zero inputs, which the full loop skips without marking.
    if start == 0 || start > length || inputCount < 2 || inputCount > 64
      || (found && View.uint(&ruleSet, pos, width) == secondValue) {
      return index
    }
    context.budget = context.budget - 1
    if (buffer.flags & 64) != 0 {
      let rule = View.tail(&ruleSet, start)
      let end = usize.wrappingAdd(pos - start, usize.wrappingMultiply(inputCount - 1, width))
      if ruleTail(rule, end, chained, actionCount, width).valid {
        Buffer.unsafeToConcat(&mut buffer, at, secondEnd)
      }
    }
    index = index + 1
  }
  return index
}

/// `skipRules` for the common 16-bit rule sets, reading the bytes without width dispatch.
fn skipRules16(
  context: &mut Context,
  buffer: &mut Buffer,
  ruleSet: View,
  from: usize,
  count: usize,
  chained: bool,
  found: bool,
  secondValue: u32,
  at: usize,
  secondEnd: usize,
) -> usize {
  let bytes = FontData.asBytes(&ruleSet.data)

  // The budget and flags stay in locals so the loop does not reload them through the references.
  let marks = (buffer.flags & 64) != 0
  let mut budget = context.budget
  let mut index = from
  while index < count && budget != 0 {
    // Offsets and counts are at most 65535, so the wrapping arithmetic below cannot wrap.
    let start = read16(bytes, usize.wrappingAdd(2, usize.wrappingMultiply(index, 2)))
    if start == 0 || start > bytes.length {
      break
    }
    let mut countPos = start
    if chained {
      countPos = usize.wrappingAdd(
        countPos,
        usize.wrappingAdd(2, usize.wrappingMultiply(read16(bytes, countPos), 2)),
      )
    }
    let inputCount = read16(bytes, countPos)
    if inputCount < 2 || inputCount > 64 {
      break
    }

    // Unchained rules keep their action count between the input count and the input values.
    let mut pos = usize.wrappingAdd(countPos, 2)
    if !chained {
      pos = usize.wrappingAdd(pos, 2)
    }
    if found && usize.toU32(read16(bytes, pos)) == secondValue {
      break
    }
    budget = budget - 1
    if marks {
      let mut actionCount: usize = 0
      if !chained {
        actionCount = read16(bytes, countPos + 2)
      }
      let end = pos - start + (inputCount - 1) * 2
      if ruleTail(View.tail(&ruleSet, start), end, chained, actionCount, 2).valid {
        Buffer.unsafeToConcat(&mut buffer, at, secondEnd)
      }
    }
    index = index + 1
  }
  context.budget = budget
  return index
}

struct SkippedLigatures {
  index: usize,
  marked: bool,
}

/// Skips the ligatures of a 16-bit ligature set that the full loop in `substitute` would reject
/// without matching: malformed ones, and ones whose second component is not `second`. Returns
/// the first ligature that needs matching and whether a skipped one would have marked the span.
fn skipLigatures16(
  context: &mut Context,
  set: View,
  from: usize,
  count: usize,
  second: u32,
) -> SkippedLigatures {
  let bytes = FontData.asBytes(&set.data)
  let mut budget = context.budget
  let mut marked = false
  let mut index = from
  while index < count && budget != 0 {
    let start = read16(bytes, 2 + index * 2)
    let mut components: usize = 0
    if start != 0 && start <= bytes.length {
      components = read16(bytes, start + 2)
    }
    if components != 0 && components <= 64 {
      if components == 1 || usize.toU32(read16(bytes, start + 4)) == second {
        break
      }
      marked = true
    }
    budget = budget - 1
    index = index + 1
  }
  context.budget = budget
  return SkippedLigatures { index: index, marked: marked }
}

/// The first glyph after `at` that input matching compares with a rule's second value.
struct InputSecond {
  found: bool,
  index: usize,
  glyph: u32,
  skippable: bool,
}

fn inputSecond(context: &Context, buffer: &Buffer, lookup: Lookup, at: usize) -> InputSecond {
  let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
  let mut i = at + 1
  while i < glyphs.length {
    let item = &glyphs[i]
    if context.restrictSyllable && item.syllable != glyphs[at].syllable {
      break
    }
    if !ignored(context, lookup, item) {
      return InputSecond {
        found: true,
        index: i,
        glyph: item.info.glyphId,
        skippable: item.ignorable && !item.substituted && (!item.hidden || context.positioning)
          && (item.codepoint != 0x200c || context.positioning)
          && (item.codepoint != 0x200d || context.autoZwj),
      }
    }
    i = i + 1
  }
  return InputSecond { found: false, index: at, glyph: 0, skippable: false }
}

fn matchOutside(
  context: &Context,
  buffer: &Buffer,
  lookup: Lookup,
  table: View,
  pos: usize,
  count: usize,
  at: usize,
  backward: bool,
  kind: u32,
  classes: Classes,
) -> bool {
  if count > 64 || offset(pos, count, matchWidth(kind)) > View.len(&table) {
    return false
  }
  let mut cursor = at
  let mut i: usize = 0
  while i < count {
    match move nextExpected(
      context,
      buffer,
      lookup,
      cursor,
      backward,
      table,
      pos + i * matchWidth(kind),
      kind,
      classes,
      true,
    ) {
      Option<usize>.Some { value } => {
        cursor = value
      }
      _ => {
        return false
      }
    }
    if !matches(
      table,
      pos + i * matchWidth(kind),
      kind,
      classes,
      List<Glyph>.get(&buffer.glyphs, cursor).info.glyphId,
    ) {
      return false
    }
    i = i + 1
  }
  return true
}

fn outsideEdge(
  context: &Context,
  buffer: &Buffer,
  lookup: Lookup,
  table: View,
  pos: usize,
  count: usize,
  at: usize,
  backward: bool,
  kind: u32,
  classes: Classes,
) -> usize {
  let mut cursor = at
  let mut i: usize = 0
  while i < count && i < 64 {
    match move nextExpected(
      context,
      buffer,
      lookup,
      cursor,
      backward,
      table,
      pos + i * matchWidth(kind),
      kind,
      classes,
      true,
    ) {
      Option<usize>.Some { value } => {
        cursor = value
      }
      _ => {
        break
      }
    }
    i = i + 1
  }
  return cursor
}

effect fn contextual<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  context: &mut Context,
  buffer: &mut Buffer,
  lookup: Lookup,
  table: View,
  digests: &[u64],
  known: u32,
  at: usize,
  first: usize,
  last: usize,
  depth: usize,
  chained: bool,
) -> Applied
  ! OutOfMemoryError
  ? &mut Allocator {
  let rawFormat = View.u16(&table, 0)
  let wide = rawFormat >= 4 && rawFormat <= 6
  if chained && rawFormat == 6 {
    return no()
  }

  // Format 3 has a single rule, which most glyphs fail on its first input coverage. Check that
  // before the general setup, spending the same budget the rule loop would.
  let mut firstMatched = false
  if rawFormat == 3 && known != 0 {
    firstMatched = true
  } else if rawFormat == 3 && context.budget != 0 && buffer.successful {
    let mut inputPos: usize = 6
    if chained {
      inputPos = 6 + u16.toUsize(View.u16(&table, 2)) * 2
    }
    let first = List<Glyph>.asSlice(&buffer.glyphs)[at].info.glyphId
    if !matches(table, inputPos, 2, noClasses(&context.*), first) {
      context.budget = context.budget - 1
      return no()
    }
    firstMatched = true
  }
  let mut format = rawFormat
  let mut offsetWidth: usize = 2
  let mut header: usize = 4
  let mut countWidth: usize = 2
  let mut coverageWidth: usize = 2
  if wide {
    format = format - 3
    offsetWidth = 3
    header = 6
    countWidth = 3
    coverageWidth = 4
  }
  let glyph = List<Glyph>.get(&buffer.glyphs, at).info.glyphId
  let mut ruleSet = View.tail(&table, View.len(&table))
  let mut classes = noClasses(&context.*)
  let mut backClasses = noClasses(&context.*)
  let mut aheadClasses = noClasses(&context.*)
  let mut kind: u32 = 0
  let mut ruleSetIndex: usize = 0
  if format == 1 || format == 2 {
    let mut coverage = usize.wrappingSubtract(u32.toUsize(known), 1)
    if known == 0 {
      coverage = match move View.coverage(&View.offset(&table, 2, coverageWidth), glyph) {
        Option<u32>.Some { value } => u32.toUsize(value)
        _ => {
          return no()
        }
      }
    }
    let mut index = coverage
    let mut countPos = header
    if format == 2 {
      kind = 1
      classes = classesFor(&context.*, View.offset(&table, header, coverageWidth))
      countPos = header + coverageWidth
      if chained {
        backClasses = classes
        classes = classesFor(&context.*, View.offset(&table, header + coverageWidth, coverageWidth))
        aheadClasses = classesFor(
          &context.*,
          View.offset(&table, header + coverageWidth * 2, coverageWidth),
        )
        countPos = header + coverageWidth * 3
        countWidth = 2
      }
      index = u32.toUsize(classOf(&classes, glyph))
    }
    if index >= u32.toUsize(View.uint(&table, countPos, countWidth)) {
      return no()
    }
    ruleSetIndex = index
    ruleSet = View.offset(&table, countPos + countWidth + index * offsetWidth, offsetWidth)
  } else if format == 3 {
    kind = 2
  } else {
    return no()
  }
  if wide && kind != 1 {
    kind = kind + 4
  }
  let width = matchWidth(kind)
  let mut ruleOffsetWidth = offsetWidth
  if format == 1 && !chained {
    ruleOffsetWidth = 2
  }
  let mut count: usize = 1
  if format != 3 {
    count = u16.toUsize(View.u16(&ruleSet, 0))
  }

  // Rules in formats 1 and 2 mostly fail on their second input value. The glyph that value is
  // compared with does not depend on the rule unless it is a default ignorable that matching may
  // skip, so find it once and reject such rules without walking the buffer.
  let mut second = InputSecond { found: false, index: at, glyph: 0, skippable: true }
  if format != 3 {
    second = inputSecond(&context.*, &buffer.*, lookup, at)
  }
  let mut secondValue = second.glyph
  if kind == 1 {
    secondValue = classOf(&classes, second.glyph)
  }
  let quickReject = format != 3 && !second.skippable
  let mut secondEnd = at + 1
  if second.found {
    secondEnd = second.index + 1
  }

  // The plan's digest of the rule set's second input values can rule out every rule at once.
  // The rule loop would reject each one, spending one budget unit per rule; buffers that track
  // unsafe-to-concat take the loop, which marks the span.
  if quickReject && (buffer.flags & 64) == 0 && ruleSetIndex < digests.length
    && digests[ruleSetIndex] != u64.MAX
    && (!second.found
    || (digests[ruleSetIndex] & u64.shiftLeft(1, u32.toU64(secondValue & 63))) == 0) {
    if context.budget != 0 && buffer.successful {
      context.budget = usize.saturatingSubtract(context.budget, count)
    }
    return no()
  }

  // Matched input positions live in this nesting depth's slot of the context's scratch list, so
  // each application neither zeroes nor copies a 64-entry array.
  let base = depth * 64
  while List<usize>.length(&context.positionStack) < base + 64 {
    run List<usize>.append(&mut context.positionStack, 0)
  }
  let mut ruleIndex: usize = 0
  while ruleIndex < count && context.budget != 0 && buffer.successful {
    if quickReject {
      ruleIndex = skipRules(
        &mut context,
        &mut buffer,
        ruleSet,
        ruleIndex,
        count,
        ruleOffsetWidth,
        chained,
        width,
        second.found,
        secondValue,
        at,
        secondEnd,
      )
      if ruleIndex >= count || context.budget == 0 {
        break
      }
    }
    context.budget = context.budget - 1
    let mut rule = table
    let mut pos: usize = 2
    if format != 3 {
      rule = View.offset(&ruleSet, 2 + ruleIndex * ruleOffsetWidth, ruleOffsetWidth)
      pos = 0
    }
    let mut backPos: usize = 0
    let mut backCount: usize = 0
    if chained {
      backCount = u16.toUsize(View.u16(&rule, pos))
      backPos = pos + 2
      pos = pos + 2 + backCount * width
    }
    let inputCount = u16.toUsize(View.u16(&rule, pos))
    pos = pos + 2
    let mut actionCount: usize = 0
    if !chained {
      actionCount = u16.toUsize(View.u16(&rule, pos))
      pos = pos + 2
    }
    let inputPos = pos
    let mut stored = inputCount
    if format != 3 && stored > 0 {
      stored = stored - 1
    }
    pos = pos + stored * width
    if quickReject && inputCount > 1 && inputCount <= 64
      && (!second.found || View.uint(&rule, inputPos, width) != secondValue) {
      // Only buffers that track unsafe-to-concat need the rest of the rule, to skip marking
      // for rules the full path would reject as malformed.
      if (buffer.flags & 64) != 0 && ruleTail(rule, pos, chained, actionCount, width).valid {
        Buffer.unsafeToConcat(&mut buffer, at, secondEnd)
      }
      ruleIndex = ruleIndex + 1
      continue
    }
    let tail = ruleTail(rule, pos, chained, actionCount, width)
    let aheadPos = tail.aheadPos
    let aheadCount = tail.aheadCount
    let actionPos = tail.actionPos
    actionCount = tail.actionCount
    if inputCount == 0 || inputCount > 64 || !tail.valid {
      ruleIndex = ruleIndex + 1
      continue
    }
    if format == 3 && !firstMatched && !matches(rule, inputPos, kind, classes, glyph) {
      ruleIndex = ruleIndex + 1
      continue
    }
    List<usize>.set(&mut context.positionStack, base + 0, at)
    let mut n: usize = 1
    let mut cursor = at
    while n < inputCount {
      let mut index = n - 1
      if format == 3 {
        index = n
      }
      match move nextExpected(
        &context.*,
        &buffer.*,
        lookup,
        cursor,
        false,
        rule,
        inputPos + index * width,
        kind,
        classes,
        false,
      ) {
        Option<usize>.Some { value } => {
          cursor = value
        }
        _ => {
          break
        }
      }
      let item = List<Glyph>.get(&buffer.glyphs, cursor)
      if !matches(rule, inputPos + index * width, kind, classes, item.info.glyphId)
        || enabled(&context.*, &item, first, last) == 0
        || !compatibleComponents(&context.*, &buffer.*, lookup, at, &item) {
        break
      }
      List<usize>.set(&mut context.positionStack, base + n, cursor)
      n = n + 1
    }
    if n != inputCount
      || !matchOutside(
      &context.*,
      &buffer.*,
      lookup,
      rule,
      backPos,
      backCount,
      at,
      true,
      kind,
      backClasses,
    )
      || !matchOutside(
      &context.*,
      &buffer.*,
      lookup,
      rule,
      aheadPos,
      aheadCount,
      cursor,
      false,
      kind,
      aheadClasses,
    ) {
      Buffer.unsafeToConcat(&mut buffer, at, cursor + 1)
      ruleIndex = ruleIndex + 1
      continue
    }
    let backEdge = outsideEdge(
      &context.*,
      &buffer.*,
      lookup,
      rule,
      backPos,
      backCount,
      at,
      true,
      kind,
      backClasses,
    )
    let aheadEdge = outsideEdge(
      &context.*,
      &buffer.*,
      lookup,
      rule,
      aheadPos,
      aheadCount,
      cursor,
      false,
      kind,
      aheadClasses,
    )
    Buffer.unsafeToBreak(&mut buffer, backEdge, aheadEdge + 1)
    let mut end = cursor + 1
    let mut matchedCount = inputCount
    let mut action: usize = 0
    let mut outputCursor = at
    while action < actionCount && buffer.successful {
      let sequence = u16.toUsize(View.u16(&rule, actionPos + action * 4))
      if sequence < matchedCount
        && List<usize>.get(&context.positionStack, base + sequence) < Buffer.len(&buffer.*) {
        let atAction = List<usize>.get(&context.positionStack, base + sequence)
        let mut moveCost = usize.saturatingSubtract(atAction, outputCursor)
        if outputCursor > atAction {
          moveCost = outputCursor - atAction
        }
        if !Buffer.spendOperations(&mut buffer, moveCost)
          || !Buffer.spendOperations(&mut buffer, 1) {
          break
        }
        let oldLength = Buffer.len(&buffer.*)
        let nested = getLookup(&context.*, View.u16(&rule, actionPos + action * 4 + 2))
        let nestedIndex = u16.toUsize(View.u16(&rule, actionPos + action * 4 + 2))
        drop run trace.pair(
          font,
          &buffer.*,
          "start recursing to lookup ",
          nestedIndex,
          " at ",
          atAction,
          "",
        )

        // Nested lookups are not cached in the plan; they parse their subtables in place.
        let uncached: [LookupSubtable; 0] = []
        let applied = run applyLookup(
          font,
          &mut context,
          &mut buffer,
          nested,
          &uncached,
          atAction,
          first,
          last,
          depth + 1,
        )
        drop run trace.indexed(font, &buffer.*, "end recursing to lookup ", nestedIndex, "")
        outputCursor = atAction
        if applied.yes {
          outputCursor = applied.next
          let newLength = Buffer.len(&buffer.*)
          if newLength > oldLength {
            let delta = newLength - oldLength
            if matchedCount + delta > 64 {
              break
            }
            let mut j = matchedCount
            while j > sequence + 1 {
              j = j - 1
              let moved = List<usize>.get(&context.positionStack, base + j) + delta
              List<usize>.set(&mut context.positionStack, base + j + delta, moved)
            }
            j = sequence + 1
            while j <= sequence + delta {
              let moved = List<usize>.get(&context.positionStack, base + j - 1) + 1
              List<usize>.set(&mut context.positionStack, base + j, moved)
              j = j + 1
            }
            matchedCount = matchedCount + delta
          } else if oldLength > newLength {
            let mut delta = oldLength - newLength
            if delta > matchedCount - sequence - 1 {
              delta = matchedCount - sequence - 1
            }
            let mut j = sequence + 1
            while j + delta < matchedCount {
              let moved = usize.saturatingSubtract(
                List<usize>.get(&context.positionStack, base + j + delta),
                delta,
              )
              List<usize>.set(&mut context.positionStack, base + j, moved)
              j = j + 1
            }
            matchedCount = matchedCount - delta
          }
          if newLength >= oldLength {
            end = end + newLength - oldLength
          } else {
            end = usize.saturatingSubtract(end, oldLength - newLength)
          }
        }
      }
      action = action + 1
    }
    let mut moveCost = usize.saturatingSubtract(end, outputCursor)
    if outputCursor > end {
      moveCost = outputCursor - end
    }
    drop Buffer.spendOperations(&mut buffer, moveCost)
    return yes(end)
  }
  return no()
}

/// Bytes in a value record: two per bit set in the low byte of its format. The bits are
/// counted in parallel, since this runs for every pair adjustment.
fn valueSize(format: u16) -> usize with Intrinsic.inline() {
  let bits = format & 255
  let pairs = bits - ((bits / 2) & 0x55)
  let nibbles = (pairs & 0x33) + ((pairs / 4) & 0x33)
  return u16.toUsize((nibbles + nibbles / 16) & 15) * 2
}

fn readVarStore<'a>(gdef: View<'a>, coordCount: usize) -> Option<ItemVariationStore<'a>> {
  if coordCount == 0 {
    return Option<ItemVariationStore<'a>>.None
  }
  return match move ItemVariationStore.read(View.gdefVarStore(&gdef).data) {
    Result<ItemVariationStore<'a>, ReadError>.Success { value } => Option<
      ItemVariationStore<'a>
    >.some(value)
    _ => Option<ItemVariationStore<'a>>.None
  }
}

fn deviceDelta(context: &Context, device: View) -> f32 {
  if View.u16(&device, 4) != 0x8000 {
    return 0.0
  }
  if let Option<ItemVariationStore>.Some { value: store } = &context.varStore {
    let index = DeltaSetIndex { outer: View.u16(&device, 0), inner: View.u16(&device, 2) }
    if let Option<F48Dot16>.Some { value } = ItemVariationStore.computeDelta(
      &store,
      index,
      context.coords,
    ) {
      return F48Dot16.toF32(value)
    }
  }
  return 0.0
}

fn adjustValue(
  context: &Context,
  buffer: &mut Buffer,
  at: usize,
  table: View,
  pos: usize,
  format: u16,
) -> () {
  if offset(pos, 1, valueSize(format)) > View.len(&table) || at >= Buffer.len(&buffer.*) {
    return
  }
  let horizontal = Direction.isHorizontal(buffer.direction)
  let glyphs = List<Glyph>.asMutSlice(&mut buffer.glyphs)
  let mut cursor = pos
  if (format & 1) != 0 {
    let value = i16.toI32(View.i16(&table, cursor))
    glyphs[at].position.xOffset = add(glyphs[at].position.xOffset, Scale.x(&context.scale, value))
    cursor = cursor + 2
  }
  if (format & 2) != 0 {
    let value = i16.toI32(View.i16(&table, cursor))
    glyphs[at].position.yOffset = add(glyphs[at].position.yOffset, Scale.y(&context.scale, value))
    cursor = cursor + 2
  }
  if (format & 4) != 0 {
    if horizontal {
      let value = i16.toI32(View.i16(&table, cursor))
      glyphs[at].position.xAdvance = add(
        glyphs[at].position.xAdvance,
        Scale.x(&context.scale, value),
      )
    }
    cursor = cursor + 2
  }
  if (format & 8) != 0 {
    if !horizontal {
      let value = i16.toI32(View.i16(&table, cursor))
      glyphs[at].position.yAdvance = sub(
        glyphs[at].position.yAdvance,
        Scale.y(&context.scale, value),
      )
    }
    cursor = cursor + 2
  }
  if (format & 240) == 0 {
    return
  }
  if (format & 16) != 0 {
    let delta = deviceDelta(context, View.offset16(&table, cursor))
    glyphs[at].position.xOffset = add(glyphs[at].position.xOffset, Scale.xf(&context.scale, delta))
    cursor = cursor + 2
  }
  if (format & 32) != 0 {
    let delta = deviceDelta(context, View.offset16(&table, cursor))
    glyphs[at].position.yOffset = add(glyphs[at].position.yOffset, Scale.yf(&context.scale, delta))
    cursor = cursor + 2
  }
  if (format & 64) != 0 {
    if horizontal {
      let delta = deviceDelta(context, View.offset16(&table, cursor))
      glyphs[at].position.xAdvance = add(
        glyphs[at].position.xAdvance,
        Scale.xf(&context.scale, delta),
      )
    }
    cursor = cursor + 2
  }
  if (format & 128) != 0 && !horizontal {
    let delta = deviceDelta(context, View.offset16(&table, cursor))
    glyphs[at].position.yAdvance = sub(
      glyphs[at].position.yAdvance,
      Scale.yf(&context.scale, delta),
    )
  }
}

struct Anchor {
  x: i32,
  y: i32,
  valid: bool,
}

impl Copy for Anchor {}

fn anchor(context: &Context, table: View) -> Anchor {
  if View.len(&table) < 6 || View.u16(&table, 0) == 0 || View.u16(&table, 0) > 3 {
    return Anchor { x: 0, y: 0, valid: false }
  }
  let mut x = i16.toF32(View.i16(&table, 2))
  let mut y = i16.toF32(View.i16(&table, 4))
  if View.u16(&table, 0) == 3 {
    x = x + deviceDelta(context, View.offset16(&table, 6))
    y = y + deviceDelta(context, View.offset16(&table, 8))
  }
  return Anchor { x: Scale.xf(&context.scale, x), y: Scale.yf(&context.scale, y), valid: true }
}

effect fn position<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  context: &Context,
  buffer: &mut Buffer,
  lookup: Lookup,
  table: View,
  kind: u16,
  known: u32,
  at: usize,
) -> Applied
  ! OutOfMemoryError
  ? &mut Allocator {
  let glyphId = List<Glyph>.asSlice(&buffer.glyphs)[at].info.glyphId
  let rawFormat = View.u16(&table, 0)
  let wide = ((kind == 1 || kind == 2) && (rawFormat == 3 || rawFormat == 4))
    || (kind >= 3 && rawFormat == 2)
  let mut width: usize = 2
  let mut header: usize = 4
  let mut coverageWidth: usize = 2
  let mut format = rawFormat
  if wide {
    width = 3
    header = 6
    coverageWidth = 4
    if kind <= 2 {
      format = format - 2
    } else {
      format = 1
    }
  }
  let mut coverage = usize.wrappingSubtract(u32.toUsize(known), 1)
  if known == 0 {
    coverage = match move View.coverage(&View.offset(&table, 2, coverageWidth), glyphId) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return no()
      }
    }
  }
  if kind == 1 {
    let valueFormat = View.u16(&table, header)
    let mut pos = header + 2
    if format == 2 {
      if coverage >= u32.toUsize(View.uint(&table, header + 2, width)) {
        return no()
      }
      pos = offset(header + 2 + width, coverage, valueSize(valueFormat))
    } else if format != 1 {
      return no()
    }
    drop run trace.indexed(font, &buffer.*, "positioning glyph at ", at, "")
    adjustValue(context, &mut buffer, at, table, pos, valueFormat)
    drop run trace.indexed(font, &buffer.*, "positioned glyph at ", at, "")
    return yes(at + 1)
  }
  if kind == 2 {
    let second = match move next(context, &buffer.*, lookup, at, false) {
      Option<usize>.Some { value } => value
      _ => {
        return no()
      }
    }
    let right = List<Glyph>.get(&buffer.glyphs, second).info.glyphId
    let vf1 = View.u16(&table, header)
    let vf2 = View.u16(&table, header + 2)
    let size1 = valueSize(vf1)
    let size2 = valueSize(vf2)
    let mut values = table
    let mut pos: usize = 0
    if format == 1 {
      if coverage >= u32.toUsize(View.uint(&table, header + 4, width)) {
        return no()
      }
      values = View.offset(&table, header + 4 + width + coverage * width, width)
      let mut lo: usize = 0
      let mut hi = u32.toUsize(View.uint(&values, 0, width))
      while lo < hi {
        let mid = lo + (hi - lo) / 2
        if View.uint(&values, offset(width, mid, width + size1 + size2), width) < right {
          lo = mid + 1
        } else {
          hi = mid
        }
      }
      pos = offset(width, lo, width + size1 + size2)
      if lo >= u32.toUsize(View.uint(&values, 0, width))
        || View.uint(&values, pos, width) != right {
        Buffer.unsafeToConcat(&mut buffer, at, second + 1)
        return no()
      }
      pos = pos + width
    } else if format == 2 {
      let c1 = u32.toUsize(
        classOf(&classesFor(context, View.offset(&table, header + 4, coverageWidth)), glyphId),
      )
      let c2 = u32.toUsize(
        classOf(
          &classesFor(context, View.offset(&table, header + 4 + coverageWidth, coverageWidth)),
          right,
        ),
      )
      let count2 = u16.toUsize(View.u16(&table, header + 6 + coverageWidth * 2))
      if c1 >= u16.toUsize(View.u16(&table, header + 4 + coverageWidth * 2)) || c2 >= count2 {
        return no()
      }
      pos = offset(header + 8 + coverageWidth * 2, offset(c2, c1, count2), size1 + size2)
    } else {
      return no()
    }
    if offset(pos, 1, size1 + size2) > View.len(&values) {
      return no()
    }
    drop run trace.pair(font, &buffer.*, "try kerning glyphs at ", at, ",", second, "")
    adjustValue(context, &mut buffer, at, values, pos, vf1)
    adjustValue(context, &mut buffer, second, values, pos + size1, vf2)
    let kerned = hasValue(context, values, pos, vf1, buffer.direction)
      || hasValue(context, values, pos + size1, vf2, buffer.direction)
    if kerned {
      Buffer.unsafeToBreak(&mut buffer, at, second + 1)
    }
    Buffer.unsafeToConcat(&mut buffer, at, second + 1)
    if kerned {
      drop run trace.pair(font, &buffer.*, "kerned glyphs at ", at, ",", second, "")
    }
    drop run trace.pair(font, &buffer.*, "tried kerning glyphs at ", at, ",", second, "")
    if vf2 != 0 {
      return yes(second + 1)
    }
    return yes(second)
  }
  if kind == 3 && format == 1 {
    if coverage >= u32.toUsize(View.uint(&table, header, width)) {
      return no()
    }
    let entry = anchor(context, View.offset(&table, header + width + coverage * width * 2, width))
    if !entry.valid {
      return no()
    }
    let previous = match move next(context, &buffer.*, lookup, at, true) {
      Option<usize>.Some { value } => value
      _ => {
        Buffer.unsafeToConcat(&mut buffer, 0, at + 1)
        return no()
      }
    }
    let mut left = List<Glyph>.get(&buffer.glyphs, previous)
    let index = match move View.coverage(
      &View.offset(&table, 2, coverageWidth),
      left.info.glyphId,
    ) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return no()
      }
    }
    let exit = anchor(context, View.offset(&table, header + width * 2 + index * width * 2, width))
    if !exit.valid {
      Buffer.unsafeToConcat(&mut buffer, previous, at + 1)
      return no()
    }
    drop run trace.pair(
      font,
      &buffer.*,
      "cursive attaching glyph at ",
      previous,
      " to glyph at ",
      at,
      "",
    )
    let mut right = List<Glyph>.get(&buffer.glyphs, at)
    if buffer.direction == Direction.LeftToRight {
      left.position.xAdvance = add(exit.x, left.position.xOffset)
      let d = add(entry.x, right.position.xOffset)
      right.position.xAdvance = sub(right.position.xAdvance, d)
      right.position.xOffset = sub(right.position.xOffset, d)
    } else if buffer.direction == Direction.RightToLeft {
      let d = add(exit.x, left.position.xOffset)
      left.position.xAdvance = sub(left.position.xAdvance, d)
      left.position.xOffset = sub(left.position.xOffset, d)
      right.position.xAdvance = add(entry.x, right.position.xOffset)
    } else if buffer.direction == Direction.TopToBottom {
      left.position.yAdvance = add(exit.y, left.position.yOffset)
      let d = add(entry.y, right.position.yOffset)
      right.position.yAdvance = sub(right.position.yAdvance, d)
      right.position.yOffset = sub(right.position.yOffset, d)
    } else {
      let d = add(exit.y, left.position.yOffset)
      left.position.yAdvance = sub(left.position.yAdvance, d)
      left.position.yOffset = sub(left.position.yOffset, d)
      right.position.yAdvance = entry.y
    }
    List<Glyph>.set(&mut buffer.glyphs, previous, left)
    List<Glyph>.set(&mut buffer.glyphs, at, right)
    let mut child = previous
    let mut parent = at
    let mut x = sub(entry.x, exit.x)
    let mut y = sub(entry.y, exit.y)
    if (lookup.flags & 1) == 0 {
      child = at
      parent = previous
      x = sub(0, x)
      y = sub(0, y)
    }
    reverseCursive(&mut buffer, child, parent, 0)
    let mut changed = List<Glyph>.get(&buffer.glyphs, child)
    let chain = usize.toI64(parent) - usize.toI64(child)
    changed.attach = 0
    if chain >= -32768 && chain <= 32767 {
      changed.attach = i64.toI32(chain)
    }
    buffer.haveAttachments = true
    changed.attachType = 2
    if Direction.isHorizontal(buffer.direction) {
      changed.position.yOffset = y
    } else {
      changed.position.xOffset = x
    }
    List<Glyph>.set(&mut buffer.glyphs, child, changed)
    let mut ancestor = List<Glyph>.get(&buffer.glyphs, parent)
    if ancestor.attach == -changed.attach {
      ancestor.attach = 0
      if Direction.isHorizontal(buffer.direction) {
        ancestor.position.yOffset = 0
      } else {
        ancestor.position.xOffset = 0
      }
      List<Glyph>.set(&mut buffer.glyphs, parent, ancestor)
    }
    drop run trace.pair(
      font,
      &buffer.*,
      "cursive attached glyph at ",
      previous,
      " to glyph at ",
      at,
      "",
    )
    Buffer.unsafeToBreak(&mut buffer, previous, at + 1)
    return yes(at + 1)
  }
  if kind >= 4 && kind <= 6 && format == 1 {
    let mut base = at
    while true {
      if base == 0 {
        return no()
      }
      base = base - 1
      let candidate = List<Glyph>.get(&buffer.glyphs, base)
      let mut props = lookup
      if kind == 6 {
        props.flags = props.flags & 65521
      } else {
        props.flags = 8
      }
      if ignored(context, props, &candidate) || (candidate.ignorable && !candidate.ligated) {
        continue
      }
      if kind != 6 && candidate.glyphClass == 3 {
        continue
      }
      if kind == 6 && candidate.glyphClass != 3 {
        return no()
      }
      if kind != 6 && candidate.multiplied && candidate.component != 0 {
        let mut accept = false
        if kind == 4 && base > 0 {
          let prev = List<Glyph>.get(&buffer.glyphs, base - 1)
          accept = prev.glyphClass == 3 || !prev.multiplied
            || candidate.ligatureId != prev.ligatureId
            || candidate.component != prev.component + 1
        }
        if !accept
          && !hasCoverage(View.offset(&table, header, coverageWidth), candidate.info.glyphId) {
          continue
        }
      }
      break
    }
    let item = List<Glyph>.get(&buffer.glyphs, at)
    let baseGlyph = List<Glyph>.get(&buffer.glyphs, base)
    if kind == 6 {
      if item.ligatureId == baseGlyph.ligatureId {
        if item.ligatureId != 0 && item.component != baseGlyph.component {
          return no()
        }
      } else if !(item.ligatureId > 0 && item.component == 0)
        && !(baseGlyph.ligatureId > 0 && baseGlyph.component == 0) {
        return no()
      }
    }
    let baseIndex = match move View.coverage(
      &View.offset(&table, header, coverageWidth),
      baseGlyph.info.glyphId,
    ) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return no()
      }
    }
    let marks = View.offset(&table, header + coverageWidth + 2, coverageWidth)
    if coverage >= u32.toUsize(View.uint(&marks, 0, width)) {
      return no()
    }
    let markClass = u16.toUsize(View.u16(&marks, width + coverage * (2 + width)))
    let classCount = u16.toUsize(View.u16(&table, header + coverageWidth))
    if markClass >= classCount {
      return no()
    }
    let mark = anchor(context, View.offset(&marks, width + 2 + coverage * (2 + width), width))
    let mut bases = View.offset(&table, header + coverageWidth * 2 + 2, coverageWidth)
    let mut baseHeader = width
    if kind == 6 {
      baseHeader = 2
    }
    if baseIndex >= u32.toUsize(View.uint(&bases, 0, baseHeader)) {
      return no()
    }
    let mut row = baseIndex
    if kind == 5 {
      bases = View.offset(&bases, width + baseIndex * width, width)
      baseHeader = 2
      let components = u16.toUsize(View.u16(&bases, 0))
      if components == 0 {
        return no()
      }
      row = components - 1
      if item.ligatureId != 0 && item.ligatureId == baseGlyph.ligatureId && item.component > 0
        && u32.toUsize(item.component) <= components {
        row = u32.toUsize(item.component) - 1
      }
    }
    let target = anchor(
      context,
      View.offset(&bases, offset(baseHeader, offset(markClass, row, classCount), width), width),
    )
    if !mark.valid || !target.valid || at - base > 32768 {
      return no()
    }
    drop run trace.pair(font, &buffer.*, "attaching mark glyph at ", at, " to glyph at ", base, "")
    let mut changed = item
    changed.position.xOffset = sub(target.x, mark.x)
    changed.position.yOffset = sub(target.y, mark.y)
    let cross = crossOffset(&buffer.*, base)
    if Direction.isHorizontal(buffer.direction) {
      changed.position.yOffset = add(changed.position.yOffset, cross)
    } else {
      changed.position.xOffset = add(changed.position.xOffset, cross)
    }
    changed.attach = -usize.toI32(at - base)
    buffer.haveAttachments = true
    changed.attachType = 1
    List<Glyph>.set(&mut buffer.glyphs, at, changed)
    drop run trace.pair(font, &buffer.*, "attached mark glyph at ", at, " to glyph at ", base, "")
    Buffer.unsafeToBreak(&mut buffer, base, at + 1)
    return yes(at + 1)
  }
  return no()
}

fn reverseCursive(buffer: &mut Buffer, at: usize, parent: usize, depth: usize) -> () {
  if depth > 64 {
    return
  }
  let mut item = List<Glyph>.get(&buffer.glyphs, at)
  if item.attach == 0 || item.attachType != 2 {
    return
  }
  let chain = item.attach
  item.attach = 0
  List<Glyph>.set(&mut buffer.glyphs, at, item)
  let target = usize.toI64(at) + i32.toI64(chain)
  if target < 0 || target >= usize.toI64(Buffer.len(&buffer.*)) {
    return
  }
  let other = i64.toUsize(target)
  if other == parent {
    return
  }
  reverseCursive(&mut buffer, other, parent, depth + 1)
  item = List<Glyph>.get(&buffer.glyphs, at)
  let mut next = List<Glyph>.get(&buffer.glyphs, other)
  if Direction.isHorizontal(buffer.direction) {
    next.position.yOffset = sub(0, item.position.yOffset)
  } else {
    next.position.xOffset = sub(0, item.position.xOffset)
  }
  next.attach = -chain
  next.attachType = 2
  List<Glyph>.set(&mut buffer.glyphs, other, next)
}

fn crossOffset(buffer: &Buffer, at: usize) -> i32 {
  let mut index = at
  let mut result: i32 = 0
  let mut budget: usize = 100
  while index < Buffer.len(buffer) && budget > 0 {
    budget = budget - 1
    let item = List<Glyph>.get(&buffer.glyphs, index)
    if Direction.isHorizontal(buffer.direction) {
      result = add(result, item.position.yOffset)
    } else {
      result = add(result, item.position.xOffset)
    }
    if item.attachType != 2 || item.attach == 0 {
      break
    }
    let target = usize.toI64(index) + i32.toI64(item.attach)
    if target < 0 || target >= usize.toI64(Buffer.len(buffer)) {
      break
    }
    index = i64.toUsize(target)
  }
  return result
}

fn hasValue(context: &Context, table: View, pos: usize, format: u16, direction: Direction) -> bool {
  let horizontal = Direction.isHorizontal(direction)
  let mut at = pos
  if (format & 1) != 0 {
    if View.i16(&table, at) != 0 {
      return true
    }
    at = at + 2
  }
  if (format & 2) != 0 {
    if View.i16(&table, at) != 0 {
      return true
    }
    at = at + 2
  }
  if (format & 4) != 0 {
    if horizontal && View.i16(&table, at) != 0 {
      return true
    }
    at = at + 2
  }
  if (format & 8) != 0 {
    if !horizontal && View.i16(&table, at) != 0 {
      return true
    }
    at = at + 2
  }
  let mut bit: u16 = 16
  while bit <= 128 && (format & 240) != 0 {
    if (format & bit) != 0 {
      let applies = (bit != 64 || horizontal) && (bit != 128 || !horizontal)
      if applies && deviceDelta(context, View.offset16(&table, at)) != 0.0 {
        return true
      }
      at = at + 2
    }
    bit = bit * 2
  }
  return false
}

pub effect fn finishOffsets(buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !buffer.haveAttachments {
    return
  }
  let mut xs = List<i64>.make()
  let mut ys = List<i64>.make()
  let mut x: i64 = 0
  let mut y: i64 = 0
  let mut i: usize = 0
  while i < Buffer.len(&buffer.*) {
    run List<i64>.append(&mut xs, x)
    run List<i64>.append(&mut ys, y)
    let pos = List<Glyph>.get(&buffer.glyphs, i).position
    x = x + i32.toI64(pos.xAdvance)
    y = y + i32.toI64(pos.yAdvance)
    i = i + 1
  }
  run List<i64>.append(&mut xs, x)
  run List<i64>.append(&mut ys, y)
  i = 0
  while i < Buffer.len(&buffer.*) {
    resolveOffset(&mut buffer, i, List<i64>.asSlice(&xs), List<i64>.asSlice(&ys), 0)
    i = i + 1
  }
}

fn resolveOffset(buffer: &mut Buffer, at: usize, xs: &[i64], ys: &[i64], depth: usize) -> () {
  if depth >= 100 {
    return
  }
  let mut item = List<Glyph>.get(&buffer.glyphs, at)
  if item.attach == 0 {
    return
  }
  let target = usize.toI64(at) + i32.toI64(item.attach)
  item.attach = 0
  List<Glyph>.set(&mut buffer.glyphs, at, item)
  if target < 0 || target >= usize.toI64(Buffer.len(&buffer.*)) {
    return
  }
  let base = i64.toUsize(target)
  resolveOffset(&mut buffer, base, xs, ys, depth + 1)
  let parent = List<Glyph>.get(&buffer.glyphs, base)
  if item.attachType == 2 {
    if Direction.isHorizontal(buffer.direction) {
      item.position.yOffset = add(item.position.yOffset, parent.position.yOffset)
    } else {
      item.position.xOffset = add(item.position.xOffset, parent.position.xOffset)
    }
  } else {
    if Direction.isHorizontal(buffer.direction) {
      item.position.xOffset = add(item.position.xOffset, parent.position.xOffset)
    } else {
      item.position.yOffset = add(item.position.yOffset, parent.position.yOffset)
    }
    if Direction.isForward(buffer.direction) {
      item.position.xOffset = clamp(i32.toI64(item.position.xOffset) + xs[base] - xs[at])
      item.position.yOffset = clamp(i32.toI64(item.position.yOffset) + ys[base] - ys[at])
    } else {
      item.position.xOffset = clamp(i32.toI64(item.position.xOffset) + xs[at + 1] - xs[base + 1])
      item.position.yOffset = clamp(i32.toI64(item.position.yOffset) + ys[at + 1] - ys[base + 1])
    }
  }
  List<Glyph>.set(&mut buffer.glyphs, at, item)
}

fn hasCoverage(table: View, glyph: u32) -> bool {
  return match move View.coverage(&table, glyph) {
    Option<u32>.Some { value } => true
    _ => false
  }
}

// A failed lookup discards its separate output, as upstream Buffer.sync does.
// Save lazily on its first expansion, so ordinary substitutions allocate nothing.
effect fn saveInput(context: &mut Context, buffer: &Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if context.haveSavedInput {
    return
  }
  context.haveSavedInput = true
  run List<Glyph>.reserve(&mut context.savedInput, Buffer.len(buffer))
  let mut i: usize = 0
  while i < Buffer.len(buffer) {
    run List<Glyph>.append(&mut context.savedInput, List<Glyph>.get(&buffer.glyphs, i))
    i = i + 1
  }
}
