import buffer {
  Buffer,
  Glyph,
  GlyphInfo,
  GlyphPosition,
  GlyphInfos,
  GlyphPositions,
  GlyphPositionsMut,
  ContentType,
  ClusterLevel
}
import silk.option { Option }
import normalize
import syllable
import direction { Direction }
import silk.list { List }
import silk.testing { Testing, AssertionError }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut buffer = Buffer.new()
  run Testing.expect(buffer.contentType == ContentType.None, "new buffers have no content type")
  run Buffer.pushStr(&mut buffer, "aé世")
  let infos = Buffer.glyphInfos(&buffer)
  run Testing.expect(
    buffer.contentType == ContentType.Unicode
      && (GlyphInfos.get(&infos, 1)
      |> Option<GlyphInfo>.unwrapOr(GlyphInfo { glyphId: 0, cluster: 0, flags: 0 })).glyphId
      == 233,
    "unshaped glyph views expose Unicode",
  )
  run Testing.expect(
    GlyphPositions.len(&Buffer.glyphPositions(&buffer)) == 0,
    "positions are absent until requested",
  )
  if true {
    let mut positions = Buffer.glyphPositionsMut(&mut buffer)
    run Testing.expect(
      GlyphPositionsMut.len(&positions) == 3
        && (GlyphPositionsMut.get(&positions, 2)
        |> Option<GlyphPosition>.unwrapOr(GlyphPosition.zero())).xAdvance
        == 0,
      "mutable positions initialize on demand",
    )
    let mut first = GlyphPosition.zero()
    first.xAdvance = 123
    drop GlyphPositionsMut.set(&mut positions, 0, first)
  }
  run Testing.expect(
    (Buffer.glyphPosition(&buffer, 0)
      |> Option<GlyphPosition>.unwrapOr(GlyphPosition.zero())).xAdvance
      == 123,
    "projected mutable positions update the buffer",
  )
  run Testing.expect(
    Buffer.len(&buffer) == 3 && List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 3,
    "UTF-8 byte clusters",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "aé世", false)
  run Testing.expect(List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 2, "character clusters")
  Buffer.guessSegmentProperties(&mut buffer)
  run Testing.expect(
    buffer.direction == Direction.LeftToRight && buffer.script == 0x4c61746e,
    "guess segment properties",
  )
  Buffer.mergeClusters(&mut buffer, 1, 3)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 1,
    "monotone cluster merging",
  )
  Buffer.reverse(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).codepoint == 0x4e16,
    "reversal preserves metadata",
  )
  Buffer.clear(&mut buffer)
  buffer.clusterLevel = ClusterLevel.Graphemes
  run Buffer.pushText(&mut buffer, "x\u{030a}X\u{030a}", false)
  normalize.formClusters(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).info.cluster == 0
      && List<Glyph>.get(&buffer.glyphs, 3).info.cluster == 2,
    "nonmonotone grapheme clusters remain intact",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "\u{1f469}\u{200d}\u{1f4bb}x", false)
  buffer.direction = Direction.RightToLeft
  normalize.formClusters(&mut buffer)
  normalize.nativeDirection(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).codepoint == 120
      && List<Glyph>.get(&buffer.glyphs, 1).codepoint == 0x1f469
      && List<Glyph>.get(&buffer.glyphs, 3).codepoint == 0x1f4bb,
    "reverse-direction shaping preserves emoji sequences",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "abc", false)
  Buffer.reverse(&mut buffer)
  Buffer.deleteGlyph(&mut buffer, 1)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).info.cluster == 1,
    "deleting a backward cluster preserves its boundary",
  )
  let mut glyph = Glyph.new(65, 0)
  glyph.glyphClass = 2
  glyph.ligatureId = 1
  glyph.numComponents = 3
  glyph.ligated = true
  run Testing.expect(
    Glyph.ligNumComps(&glyph) == 3 && glyph.component == 0,
    "ligature counts are separate from attached mark components",
  )
  glyph.multiplied = true
  glyph.component = 1
  run Testing.expect(
    Glyph.ligContribution(&glyph) == 0,
    "later pieces of a multiple substitution do not add ligature components",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "ab", false)
  buffer.flags = 128
  Buffer.safeToInsertTatweel(&mut buffer, 0, 2)
  Buffer.propagateFlags(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).info.flags == 5,
    "tatweel-safe boundaries become unsafe to break",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "abc", false)
  buffer.flags = 192
  Buffer.safeToInsertTatweel(&mut buffer, 0, 3)
  Buffer.unsafeToBreak(&mut buffer, 1, 3)
  Buffer.propagateFlags(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).info.flags == 7
      && List<Glyph>.get(&buffer.glyphs, 2).info.flags == 3,
    "later substitutions remove tatweel safety inside unsafe spans",
  )
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 0xd800, 0)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).codepoint == 0xd800,
    "raw codepoints are preserved for custom font mapping",
  )
  Buffer.clear(&mut buffer)
  run Buffer.setPreContext(&mut buffer, "abcdefg")
  run Buffer.setPostContext(&mut buffer, "abcdefg")
  let pre = Buffer.preContextCodepoints(&buffer)
  let post = Buffer.postContextCodepoints(&buffer)
  run Testing.expect(
    pre.length == 5 && pre[0] == 103 && pre[4] == 99 && post.length == 5 && post[0] == 97
      && post[4] == 101,
    "context is bounded to five codepoints, with pre-context reversed",
  )
  run Buffer.pushCodepoints(&mut buffer, &[65, 66])
  run Buffer.pushCodepoints(&mut buffer, &[67])
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 0,
    "codepoint clusters restart on each append",
  )
  drop run Buffer.setLength(&mut buffer, 5)
  run Testing.expect(
    Buffer.len(&buffer) == 5 && List<Glyph>.get(&buffer.glyphs, 4).info.glyphId == 0,
    "growing the buffer zeroes new infos",
  )
  Buffer.resetClusters(&mut buffer)
  Buffer.reverseClusters(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).info.cluster == 4,
    "reverse clusters retains the logical cluster value",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "אב", false)
  Buffer.guessSegmentProperties(&mut buffer)
  run Testing.expect(
    buffer.direction == Direction.RightToLeft && buffer.script == 0x48656272,
    "Hebrew direction",
  )
}

test effect fn bufferOwnershipAndClusters() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
