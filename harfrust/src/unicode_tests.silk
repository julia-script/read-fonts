import normalize
import unicode
import silk.testing { Testing, AssertionError }

test effect fn unicode18ScriptsAndProperties() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    unicode.script(0x41) == 0x4c61746e && unicode.generalCategory(0x41) == 9,
    "Latin capital",
  )
  run Testing.expect(
    unicode.script(0x18e00) == 0x4a757263 && unicode.generalCategory(0x18e00) == 7,
    "Unicode 18 Jurchen",
  )
  run Testing.expect(
    unicode.script(0x125a8) == 0x5063756e && unicode.generalCategory(0x125a8) == 14,
    "Unicode 18 Proto-Cuneiform",
  )
  run Testing.expect(unicode.script(0x3d000) == 0x5365616c, "Unicode 18 Seal")
  run Testing.expect(
    unicode.script(0xffffffff) == 0x5a7a7a7a && unicode.combiningClass(0xffffffff) == 0,
    "out of range codepoint",
  )
  run Testing.expect(
    unicode.modifiedCombiningClass(0xc55) == 4 && unicode.modifiedCombiningClass(0xc56) == 5
      && unicode.modifiedCombiningClass(0xc4d) == 9,
    "Telugu length marks reorder before virama",
  )
  run Testing.expect(
    unicode.combiningClass(0xc55) == 84 && unicode.combiningClass(0xc56) == 91,
    "canonical classes are retained separately",
  )
}

test effect fn canonicalPairsAndHangul() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    unicode.composeRaw(0x41, 0x301) == 0xc1 && unicode.composeRaw(0x41, 0x41) == 0,
    "canonical composition",
  )
  let decomposition = unicode.decomposeRaw(0xc1)
  run Testing.expect(
    decomposition.first == 0x41 && decomposition.second == 0x301,
    "canonical decomposition",
  )
  run Testing.expect(
    unicode.composeRaw(0x1100, 0x1161) == 0xac00 && unicode.composeRaw(0xac00, 0x11a8) == 0xac01,
    "Hangul composition",
  )
  let hangul = unicode.decomposeRaw(0xac01)
  run Testing.expect(hangul.first == 0xac00 && hangul.second == 0x11a8, "Hangul decomposition")
  run Testing.expect(
    unicode.mirror(40) == 41 && unicode.mirror(41) == 40 && unicode.mirror(65) == 65,
    "bidi mirroring",
  )

  // `shape.mirror` skips the lookup for these ranges.
  let mut cp: u32 = 0
  while cp < 0xf3a {
    run Testing.expect(
      (cp >= 0x28 && cp < 0xbc) || unicode.mirror(cp) == cp,
      "no mirror below U+0028 or in U+00BC..U+0F39",
    )
    cp = cp + 1
  }
}

test effect fn hebrewFallbackPresentationForms() -> ()
  ! AssertionError<'static> {
  run Testing.expect(normalize.hebrewCompose(0x5d1, 0x5bc) == 0xfb31, "bet dagesh")
  run Testing.expect(
    normalize.hebrewCompose(0x5d7, 0x5bc) == 0,
    "het has no dagesh presentation form",
  )
  run Testing.expect(
    normalize.hebrewCompose(0xfb49, 0x5c1) == 0xfb2c
      && normalize.hebrewCompose(0xfb2a, 0x5bc) == 0xfb2c,
    "shin dot and dagesh compose in either order",
  )
  run Testing.expect(
    normalize.hebrewCompose(0x5d9, 0x5b4) == 0xfb1d
      && normalize.hebrewCompose(0x5db, 0x5bf) == 0xfb4d,
    "hiriq and rafe presentation forms",
  )
}

import silk.option { Option }
import unicode { Decomposed }

test effect fn publicUnicodeQueries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    (unicode.compose(0x41, 0x30a) |> Option<u32>.unwrapOr(0)) == 0xc5,
    "public composition query",
  )
  run Testing.expect(
    match move unicode.decompose(0xc5) {
      Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => first == 0x41
        && second == 0x30a
      _ => false
    },
    "pair decomposition",
  )
  run Testing.expect(
    match move unicode.decompose(0x212b) {
      Option<Decomposed>.Some { value: Decomposed.Singleton { codepoint } } => codepoint == 0xc5
      _ => false
    },
    "singleton decomposition",
  )
  run Testing.expect(
    (unicode.compose(0xac00, 0x11a7) |> Option<u32>.unwrapOr(0)) == 0,
    "Hangul's trailing-Jamo base is excluded",
  )
}
