//! HarfBuzz's three-mask Bloom filter for rejecting lookup coverage misses.
import silk.ownership { Copy }
import silk.u32
import silk.u64
import silk.u16
import view { View }

pub struct SetDigest {
  masks: [u64; 3],
}

impl Copy for SetDigest {}

impl SetDigest {
  pub fn new() -> Self {
    return Self { masks: [0; 3] }
  }

  pub fn full() -> Self {
    return Self { masks: [18446744073709551615; 3] }
  }

  pub fn clear(self: &mut Self) -> () {
    self.masks = [0; 3]
  }

  pub fn include(self: &mut Self, other: &Self) -> () {
    let mut i: usize = 0
    while i < 3 {
      self.masks[i] = self.masks[i] | other.masks[i]
      i = i + 1
    }
  }

  pub fn add(self: &mut Self, glyph: u32) -> () {
    self.masks[0] = self.masks[0] | bit(glyph, 4)
    self.masks[1] = self.masks[1] | bit(glyph, 0)
    self.masks[2] = self.masks[2] | bit(glyph, 6)
  }

  pub fn mayHave(self: &Self, glyph: u32) -> bool with Intrinsic.inlineAlways() {
    return (self.masks[0] & bit(glyph, 4)) != 0 && (self.masks[1] & bit(glyph, 0)) != 0
      && (self.masks[2] & bit(glyph, 6)) != 0
  }

  pub fn mayIntersect(self: &Self, other: &Self) -> bool {
    return (self.masks[0] & other.masks[0]) != 0 && (self.masks[1] & other.masks[1]) != 0
      && (self.masks[2] & other.masks[2]) != 0
  }

  pub fn addRange(self: &mut Self, first: u32, last: u32) -> () {
    let shifts: [u32; 3] = [4, 0, 6]
    let mut i: usize = 0
    while i < 3 {
      let a = u32.shiftRight(first, shifts[i])
      let b = u32.shiftRight(last, shifts[i])
      if b < a || b - a >= 63 {
        self.masks[i] = 18446744073709551615
      } else {
        let ma = bit(first, shifts[i])
        let mb = bit(last, shifts[i])
        let mut mask = u64.wrappingAdd(mb, u64.wrappingSubtract(mb, ma))
        if mb < ma {
          mask = u64.wrappingSubtract(mask, 1)
        }
        self.masks[i] = self.masks[i] | mask
      }
      i = i + 1
    }
  }

  pub fn addCoverage(self: &mut Self, table: View) -> () {
    let format = View.u16(&table, 0)
    if format < 1 || format > 4 {
      return
    }
    let mut width: usize = 2
    if format >= 3 {
      width = 3
    }
    let header = 2 + width
    let count = u32.toUsize(View.uint(&table, 2, width))
    let mut stride = width
    if format == 2 || format == 4 {
      stride = width * 3
    }
    if header > View.len(&table) || count > (View.len(&table) - header) / stride {
      return
    }
    let mut i: usize = 0
    while i < count {
      let at = header + i * stride
      let first = View.uint(&table, at, width)
      if stride == width {
        SetDigest.add(&mut self, first)
      } else {
        SetDigest.addRange(&mut self, first, View.uint(&table, at + width, width))
      }
      if self.masks[0] == 18446744073709551615 && self.masks[1] == 18446744073709551615
        && self.masks[2] == 18446744073709551615 {
        break
      }
      i = i + 1
    }
  }
}

fn bit(glyph: u32, shift: u32) -> u64 with Intrinsic.inlineAlways() {
  return u64.shiftLeft(1, u32.toU64(u32.shiftRight(glyph, shift) & 63))
}

pub fn lookupDigest(layout: View, index: u16, positioning: bool) -> SetDigest {
  let list = View.layoutList(&layout, 2)
  let mut width: usize = 2
  if View.u16(&layout, 0) == 1 && View.u16(&layout, 2) >= 2 && View.u32(&layout, 22) != 0 {
    width = 4
  }
  if index >= View.u16(&list, 0) {
    return SetDigest.new()
  }
  let lookup = View.offset(&list, 2 + u16.toUsize(index) * width, width)
  let lookupKind = View.u16(&lookup, 0)
  let count = u16.toUsize(View.u16(&lookup, 4))
  let mut digest = SetDigest.new()
  let mut i: usize = 0
  while i < count {
    let mut table = View.offset16(&lookup, 6 + i * 2)
    let mut kind = lookupKind
    if (!positioning && kind == 7) || (positioning && kind == 9) {
      if View.u16(&table, 0) != 1 {
        i = i + 1
        continue
      }
      kind = View.u16(&table, 2)
      table = View.offset32(&table, 4)
    }
    let format = View.u16(&table, 0)
    let contextual = (!positioning && (kind == 5 || kind == 6))
      || (positioning && (kind == 7 || kind == 8))
    let chained = (!positioning && kind == 6) || (positioning && kind == 8)
    let mut coverageAt: usize = 2
    let mut coverageWidth: usize = 2
    if contextual {
      if format == 3 || format == 6 {
        coverageAt = 6
        if format == 6 {
          coverageWidth = 3
        }
        if chained {
          coverageAt = 6 + u16.toUsize(View.u16(&table, 2)) * coverageWidth
        }
      } else if format >= 4 {
        coverageWidth = 4
      }
    } else if positioning {
      if (kind <= 2 && format >= 3) || (kind >= 3 && format >= 2) {
        coverageWidth = 4
      }
    } else if (kind == 1 && format >= 3) || (kind >= 2 && format >= 2) {
      coverageWidth = 4
    }
    SetDigest.addCoverage(&mut digest, View.offset(&table, coverageAt, coverageWidth))
    i = i + 1
  }
  return digest
}
